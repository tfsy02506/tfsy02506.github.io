            : TF.ui.button({ text: '放出来', variant: 'ghost', size: 'sm', action: 'admin.one', param: { type: 'comment', id: c.id, op: 'publish', msg: '放出来了' } })) +
          TF.ui.button({ icon: 'trash', variant: 'danger', size: 'sm', title: '删掉', attrs: { 'aria-label': '删除评论' }, action: 'admin.comment.delete', param: { id: c.id } }) +
