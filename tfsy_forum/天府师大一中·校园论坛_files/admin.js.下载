  /* 取一个用户（后台用）。
     顺序：内存快照 → 服务端（adminGet('user') 会去打 /api/admin/item）→ 用动作参数里带的昵称兜底。
     以前直接 TF.store.getUser(id)，而快照里只有一部分用户，
     后台列表却是全量数据 → 点"设超管/设版主"会误报"查无此人"。 */
  function findUserForAction(ctx) {
    var id = (ctx.param || {}).id;
    var u = TF.store.getUser(id);
    if (u) return u;
    var got = TF.store.adminGet ? TF.store.adminGet('user', id) : null;
    if (got && (got.id || got.nickname)) return got;
    /* 最后兜底：把"是谁"用按钮上带过来的昵称显示出来，动作本身交给服务端 */
    var nick = String((ctx.param || {}).nick || '');
    if (nick) return { id: String(id), nickname: nick, username: nick };
    return { id: String(id), nickname: 'ID ' + id, username: '' };
  }

