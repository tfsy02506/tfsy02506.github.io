  /* 站点设置 */
  function addWord(input) {
    var box = document.querySelector('[data-words]');
    var w = (input && input.value ? input.value : '').trim();
    if (!w) { TF.ui.toast('先打一个词', 'warn'); return; }
    if (w.length > 16) { TF.ui.toast('一个词最多 16 个字', 'error'); return; }
    tmp.words = tmp.words || [];
    if (tmp.words.indexOf(w) >= 0) { TF.ui.toast('词库里已经有这个词了', 'warn'); return; }
    if (tmp.words.length >= 60) { TF.ui.toast('最多 60 个词', 'error'); return; }
    tmp.words.push(w);
    if (input) input.value = '';
    if (box) box.innerHTML = wordsHTML();
    TF.ui.toast('加上了，记得点保存', 'success');
  }
  TF.app.on('admin.settings.word.add', function (ctx) {
    addWord((ctx.form || document).querySelector('[data-words-input]'));
  });
  TF.app.on('admin.settings.word.del', function (ctx) {
    var w = ctx.param.w;
    tmp.words = (tmp.words || []).filter(function (x) { return x !== w; });
