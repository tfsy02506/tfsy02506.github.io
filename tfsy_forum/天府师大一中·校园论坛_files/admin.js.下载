      filterbar('boards', filtersFor('boards', { keyword: kw })) +
      table([{ t: 'ID' }, { t: '版块' }, { t: '分组' }, { t: '简介' }, { t: '帖子' }, { t: '今日' }, { t: '排序' }, { t: '状态' }, { t: '操作' }], rows, '没有匹配的版块') +
      '<p class="text-xs text-muted mt-2">上移下移改前台顺序；版块里还有帖子的话删不掉，得先搬走或删掉那些帖子。</p>';
  }

  /* ------------------------------------------------------ 6 举报处理 */
  function renderReports(ctx) {
    var raw = Q(ctx, 'status', 'pending');
    var st = raw === 'all' ? '' : raw;
    var f = { status: raw, page: QN(ctx, 'page', 1) };
    var res = TF.store.adminList({ type: 'report', status: st, page: f.page, size: 15 });
    var a = TF.store.adminStats();
    var counts = {
      pending: a.reports.pending,
      resolved: TF.store.adminList({ type: 'report', status: 'resolved', size: 1 }).total,
      rejected: TF.store.adminList({ type: 'report', status: 'rejected', size: 1 }).total,
      all: a.reports.total
    };
    var tabs = TF.ui.tabs({ active: raw, items: [
      { key: 'pending', label: '待处理', count: counts.pending, href: href('reports', { status: 'pending' }) },
      { key: 'resolved', label: '已处理', count: counts.resolved, href: href('reports', { status: 'resolved' }) },
      { key: 'rejected', label: '已驳回', count: counts.rejected, href: href('reports', { status: 'rejected' }) },
      { key: 'all', label: '全部', count: counts.all, href: href('reports', { status: 'all' }) }
    ] });
    if (isPhone()) {
      return head('reports') + '<div class="mb-3">' + tabs + '</div>' + reportsCards(res, raw) +
        (raw === 'pending' ? bulkbar('report', BULK_OPS.report) : '') + pager('reports', f, res);
    }
    var rows = (res.list || []).map(function (r) {
      var reporter = TF.store.getUser(r.reporterId);
      var summary = '', link = '';
      if (r.targetType === 'post') {
        var p = TF.store.adminGet('post', r.targetId);
        summary = p ? EXC(p.title, 24) : '帖子已删除';
        link = '#/post/' + r.targetId;
      } else if (r.targetType === 'comment') {
        var c = TF.store.adminGet('comment', r.targetId);
        summary = c ? EXC(c.content, 24) : '评论已删除';
        link = c ? '#/post/' + c.postId : '';
      } else {
        var u = TF.store.adminGet('user', r.targetId);
        summary = u ? (u.nickname || u.username) : '用户已注销';
        link = '#/u/' + r.targetId;
      }
      var tl = { post: ['帖子', 'primary'], comment: ['评论', 'info'], user: ['用户', 'warn'] }[r.targetType] || ['其他', 'default'];
      return [
        checkTd(r.id, 'report'),
        td(TF.ui.badge(tl[0], tl[1]) + ' ' + (link ? '<a href="' + AT(link) + '">' + E(summary) + '</a>' : '<span class="text-muted">' + E(summary) + '</span>')),
        td(userLink(reporter)),
        td('<b>' + E(EXC(r.reason, 18)) + '</b>' + (r.detail ? ' <span class="text-xs text-muted">' + E(EXC(r.detail, 20)) + '</span>' : '')),
        td('<span class="text-xs text-muted">' + E(REL(r.createdAt)) + '</span>'),
        td(stBadge(REPORT_STATUS, r.status) + (r.handleNote ? ' <span class="text-xs text-muted">' + E(EXC(r.handleNote, 10)) + '</span>' : '')),
        td('<div class="table__actions">' +
          (r.status === 'pending'
            ? TF.ui.button({ text: '标记已处理', variant: 'ghost', size: 'sm', action: 'admin.report.handle', param: { id: r.id, status: 'resolved' } }) +
              TF.ui.button({ text: '驳回', variant: 'ghost', size: 'sm', action: 'admin.report.handle', param: { id: r.id, status: 'rejected' } })
            : '<span class="text-xs text-muted">' + E(r.handledAt ? FMT(r.handledAt) : '处理过了') + '</span>') +
          '</div>')
      ];
    });
    return head('reports') + '<div class="mb-3">' + tabs + '</div>' +
      table([checkHead(), { t: '被举报的' }, { t: '举报人' }, { t: '理由' }, { t: '时间' }, { t: '状态' }, { t: '操作' }], rows,
        raw === 'pending' ? '没有待处理的举报' : '这里还空着', true) +
      (raw === 'pending' ? bulkbar('report', BULK_OPS.report) : '') +
      pager('reports', f, res);
  }

