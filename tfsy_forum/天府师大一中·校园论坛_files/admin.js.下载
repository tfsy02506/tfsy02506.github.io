  /* -------------------------------------------- 学生认证审核（校卡照片）
   * 只有超管能进（SUPER_ONLY.verify=1）；照片走 /api/admin/student/card/:id，仅管理员可看。
   * 列表是异步拉的：页面先画骨架，mountVerifyPage() 再填内容。 */
  var VERIFY_TABS = [['pending', '待审核'], ['student', '已通过'], ['rejected', '已驳回']];
  var VERIFY_STATUS = {
    pending: ['审核中', 'warn'], student: ['已通过', 'success'],
    rejected: ['已驳回', 'danger'], external: ['校外未提交', 'default']
  };
  function verifyTabsHTML(active) {
    return '<div class="tabs mt-3">' + VERIFY_TABS.map(function (t) {
      return '<a class="tab' + (active === t[0] ? ' is-active' : '') + '" href="' + href('verify', { status: t[0] }) + '">' + t[1] + '</a>';
    }).join('') + '</div>';
  }
  function verifyRejectModal() {
    return TF.ui.modal({
      id: 'admin-verify-reject', title: '驳回学生认证',
      body: '<form data-action="admin.verify.reject.submit">' +
        '<input type="hidden" name="id" value="">' +
        '<p class="text-sm text-2" data-reject-who></p>' +
        TF.ui.textarea({ label: '驳回原因（会发给同学，写清楚一点）', name: 'reason', rows: 3, maxlength: 200, placeholder: '比如：照片太糊，看不清姓名和班级；或者校卡信息不完整' }) +
        '<div class="cluster gap-2 mt-4"><button type="submit" class="btn btn--danger">驳回</button>' +
        '<button type="button" class="btn" data-modal-close>取消</button></div></form>'
    });
  }
  function renderVerify(ctx) {
    var status = Q(ctx, 'status', 'pending');
    if (!VERIFY_STATUS[status] || status === 'external') status = 'pending';
    return head('verify', '<span class="text-xs text-muted">校卡照片只有管理员能看，不要转发</span>') +
      '<div class="card card--pad">' +
        '<h2 class="card__title">学生认证审核</h2>' +
        '<p class="text-sm text-2">同学上传校卡照片后在这里审核：点「通过」解锁看帖/发帖/评论；点「驳回」要写原因，同学会收到通知并可以重新提交。</p>' +
        verifyTabsHTML(status) +
        '<div data-verify-box class="mt-3"><p class="text-sm text-muted">加载中…</p></div>' +
      '</div>' + verifyRejectModal();
  }
  function verifyRowHTML(u, status) {
    var cardUrl = TF.api && TF.api.adminStudent ? TF.api.adminStudent.cardUrl(u.id) : '';
    var photo = u.hasCard && cardUrl
      ? '<a class="vcard" href="' + AT(cardUrl) + '" target="_blank" rel="noopener" title="点开看大图">' +
        '<img class="vcard__img" src="' + AT(cardUrl) + '" alt="校卡照片" loading="lazy"></a>'
      : '<div class="vcard vcard--none"><span class="text-xs text-muted">没有照片</span></div>';
    var acts = '';
    if (status === 'pending') {
      acts = '<div class="cluster gap-2">' +
        TF.ui.button({ text: '通过', variant: 'primary', size: 'sm', action: 'admin.verify.approve', param: { id: u.id, nickname: u.nickname } }) +
        TF.ui.button({ text: '驳回', variant: 'outline', size: 'sm', action: 'admin.verify.reject', param: { id: u.id, nickname: u.nickname } }) +
        '</div>';
    } else {
      var st = VERIFY_STATUS[status] || ['—', 'default'];
      acts = TF.ui.badge(st[0], st[1]);
    }
    var meta = [];
    if (u.realName) meta.push('姓名：' + E(u.realName));
    if (u.klass) meta.push('班级：' + E(u.klass));
    if (u.studentNo) meta.push('学号：' + E(u.studentNo));
    meta.push('提交：' + (u.submittedAt ? FMT(u.submittedAt) : '—'));
    return '<div class="vrow">' + photo +
      '<div class="vrow__main">' +
        '<div><b>' + E(u.nickname) + '</b> <span class="text-xs text-muted">@' + E(u.username) + ' · ID ' + E(u.id) + '</span></div>' +
        '<div class="text-xs text-2 mt-1">' + meta.join(' · ') + '</div>' +
        (u.note ? '<div class="text-xs text-danger mt-1">驳回原因：' + E(u.note) + '</div>' : '') +
      '</div>' +
      '<div class="vrow__acts">' + acts + '</div></div>';
  }
  function mountVerifyPage() {
    var box = document.querySelector('[data-verify-box]');
    if (!box) return;
    var status = (TF.route && TF.route.query && TF.route.query.status) || 'pending';
    if (['pending', 'student', 'rejected'].indexOf(status) < 0) status = 'pending';
    if (!TF.api || !TF.api.adminStudent) { box.innerHTML = '<p class="text-sm text-danger">接口没准备好，刷新一下</p>'; return; }
    TF.api.adminStudent.list(status).then(function (d) {
      var list = (d && d.list) || [];
      var counts = (d && d.counts) || {};
      var summary = '<p class="text-xs text-muted">待审核 <b>' + NUM(counts.pending || 0) + '</b> · 已通过 ' +
        NUM(counts.student || 0) + ' · 已驳回 ' + NUM(counts.rejected || 0) + '</p>';
      if (!list.length) {
        box.innerHTML = summary + '<div class="empty--plain">这一栏还没有记录</div>';
        return;
      }
      box.innerHTML = summary + '<div class="vlist">' + list.map(function (u) { return verifyRowHTML(u, status); }).join('') + '</div>';
    }, function (e) {
      box.innerHTML = '<p class="text-sm text-danger">加载失败：' + E((e && e.message) || '网络错误') + '</p>';
    });
  }
  /* 通过 / 驳回（通过前再确认一次，驳回要填原因） */
  TF.app.on('admin.verify.approve', function (ctx) {
    var p = ctx.param || {};
    TF.ui.confirm({ title: '通过这位同学的学生认证？', body: '昵称：' + (p.nickname || '') + '。通过后对方就能看帖、发帖、评论。', okText: '通过' })
      .then(function (ok) {
        if (!ok) return;
        TF.api.adminStudent.verify(p.id, true, '').then(function () {
          TF.ui.toast('已通过', 'success');
          TF.app.refresh();
        }, function (e) { TF.ui.toast((e && e.message) || '操作失败', 'error'); });
      });
  });
  TF.app.on('admin.verify.reject', function (ctx) {
    var p = ctx.param || {};
    var form = document.querySelector('#admin-verify-reject form');
    if (form) {
      var idInput = form.querySelector('input[name="id"]');
      if (idInput) idInput.value = String(p.id || '');
      var who = form.querySelector('[data-reject-who]');
      if (who) who.textContent = '驳回「' + (p.nickname || '') + '」的认证，同学会收到通知。';
    }
    TF.ui.modal.open('admin-verify-reject');
  });
  TF.app.on('admin.verify.reject.submit', function (ctx) {
    var v = ctx.values() || {};
    var reason = String(v.reason || '').trim();
    if (reason.length < 2) { TF.ui.toast('写一下驳回原因，同学才知道怎么改', 'warn'); return; }
