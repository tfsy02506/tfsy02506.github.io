  /* ------------------------------------------------------ 4 用户管理 */
  function renderUsers(ctx) {
    var f = { keyword: Q(ctx, 'keyword', ''), role: Q(ctx, 'role', ''), status: Q(ctx, 'status', ''), sort: Q(ctx, 'sort', 'points'), page: QN(ctx, 'page', 1) };
    var res = TF.store.adminList({ type: 'user', keyword: f.keyword, role: f.role, status: f.status, sort: f.sort, page: f.page, size: 15 });
    if (isPhone()) {
      return head('users', '<span class="text-xs text-muted">共 ' + NUM(TF.store.adminStats().users.total) + ' 人</span>') +
        filterbar('users', filtersFor('users', f)) + usersCards(res) + bulkbar('user', BULK_OPS.user) + pager('users', f, res);
    }
    var me = TF.store.currentUser() || {};
    var rows = (res.list || []).map(function (u) {
      var acts = [];
      var who = { id: u.id, nick: u.nickname || u.username || '' };
      var withRole = function (role) { return { id: u.id, nick: who.nick, role: role }; };
      if (u.banned) acts.push(TF.ui.button({ text: '解封', variant: 'ghost', size: 'sm', action: 'admin.one', param: { type: 'user', id: u.id, op: 'unban', msg: '解封了' } }));
      else acts.push(TF.ui.button({ text: '封禁', variant: 'ghost', size: 'sm', action: 'admin.user.ban.open', param: who }));
      if (u.role === 'student') acts.push(TF.ui.button({ text: '设版主', variant: 'ghost', size: 'sm', action: 'admin.user.role', param: withRole('mod') }));
      if (u.role === 'mod') acts.push(TF.ui.button({ text: '取消版主', variant: 'ghost', size: 'sm', action: 'admin.user.role', param: withRole('student') }));
      if (u.role !== 'admin') acts.push(TF.ui.button({ text: '设超管', variant: 'ghost', size: 'sm', action: 'admin.user.role', param: withRole('admin') }));
      if (u.role === 'admin' && u.id !== me.id) acts.push(TF.ui.button({ text: '降为学生', variant: 'ghost', size: 'sm', action: 'admin.user.role', param: withRole('student') }));
      /* 版主：指定他负责哪些版块（超管专属操作） */
      if (u.role === 'mod' && me.role === 'admin') acts.push(TF.ui.button({ text: '负责版块', variant: 'ghost', size: 'sm', action: 'admin.user.boards', param: { id: u.id, nick: u.nickname || u.username || '' } }));
      acts.push(TF.ui.button({ icon: 'key', variant: 'ghost', size: 'sm', title: '重置密码', attrs: { 'aria-label': '重置密码' }, action: 'admin.user.pwd', param: who }));
      acts.push(TF.ui.button({ icon: 'trash', variant: 'danger', size: 'sm', title: '删号', attrs: { 'aria-label': '删除用户' }, action: 'admin.user.delete', param: { id: u.id } }));
      return [
        checkTd(u.id, 'user'),
        td('<div class="authorline">' + TF.ui.avatar(u, 26) +
          '<div><a href="#/u/' + AT(u.id) + '"><b>' + E(u.nickname || u.username) + '</b></a>' +
          '<div class="text-xs text-muted">@' + E(u.username) + (u.id === me.id ? ' · 我' : '') + '</div></div></div>'),
        /* 真实姓名 / 班级 / 学号：只有超管能看到（服务端只给超管和本人，其他人拿到的是空串） */
        td(privateCell(u, 'name')),
        td(privateCell(u, 'klass')),
        td(roleBadge(u.role)),
        td(u.grade || u.klass ? E(u.grade || '') : '<span class="text-muted">—</span>'),
        td(u.banned ? TF.ui.badge('已封禁', 'danger') + (u.banReason ? ' <span class="text-xs text-muted">' + E(EXC(u.banReason, 12)) + '</span>' : '') : TF.ui.badge('正常', 'success')),
        td('<span class="mono">' + NUM(u.points) + '</span>', 'num'),
        td('<span class="mono">' + NUM(u.stats && u.stats.posts) + '</span>', 'num'),
        td('<span class="text-xs text-muted">' + E(u.lastLoginAt ? REL(u.lastLoginAt) : '没登过') + '</span>'),
        td('<div class="table__actions">' + acts.join('') + '</div>')
      ];
    });
    return head('users', '<span class="text-xs text-muted">共 ' + NUM(TF.store.adminStats().users.total) + ' 人</span>') +
      filterbar('users', filtersFor('users', f)) +
      table([checkHead(), { t: '成员' }, { t: '真实姓名' }, { t: '班级' }, { t: '角色' }, { t: '年级' }, { t: '状态' }, { t: '积分' }, { t: '发帖' }, { t: '最后登录' }, { t: '操作' }], rows, '没有这个人', true) +
      bulkbar('user', BULK_OPS.user) +
      pager('users', f, res);
  }

  /* ------------------------------------------------------ 5 版块管理 */
