  function renderAdmin(ctx) {
    var params = ctx.params || (TF.route && TF.route.param) || {};
    var asked = params.section || '';
    var section = asked === '' ? 'dashboard' : (RENDER[asked] ? asked : '');
    if (tmp.modal && tmp.modal.section !== section) tmp.modal = null;
    if (section !== 'settings') tmp.words = null;
    if (!section) {
      var links = Object.keys(SEC).filter(function (k) { return SEC_ALLOWED(k); }).map(function (k) {
