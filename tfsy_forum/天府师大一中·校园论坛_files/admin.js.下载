          TF.ui.button({ icon: 'arrowLeft', variant: 'ghost', size: 'sm', title: '上移', attrs: { 'aria-label': '上移' }, action: 'admin.board.move', param: { id: b.id, dir: -1 } }) +
          TF.ui.button({ icon: 'arrowRight', variant: 'ghost', size: 'sm', title: '下移', attrs: { 'aria-label': '下移' }, action: 'admin.board.move', param: { id: b.id, dir: 1 } }) +
          TF.ui.button({ text: b.locked ? '解锁' : '锁定', variant: 'ghost', size: 'sm', action: 'admin.board.lock', param: { id: b.id } }) +
