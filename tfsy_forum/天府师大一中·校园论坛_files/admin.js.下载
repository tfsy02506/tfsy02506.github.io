    var res = TF.store.saveSettings({
      siteName: siteName, slogan: (v.slogan || '').trim(), icp: (v.icp || '').trim(), footerText: (v.footerText || '').trim(),
      contact: (v.contact || '').trim(), announcement: (v.announcement || '').trim(),
      registerOpen: !!v.registerOpen, needAudit: !!v.needAudit, allowGuest: !!v.allowGuest,
      postInterval: interval, themeDefault: v.themeDefault, sensitiveWords: tmp.words || []
    });
    if (!res || !res.ok) { TF.ui.toast((res && res.error) || '没存上', 'error'); return; }
    tmp.words = null;
    TF.ui.toast('存好了', 'success');
    TF.app.refresh();
  });
  TF.app.on('admin.settings.reset', function () {
    confirmBox({
      title: '清空论坛数据？',
      body: '帖子、评论、点歌、公告、登录记录会全部清空，账号和版块保留。这个操作在服务器上执行，找不回来。',
      okText: '确认清空', danger: true
    }).then(function (ok) {
      if (!ok) return;
      var r = TF.store.reset();
      if (r && r.ok === false) { TF.ui.toast(r.error || '清空失败', 'error', 3600); return; }
      TF.ui.toast('已清空论坛数据（账号还在）', 'success', 3600);
      setTimeout(function () { TF.app.refresh(); }, 400);
    });
  });

  /* 我的账号 */
  TF.app.on('admin.profile.save', function (ctx) {
    var v = ctx.values();
    var nickname = (v.nickname || '').trim();
    if (nickname.length < 2 || nickname.length > 16) { TF.ui.toast('昵称 2~16 个字', 'error'); return; }
    var res = TF.store.updateProfile({
      nickname: nickname, bio: (v.bio || '').trim(), grade: v.grade, klass: (v.klass || '').trim(), sex: v.sex, email: (v.email || '').trim()
    });
    finish(res, '存好了');
  });
  TF.app.on('admin.profile.pwd', function (ctx) {
    var v = ctx.values();
    if ((v.newPwd || '').length < 6) { TF.ui.toast('新密码至少 6 位', 'error'); return; }
    if (v.newPwd !== v.newPwd2) { TF.ui.toast('两遍新密码不一样', 'error'); return; }
    var res = TF.store.changePassword(v.oldPwd, v.newPwd, v.newPwd2);
    if (!res.ok) { TF.ui.toast(res.error || '没改成', 'error'); return; }
    TF.ui.toast('密码改了，下次用新的登', 'success');
    if (ctx.form) ctx.form.reset();
  });

  /* --------------------------------------------------------- 路由注册（先 :section 再 /admin） */
  TF.app.register('/admin/:section', renderAdmin);
  TF.app.register('/admin', renderAdmin);
})();
