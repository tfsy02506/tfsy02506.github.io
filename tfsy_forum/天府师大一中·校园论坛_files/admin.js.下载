/* 天府师大一中·校园论坛 — 管理后台（admin.js）
 * 后台 12 个分区：数据总览 / 帖子 / 评论 / 用户 / 版块 / 举报 / 公告 / 消息 / 站点设置 / 操作日志 / 学生认证 / 我的账号
 * 权限（R5）：版主（mod）管内容（总览、帖子、评论、举报、公告、我的账号）；超级管理员（admin）另有用户、版块、推送、设置、日志。
 * 外壳（.sidebar + .admin-top）由 app.js 渲染，本文件只画内容区：紧凑标题行 + 筛选条 + 密集表格 + 弹窗。
 * 交互走 data-action + TF.app.on；筛选与分页通过 hash query 真实传给 TF.store（真分页、真筛选）。
 */
(function () {
  'use strict';

  var TF = (window.TF = window.TF || {});
  TF.extend = TF.extend || function (n, o) { TF[n] = Object.assign(TF[n] || {}, o); return TF[n]; };

  /* ---------------------------------------------------------------- 工具 */
  function E(v) { return TF.util.esc(v); }
  function AT(v) { return TF.util.attr(v); }
  function NUM(v, d) { return TF.util.num(v || 0, d); }
  function REL(ts) { return TF.util.relTime(ts); }
  function FMT(ts) { return TF.util.fmtTime(ts); }
  function EXC(s, n) { return TF.util.excerpt(s, n); }
  function IC(n, s) { return TF.ui.icon(n, s); }
  function P(o) { return AT(JSON.stringify(o || {})); }
  function ACT(a, o) { return ' data-action="' + AT(a) + '" data-param="' + P(o) + '"'; }

  /* ------------------------------------------------------------- 权限 */
  function canManage() { return !!(TF.store.canManage && TF.store.canManage()); }
  function isSuper() { return !!(TF.store.isAdmin && TF.store.isAdmin()); }
  var SUPER_ONLY = { users: 0, boards: 0, messages: 0, settings: 0, logs: 0, verify: 0 };
  function SEC_ALLOWED(sec) {
    var s = sec || ((TF.route && TF.route.param && TF.route.param.section) || 'dashboard');
    return !SUPER_ONLY[String(s).toLowerCase()] || isSuper();
  }
  function deny(msg) {
    return '<div class="page" data-page="admin"><div class="card card--pad mt-4">' +
      TF.ui.empty({
        icon: 'lock', title: '进不去这个页面',
        desc: msg || '版主能管帖子、评论、举报；用户、版块、推送、设置只有超管能动。',
        action: { text: '回数据总览', variant: 'primary', href: '#/admin/dashboard' }
      }) + '</div></div>';
  }

  /* 弹窗/敏感词编辑的临时状态 */
  var tmp = { modal: null, words: null };

  /* ------------------------------------------------------------ 元数据 */
  var SEC = {
    dashboard: { label: '数据总览', title: '数据总览', acts: '人数、帖子、举报、近 14 天走势' },
    posts: { label: '帖子管理', title: '帖子管理', acts: '置顶、加精、下架、发布、删掉' },
    comments: { label: '评论管理', title: '评论管理', acts: '隐藏、放出来、删掉；点标题跳原帖' },
    users: { label: '用户管理', title: '用户管理', acts: '封禁、解封、改角色、重置密码、删号' },
    boards: { label: '版块管理', title: '版块管理', acts: '新建、改简介图标、上下移、锁定、删除' },
    reports: { label: '举报处理', title: '举报处理', acts: '看被举报内容，标已处理或驳回' },
    notices: { label: '公告管理', title: '公告管理', acts: '发公告、改级别、置顶、删掉' },
    messages: { label: '消息推送', title: '消息推送', acts: '发给全体 / 某个角色 / 某个人；发出后撤不回' },
    settings: { label: '站点设置', title: '站点设置', acts: '站名、注册开关、发帖规则、敏感词' },
    logs: { label: '操作日志', title: '操作日志', acts: '谁在什么时候改了什么' },
    /* 学生认证审核：看校卡照片，通过或驳回（只有超管能进，照片是隐私） */
    verify: { label: '学生认证', title: '学生认证审核', acts: '看校卡照片，通过或驳回；通过后解锁论坛' },
    profile: { label: '我的账号', title: '我的账号', acts: '改昵称签名、改登录密码' }
  };
  var POST_STATUS = { published: ['已发布', 'success'], pending: ['待审核', 'warn'], hidden: ['已下架', 'danger'], deleted: ['已删除', 'default'] };
  var COMMENT_STATUS = { published: ['已发布', 'success'], hidden: ['已隐藏', 'warn'], deleted: ['已删除', 'default'] };
  var REPORT_STATUS = { pending: ['待处理', 'warn'], resolved: ['已处理', 'success'], rejected: ['已驳回', 'default'] };
  var ROLE = { student: ['学生', 'default'], mod: ['版主', 'mod'], admin: ['超管', 'danger'] };
  var LEVEL = { info: ['普通', 'info'], warn: ['提醒', 'warn'], important: ['重要', 'danger'] };
  var BOARD_ICONS = ['forum', 'book', 'sport', 'megaphone', 'tag', 'question', 'users', 'fire', 'star', 'list', 'heart', 'calendar'];
  var GRADE_OPTIONS = [{ value: '', label: '未设置' }].concat(['初一', '初二', '初三', '高一', '高二', '高三'].map(function (g) { return { value: g, label: g }; }));
  var LOG_ACTIONS = [
    { value: '', label: '全部动作' }, { value: 'auth.', label: '登录' }, { value: 'post.', label: '帖子' },
    { value: 'comment.', label: '评论' }, { value: 'user.', label: '用户' }, { value: 'report.', label: '举报' },
    { value: 'notice.', label: '公告' }, { value: 'board.', label: '版块' }, { value: 'message.', label: '消息' }, { value: 'settings.', label: '设置' },
    { value: 'student.', label: '学生认证' }
  ];

  function stBadge(map, key) { var m = map[key] || ['未知', 'default']; return TF.ui.badge(m[0], m[1]); }
  function roleBadge(role) { var m = ROLE[role] || ['学生', 'default']; return TF.ui.badge(m[0], m[1]); }

  /* ------------------------------------------------------- 查询 / 链接 */
  function Q(ctx, k, d) {
    var rq = (TF.route && TF.route.query) || {};
    var v = (ctx && ctx.query) ? ctx.query[k] : null;
    if (v == null || v === '') v = rq[k];
    return (v == null || v === '') ? d : v;
  }
  function QN(ctx, k, d) { var n = parseInt(Q(ctx, k, ''), 10); return (isFinite(n) && n > 0) ? n : d; }
  function merge(a, b) {
    var o = {}, k;
    for (k in a) if (Object.prototype.hasOwnProperty.call(a, k)) o[k] = a[k];
    for (k in b) if (Object.prototype.hasOwnProperty.call(b, k)) o[k] = b[k];
    return o;
  }
  function href(section, params) {
    var parts = [];
    Object.keys(params || {}).forEach(function (k) {
      var v = params[k];
      if (v === '' || v === null || v === undefined || v === false) return;
      parts.push(encodeURIComponent(k) + '=' + encodeURIComponent(v));
    });
    return '#/admin/' + section + (parts.length ? '?' + parts.join('&') : '');
  }

  /* --------------------------------------------------------- 通用片段 */
  /* 信息流区块：.block--box（有边框）+ block--flush（内容贴边，给列表用） */
  function block(title, body, o) {
    o = o || {};
    return '<div class="block block--box' + (o.flush ? ' block--flush' : '') + '">' +
      '<div class="block__head"><h2 class="block__title">' + E(title) + '</h2>' +
      (o.more ? '<a class="block__more" href="' + AT(o.more.href) + '">' + E(o.more.text) + ' →</a>' : (o.head || '')) +
      '</div><div class="block__body">' + body + '</div></div>';
  }
  function emptyLine(text) { return '<p class="text-sm text-muted">' + E(text) + '</p>'; }
  function table(heads, rows, emptyText, scope) {
    var th = heads.map(function (h) { return '<th' + (h.cls ? ' class="' + h.cls + '"' : '') + '>' + h.t + '</th>'; }).join('');
    var body = rows.length
      ? rows.map(function (r) { return '<tr>' + r.join('') + '</tr>'; }).join('')
      : '<tr><td class="tbody-empty" colspan="' + heads.length + '">' + E(emptyText) + '</td></tr>';
    return '<div class="table-wrap"' + (scope ? ' data-check-scope' : '') + '><table class="table table--hover">' +
      '<thead><tr>' + th + '</tr></thead><tbody>' + body + '</tbody></table></div>';
  }
  function td(html, cls) { return '<td' + (cls ? ' class="' + cls + '"' : '') + '>' + html + '</td>'; }
  function checkTd(id, type) {
    return td('<input class="check__box" type="checkbox" data-check-item value="' + AT(id) + '" data-action-change="admin.bulk" data-param="' + P({ type: type }) + '" aria-label="选这一行">', 'is-check');
  }
  function checkHead() { return { t: '<input class="check__box" type="checkbox" data-check-all aria-label="全选本页">', cls: 'is-check' }; }
  function userLink(u, fallback) {
    if (!u) return '<span class="text-muted">' + E(fallback || '已注销') + '</span>';
    return '<a href="#/u/' + AT(u.id) + '">' + E(u.nickname || u.username) + '</a>';
  }
  function pager(section, filters, res) {
    if (!res || !res.pages || res.pages <= 1) return '';
    return '<div class="mt-3">' + TF.ui.pagination({
      page: res.page, pages: res.pages, total: res.total,
      makeHref: function (p) { return href(section, merge(filters, { page: p })); }
    }) + '</div>';
  }
  function filterbar(section, items, extra) {
    /* 手机上：一列满宽表单（输入框 16px 防 iOS 放大、按钮整行），不用横向滚动 */
    if (isPhone()) {
      var fields = items.map(function (it) {
        if (it.type === 'select') return TF.ui.selectField({ label: it.label, name: it.name, value: it.value, options: it.options });
        return TF.ui.field({ label: it.label, name: it.name, value: it.value, placeholder: it.placeholder, type: 'search' });
      }).join('');
      return '<form class="card card--pad mt-3" data-action="admin.filter" data-param="' + P({ section: section }) + '">' +
        '<div class="formgrid">' + fields + '</div>' +
        '<div class="cluster mt-3"><button type="submit" class="btn btn--primary btn--block">' + IC('filter', 14) + '<span>筛选</span></button>' +
        '<button type="button" class="btn btn--ghost btn--block"' + ACT('admin.filter.reset', { section: section }) + '>重置</button></div></form>';
    }
    var html = items.map(function (it) {
      var ctl;
      if (it.type === 'select') {
        ctl = '<select class="select" name="' + AT(it.name) + '">' + (it.options || []).map(function (op) {
          var on = String(op.value) === String(it.value);
          return '<option value="' + AT(op.value) + '"' + (on ? ' selected' : '') + '>' + E(op.label) + '</option>';
        }).join('') + '</select>';
      } else {
        ctl = '<input class="input" type="search" name="' + AT(it.name) + '" value="' + AT(it.value || '') + '" placeholder="' + AT(it.placeholder || '') + '">';
      }
      return '<label class="filterbar__item"><span>' + E(it.label) + '</span>' + ctl + '</label>';
    }).join('');
    return '<form class="filterbar" data-action="admin.filter" data-param="' + P({ section: section }) + '">' + html +
      '<span class="spacer"></span>' + (extra || '') +
      '<button type="submit" class="btn btn--primary btn--sm">' + IC('filter', 13) + '<span>筛选</span></button>' +
      '<button type="button" class="btn btn--ghost btn--sm"' + ACT('admin.filter.reset', { section: section }) + '>重置</button></form>';
  }
  function bulkbar(type, ops) {
    /* 手机上贴底固定（样式在 mobile.css 的 ≤620px 段里），显隐用 .is-hidden 类控制：
       选中才出现，免得浮层一直压着卡片内容；列表尾部留一段占位，最后一张卡不被盖住。 */
    var phone = isPhone();
    return '<div class="bulkbar' + (phone ? ' is-hidden' : '') + '"><span class="bulkbar__count">选中 <b data-bulk-count>0</b> 项</span>' +
      ops.map(function (o) {
        return '<button type="button" class="btn btn--' + (o.variant || 'outline') + ' btn--sm" disabled data-bulk-btn' +
          ACT('admin.batch', { type: type, op: o.op }) + '>' + (o.icon ? IC(o.icon, 13) : '') + '<span>' + E(o.text) + '</span></button>';
      }).join('') +
      '<button type="button" class="btn btn--text btn--sm" data-action="admin.bulk.clear">取消选择</button></div>' +
      (phone ? '<div class="p-6" aria-hidden="true"></div>' : '');
  }
  /* 紧凑页头：面包屑 + 一行标题（标题 · 能干什么 · 计数 · 操作），不写介绍段落 */
  function head(section, actions) {
    var s = SEC[section];
    return '<div class="page__head mt-4">' +
      TF.ui.breadcrumb([{ text: '管理后台', href: '#/admin/dashboard' }, { text: s.label }]) +
      '<div class="cluster mt-2"><h1 class="page__title">' + E(s.title) + '</h1>' +
      '<span class="text-xs text-muted">' + E(s.acts) + '</span>' +
      '<span class="spacer"></span>' + (actions || '') + '</div></div>';
  }
  function settingRow(title, desc, ctl) {
    return '<div class="cluster"><div><b class="text-sm">' + E(title) + '</b>' +
      (desc ? '<div class="text-xs text-muted">' + E(desc) + '</div>' : '') + '</div>' +
      '<span class="spacer"></span>' + ctl + '</div><hr class="divider">';
  }
  function finish(res, msg) {
    if (res && res.ok) {
      var n = (res.count != null && res.count > 1) ? ' ' + res.count + ' 项' : '';
      TF.ui.toast((msg || '好了') + n, 'success');
      TF.app.refresh();
      return true;
    }
    TF.ui.toast((res && res.error) || '没成功，再试一次', 'error');
    return false;
  }
  function confirmBox(o) {
    if (TF.ui.modal && TF.ui.modal.confirm) return TF.ui.modal.confirm(o);
    return Promise.resolve(window.confirm(o.title + '\n' + (o.body || '')));
  }
  function openModal(id) { if (TF.ui.modal && TF.ui.modal.open) TF.ui.modal.open(id); }
  function closeModal(id) { if (TF.ui.modal && TF.ui.modal.close) { try { TF.ui.modal.close(id); } catch (e) { /* 忽略 */ } } }
  function askModal(kind, extra, section) {
    tmp.modal = merge({ kind: kind, section: section }, extra || {});
    TF.app.refresh();
    openModal('admin-modal');
  }
  function selectedIds() {
    var out = [], list = document.querySelectorAll('[data-check-item]');
    for (var i = 0; i < list.length; i++) if (list[i].checked) out.push(list[i].value);
    return out;
  }

  /* ============================================================ 手机端（≤620px）
     手机上表格换成卡片：一行一张卡，操作按钮单独一行（mobile.css 保证 .btn--sm ≥40px）。
     桌面端一行都不受影响：isPhone() 为假时全部走原来的表格分支。 */
  var PHONE_MAX = 620;
  function isPhone() { return typeof window !== 'undefined' && !!window.innerWidth && window.innerWidth <= PHONE_MAX; }
  var lastPhone = null, resizeBound = false;

  function drawerClose() {
    var sb = document.querySelector('.sidebar');
    if (sb && sb.classList) sb.classList.remove('is-open');
    if (document.body && document.body.classList) document.body.classList.remove('nav-open');
  }
  /* mobile.css 需要 .sidebar__backdrop 才有点击遮罩；app.js 不插这个元素，这里幂等补上。
     每次渲染后收起抽屉，手机上点完菜单不会卡在抽屉里。 */
  function drawerSync() {
    if (!isPhone()) { drawerClose(); return; }
    if (!document.querySelector('.sidebar__backdrop') && document.createElement) {
      var wrap = document.querySelector('.app__adminwrap') || document.body;
      if (wrap && wrap.appendChild) {
        var back = document.createElement('div');
        back.className = 'sidebar__backdrop';
        back.setAttribute('aria-hidden', 'true');
        wrap.appendChild(back);
      }
    }
    drawerClose();
  }
  var drawerClickBound = false;
  function drawerBindOnce() {
    if (drawerClickBound || !document.addEventListener) return;
    drawerClickBound = true;
    document.addEventListener('click', function (ev) {
      if (!isPhone()) return;
      var t = ev.target;
      if (!t || !t.closest) return;
      if (t.closest('.sidebar__link') || t.closest('.sidebar__backdrop')) drawerClose();
    }, false);
  }
  function onViewportChange() {
    var now = isPhone();
    if (lastPhone === null) { lastPhone = now; return; }
    if (now === lastPhone) return;
    lastPhone = now;
    if (!now) drawerClose();
    TF.app.refresh();
  }
  function watchViewport() {
    drawerBindOnce();
    drawerSync();
    lastPhone = isPhone();
    if (resizeBound || !window.addEventListener) return;
    resizeBound = true;
    var fire = function () { onViewportChange(); };
    var deb = TF.util.debounce ? TF.util.debounce(fire, 220) : fire;
    window.addEventListener('resize', deb, false);
    window.addEventListener('orientationchange', deb, false);
  }

  /* 卡片零件 */
  function mMeta(items) {
    return '<div class="cluster mt-2 text-xs text-muted">' + items.filter(Boolean).join('<span class="text-muted">·</span>') + '</div>';
  }
  function mCheck(id, type) {
    return '<label class="check"><input class="check__box" type="checkbox" data-check-item value="' + AT(id) + '" data-action-change="admin.bulk" data-param="' + P({ type: type }) + '" aria-label="选中这一条"><span class="text-xs text-muted">选中</span></label>';
  }
  function mBtn(text, action, param, variant) {
    return '<button type="button" class="btn btn--' + (variant || 'outline') + ' btn--sm"' + ACT(action, param) + '>' + E(text) + '</button>';
  }
  function mCard(headHTML, titleHTML, metaHTML, actions) {
    return '<div class="tile">' + headHTML + '<div class="mt-1">' + titleHTML + '</div>' + metaHTML +
      '<div class="cluster mt-3">' + actions.join('') + '</div></div>';
  }
  function mList(cards, emptyText) {
    if (!cards.length) return '<div class="card card--pad mt-3 center text-sm text-muted">' + E(emptyText) + '</div>';
    return '<div data-check-scope><div class="cluster mt-3 mb-2">' +
      '<label class="check"><input class="check__box" type="checkbox" data-check-all aria-label="全选本页"><span class="text-xs text-muted">全选本页</span></label>' +
      '</div><div class="stack">' + cards.join('') + '</div></div>';
  }

  /* 筛选条件与批量动作只定义一份，桌面/手机共用，避免两边不一致 */
  function filtersFor(section, f) {
    if (section === 'posts') return [
      { label: '关键词', name: 'keyword', value: f.keyword, placeholder: '标题或正文' },
      { label: '版块', name: 'boardId', type: 'select', value: f.boardId, options: [{ value: '', label: '全部' }].concat(TF.store.listBoards().map(function (b) { return { value: b.id, label: b.name }; })) },
      { label: '状态', name: 'status', type: 'select', value: f.status, options: [{ value: '', label: '全部' }, { value: 'published', label: '已发布' }, { value: 'pending', label: '待审核' }, { value: 'hidden', label: '已下架' }, { value: 'deleted', label: '已删除' }] },
      { label: '排序', name: 'sort', type: 'select', value: f.sort, options: [{ value: 'new', label: '最新' }, { value: 'hot', label: '最热' }, { value: 'views', label: '浏览最多' }, { value: 'comments', label: '评论最多' }] }
    ];
    if (section === 'comments') return [
      { label: '关键词', name: 'keyword', value: f.keyword, placeholder: '评论内容' },
      { label: '状态', name: 'status', type: 'select', value: f.status, options: [{ value: '', label: '全部' }, { value: 'published', label: '已发布' }, { value: 'hidden', label: '已隐藏' }, { value: 'deleted', label: '已删除' }] }
    ];
    if (section === 'users') return [
      { label: '关键词', name: 'keyword', value: f.keyword, placeholder: '昵称 / 用户名 / 班级' },
      { label: '角色', name: 'role', type: 'select', value: f.role, options: [{ value: '', label: '全部' }, { value: 'student', label: '学生' }, { value: 'mod', label: '版主' }, { value: 'admin', label: '超管' }] },
      { label: '状态', name: 'status', type: 'select', value: f.status, options: [{ value: '', label: '全部' }, { value: 'active', label: '正常' }, { value: 'banned', label: '已封禁' }] },
      { label: '排序', name: 'sort', type: 'select', value: f.sort, options: [{ value: 'points', label: '积分' }, { value: 'posts', label: '发帖' }, { value: 'new', label: '最新注册' }, { value: 'active', label: '最近活跃' }, { value: 'name', label: '用户名' }] }
    ];
    if (section === 'boards') return [{ label: '关键词', name: 'keyword', value: f.keyword, placeholder: '版块名或分组' }];
    if (section === 'notices') return [{ label: '关键词', name: 'keyword', value: f.keyword, placeholder: '标题或正文' }];
    if (section === 'logs') return [
      { label: '动作', name: 'action', type: 'select', value: f.action, options: LOG_ACTIONS },
      { label: '谁干的', name: 'actorId', type: 'select', value: f.actorId, options: [{ value: '', label: '全部' }].concat(TF.store.adminList({ type: 'user', size: 500 }).list.map(function (u) { return { value: u.id, label: u.nickname || u.username }; })) }
    ];
    return [];
  }
  var BULK_OPS = {
    post: [
      { text: '置顶', op: 'pin' }, { text: '取消置顶', op: 'unpin' }, { text: '加精', op: 'feature' },
      { text: '取消加精', op: 'unfeature' }, { text: '下架', op: 'hide' }, { text: '发布', op: 'publish' },
      { text: '删掉', op: 'delete', variant: 'danger' }
    ],
    comment: [{ text: '隐藏', op: 'hide' }, { text: '放出来', op: 'publish' }, { text: '删掉', op: 'delete', variant: 'danger' }],
    user: [{ text: '封禁', op: 'ban', variant: 'danger' }, { text: '解封', op: 'unban' }, { text: '删号', op: 'delete', variant: 'danger' }],
    report: [{ text: '标记已处理', op: 'resolve' }, { text: '驳回', op: 'reject' }]
  };

  /* 卡片列表（每个列表页一份，字段与桌面表格一致） */
  function postsCards(res) {
    return mList((res.list || []).map(function (p) {
      var u = TF.store.getUser(p.authorId), b = TF.store.getBoard(p.boardId);
      var mark = (p.pinned ? TF.ui.badge('置顶', 'primary') : '') + (p.featured ? TF.ui.badge('精华', 'warn') : '') + (p.locked ? TF.ui.badge('锁帖', 'default') : '');
      return mCard(
        '<div class="cluster">' + mCheck(p.id, 'post') + stBadge(POST_STATUS, p.status) + mark + '</div>',
        '<a href="#/post/' + AT(p.id) + '"><b>' + E(p.title) + '</b></a>',
        mMeta([u ? E(u.nickname || u.username) : '已注销', b ? E(b.name) : '', '浏览 ' + NUM(p.views), '赞 ' + NUM(p.likes), '评论 ' + NUM(p.commentCount), E(REL(p.createdAt))]),
        [
          mBtn('编辑', 'admin.post.edit', { id: p.id }),
          mBtn(p.pinned ? '取消置顶' : '置顶', 'admin.one', { type: 'post', id: p.id, op: p.pinned ? 'unpin' : 'pin', msg: p.pinned ? '取消置顶了' : '置顶了' }),
          mBtn(p.featured ? '取消加精' : '加精', 'admin.one', { type: 'post', id: p.id, op: p.featured ? 'unfeature' : 'feature', msg: p.featured ? '取消加精了' : '加精了' }),
          mBtn(p.status === 'published' ? '下架' : '发布', 'admin.post.status', { id: p.id, status: p.status === 'published' ? 'hidden' : 'published' }),
          mBtn('删掉', 'admin.post.delete', { id: p.id }, 'danger')
        ]);
    }), '没找到，换个词或状态试试');
  }
  function commentsCards(res) {
    return mList((res.list || []).map(function (c) {
      var u = TF.store.getUser(c.authorId), p = TF.store.adminGet('post', c.postId);
      return mCard(
        '<div class="cluster">' + mCheck(c.id, 'comment') + stBadge(COMMENT_STATUS, c.status) +
          (c.parentId ? '<span class="text-xs text-muted">回复 ' + E(c.replyToName || '楼上') + '</span>' : '') + '</div>',
        E(EXC(c.content, 80)),
        mMeta([u ? E(u.nickname || u.username) : '已注销', '赞 ' + NUM(c.likes), E(REL(c.createdAt)),
          p ? '<a href="#/post/' + AT(p.id) + '">' + E(EXC(p.title, 16)) + '</a>' : '帖子没了']),
        [
          c.status === 'published'
            ? mBtn('隐藏', 'admin.one', { type: 'comment', id: c.id, op: 'hide', msg: '隐藏了' })
            : mBtn('放出来', 'admin.one', { type: 'comment', id: c.id, op: 'publish', msg: '放出来了' }),
          mBtn('删掉', 'admin.comment.delete', { id: c.id }, 'danger')
        ]);
    }), '没找到评论');
  }
  /* 隐私字段（真实姓名 / 班级 / 学号）：超管能看到，版主和别人拿到的是空串。
     服务端已经按角色过滤，这里只是把"看不到"显示成"—"，并给个说明。 */
  function privateCell(u, which) {
    var val = which === 'name' ? (u.realName || '') : (u.klass || '');
    if (val) {
      return '<span>' + E(val) + '</span>' +
        (which === 'klass' && u.studentNo ? '<div class="text-xs text-muted">学号 ' + E(u.studentNo) + '</div>' : '');
    }
    /* 空串：要么没填，要么当前身份看不到 */
    if (u.hasRealName || u.hasStudentNo) return '<span class="text-muted" title="只有超级管理员能看到">仅超管可见</span>';
    return '<span class="text-muted">未填</span>';
  }

  function usersCards(res) {
    var me = TF.store.currentUser() || {};
    return mList((res.list || []).map(function (u) {
      var acts = [];
      /* nick 一起带上：万一前端快照里没这个人，至少提示语能显示"是谁"（动作本身服务端校验） */
      var who = { id: u.id, nick: u.nickname || u.username || '' };
      var withRole = function (role) { return { id: u.id, nick: who.nick, role: role }; };
      if (u.banned) acts.push(mBtn('解封', 'admin.one', { type: 'user', id: u.id, op: 'unban', msg: '解封了' }));
      else acts.push(mBtn('封禁', 'admin.user.ban.open', who, 'danger'));
      if (u.role === 'student') acts.push(mBtn('设版主', 'admin.user.role', withRole('mod')));
      if (u.role === 'mod') acts.push(mBtn('取消版主', 'admin.user.role', withRole('student')));
      if (u.role !== 'admin') acts.push(mBtn('设超管', 'admin.user.role', withRole('admin')));
      if (u.role === 'admin' && u.id !== me.id) acts.push(mBtn('降为学生', 'admin.user.role', withRole('student')));
      if (u.role === 'mod' && me.role === 'admin') acts.push(mBtn('负责版块', 'admin.user.boards', { id: u.id, nick: who.nick }));
      acts.push(mBtn('重置密码', 'admin.user.pwd', who));
      acts.push(mBtn('删号', 'admin.user.delete', { id: u.id }, 'danger'));
      return mCard(
        '<div class="cluster">' + mCheck(u.id, 'user') + roleBadge(u.role) +
          (u.banned ? TF.ui.badge('已封禁', 'danger') : TF.ui.badge('正常', 'success')) +
          (u.id === me.id ? '<span class="text-xs text-muted">我</span>' : '') + '</div>',
        '<a href="#/u/' + AT(u.id) + '"><b>' + E(u.nickname || u.username) + '</b></a> <span class="text-xs text-muted">@' + E(u.username) + '</span>',
        mMeta([u.realName ? '真实姓名 ' + u.realName : (u.hasRealName ? '真实姓名仅超管可见' : ''),
          u.klass ? '班级 ' + u.klass : '', u.studentNo ? '学号 ' + u.studentNo : '',
          u.grade ? E(u.grade) : '', '积分 ' + NUM(u.points), '发帖 ' + NUM(u.stats && u.stats.posts),
          u.lastLoginAt ? E(REL(u.lastLoginAt)) : '没登过', u.banned && u.banReason ? E(EXC(u.banReason, 14)) : '']),
        acts);
    }), '没有这个人');
  }
  function boardsCards(res) {
    return mList((res.list || []).map(function (b) {
      return mCard(
        '<div class="cluster"><span class="board-card__icon">' + IC(b.icon, 15) + '</span>' + TF.ui.tag(b.group) +
          (b.locked ? TF.ui.badge('已锁定', 'warn') : TF.ui.badge('开放', 'success')) + '</div>',
        '<b>' + E(b.name) + '</b>',
        mMeta([E(EXC(b.desc, 30)), '帖子 ' + NUM(b.stats && b.stats.posts), '今日 ' + NUM(b.stats && b.stats.today), '排序 ' + NUM(b.order)]),
        [
          mBtn('编辑', 'admin.board.edit', { id: b.id }),
          mBtn('上移', 'admin.board.move', { id: b.id, dir: -1 }),
          mBtn('下移', 'admin.board.move', { id: b.id, dir: 1 }),
          mBtn(b.locked ? '解锁' : '锁定', 'admin.board.lock', { id: b.id }),
          mBtn('删掉', 'admin.board.delete', { id: b.id }, 'danger')
        ]);
    }), '没有匹配的版块');
  }
  function reportsCards(res, raw) {
    return mList((res.list || []).map(function (r) {
      var reporter = TF.store.getUser(r.reporterId);
      var summary = '', link = '';
      if (r.targetType === 'post') {
        var p = TF.store.adminGet('post', r.targetId);
        summary = p ? EXC(p.title, 22) : '帖子已删除';
        link = '#/post/' + r.targetId;
      } else if (r.targetType === 'comment') {
        var c = TF.store.adminGet('comment', r.targetId);
        summary = c ? EXC(c.content, 22) : '评论已删除';
        link = c ? '#/post/' + c.postId : '';
      } else {
        var u = TF.store.adminGet('user', r.targetId);
        summary = u ? (u.nickname || u.username) : '用户已注销';
        link = '#/u/' + r.targetId;
      }
      var tl = { post: ['帖子', 'primary'], comment: ['评论', 'info'], user: ['用户', 'warn'] }[r.targetType] || ['其他', 'default'];
      return mCard(
        '<div class="cluster">' + mCheck(r.id, 'report') + TF.ui.badge(tl[0], tl[1]) + stBadge(REPORT_STATUS, r.status) + '</div>',
        link ? '<a href="' + AT(link) + '"><b>' + E(summary) + '</b></a>' : '<b>' + E(summary) + '</b>',
        mMeta([reporter ? E(reporter.nickname || reporter.username) + ' 举报' : '', E(EXC(r.reason, 20)),
          r.detail ? E(EXC(r.detail, 20)) : '', E(REL(r.createdAt)), r.handleNote ? E(EXC(r.handleNote, 12)) : '']),
        r.status === 'pending'
          ? [mBtn('标记已处理', 'admin.report.handle', { id: r.id, status: 'resolved' }), mBtn('驳回', 'admin.report.handle', { id: r.id, status: 'rejected' })]
          : [mBtn('看记录', 'admin.report.handle', { id: r.id, status: r.status })]);
    }), raw === 'pending' ? '没有待处理的举报' : '这里还空着');
  }
  function noticesCards(res) {
    return mList((res.list || []).map(function (n) {
      var u = TF.store.getUser(n.authorId);
      return mCard(
        '<div class="cluster">' + stBadge(LEVEL, n.level) + (n.top ? TF.ui.badge('置顶', 'primary') : '') +
          '<span class="text-xs text-muted">' + E(FMT(n.createdAt)) + '</span></div>',
        '<b>' + E(n.title) + '</b>',
        mMeta([E(EXC(n.content, 44)), u ? E(u.nickname || u.username) : '']),
        [
          mBtn('预览', 'admin.notice.preview', { id: n.id }),
          mBtn('编辑', 'admin.notice.edit', { id: n.id }),
          mBtn('删掉', 'admin.notice.delete', { id: n.id }, 'danger')
        ]);
    }), '还没发过公告');
  }
  function logsCards(res) {
    return mList((res.list || []).map(function (g) {
      var u = TF.store.getUser(g.actorId);
      return mCard(
        '<div class="cluster"><span class="text-xs text-muted">' + E(FMT(g.createdAt)) + '</span>' +
          '<span class="mono text-xs">' + E(g.action) + '</span></div>',
        E(g.detail || '—'),
        mMeta([u ? E(u.nickname || u.username) : '系统', g.target ? '<span class="mono">' + E(g.target) + '</span>' : '']),
        []);
    }), '没有符合条件的日志');
  }

  /* --------------------------------------------------------------- 弹窗 */
  function buttonsRow(okText, danger) {
    return '<div class="cluster mt-4"><button type="submit" class="btn btn--' + (danger ? 'danger' : 'primary') + '">' + E(okText) + '</button>' +
      '<button type="button" class="btn btn--ghost" data-action="admin.modal.cancel" data-modal-close>取消</button></div>';
  }
  function editModal() {
    var m = tmp.modal;
    if (!m || !TF.ui.modal) return '';
    var body = '', title = '';
    if (m.kind === 'post') {
      var p = TF.store.adminGet('post', m.id);
      if (!p) return '';
      body = '<form class="form" data-action="admin.post.save"><input type="hidden" name="id" value="' + AT(p.id) + '">' +
        TF.ui.field({ label: '标题', name: 'title', value: p.title, required: true, block: true, maxlength: 60, hint: '至少 4 个字' }) +
        '<div class="formgrid mt-3">' +
        TF.ui.selectField({ label: '版块', name: 'boardId', value: p.boardId, options: TF.store.listBoards().map(function (b) { return { value: b.id, label: b.name }; }) }) +
        TF.ui.selectField({ label: '状态', name: 'status', value: p.status, options: Object.keys(POST_STATUS).map(function (k) { return { value: k, label: POST_STATUS[k][0] }; }), hint: '改成已发布会通知作者' }) +
        TF.ui.field({ label: '标签', name: 'tags', value: (p.tags || []).join('，'), hint: '逗号分隔，最多 5 个' }) +
        TF.ui.checkField({ label: '置顶', name: 'pinned', checked: !!p.pinned, block: true }) +
        TF.ui.checkField({ label: '加精', name: 'featured', checked: !!p.featured, block: true }) +
        '</div>' + TF.ui.textarea({ label: '正文', name: 'content', value: p.content, rows: 10, block: true, required: true, hint: '支持 Markdown，至少 10 个字' }) +
        buttonsRow('存起来') + '</form>';
      return TF.ui.modal({ id: 'admin-modal', title: '编辑帖子 #' + p.id, body: body, size: 'lg' });
    }
    if (m.kind === 'board') {
      var b = m.id ? TF.store.getBoard(m.id) : null;
      if (m.id && !b) return '';
      var bd = b || { name: '', desc: '', icon: 'forum', group: '校园生活', order: TF.store.listBoards().length + 1, minRole: 'student', locked: false, color: 0 };
      body = '<form class="form" data-action="admin.board.save"><input type="hidden" name="id" value="' + AT(b ? b.id : '') + '">' +
        '<div class="formgrid">' +
        TF.ui.field({ label: '版块名', name: 'name', value: bd.name, required: true, maxlength: 12, hint: '2~12 个字，例如「社团活动」' }) +
        TF.ui.selectField({ label: '图标', name: 'icon', value: bd.icon, options: BOARD_ICONS.map(function (n) { return { value: n, label: n }; }) }) +
        TF.ui.field({ label: '分组', name: 'group', value: bd.group, hint: '例如「校园官方」「校园生活」' }) +
        TF.ui.field({ label: '排序', name: 'order', type: 'number', value: bd.order, hint: '数字越小越靠前' }) +
        TF.ui.selectField({ label: '谁能发帖', name: 'minRole', value: bd.minRole, options: [{ value: 'student', label: '所有同学' }, { value: 'mod', label: '仅版主' }, { value: 'admin', label: '仅超管' }] }) +
        TF.ui.selectField({ label: '配色', name: 'color', value: bd.color, options: [0, 1, 2, 3, 4].map(function (i) { return { value: i, label: '配色 ' + (i + 1) }; }) }) +
        TF.ui.checkField({ label: '锁定（锁后不能发新帖）', name: 'locked', checked: !!bd.locked, block: true }) +
        '</div>' + TF.ui.textarea({ label: '简介', name: 'desc', value: bd.desc, rows: 3, block: true, maxlength: 60 }) +
        buttonsRow(b ? '存起来' : '建好') + '</form>';
      return TF.ui.modal({ id: 'admin-modal', title: b ? '编辑版块「' + b.name + '」' : '新建版块', body: body, size: 'lg' });
    }
    if (m.kind === 'notice') {
      var n = m.id ? TF.store.getNotice(m.id) : null;
      if (m.id && !n) return '';
      var nd = n || { title: '', content: '', level: 'info', top: false };
      body = '<form class="form" data-action="admin.notice.save"><input type="hidden" name="id" value="' + AT(n ? n.id : '') + '">' +
        TF.ui.field({ label: '标题', name: 'title', value: nd.title, required: true, block: true, maxlength: 40, hint: '至少 4 个字' }) +
        '<div class="formgrid mt-3">' +
        TF.ui.selectField({ label: '级别', name: 'level', value: nd.level, options: [{ value: 'info', label: '普通' }, { value: 'warn', label: '提醒' }, { value: 'important', label: '重要' }] }) +
        TF.ui.checkField({ label: '置顶', name: 'top', checked: !!nd.top, block: true }) +
        '</div>' + TF.ui.textarea({ label: '正文', name: 'content', value: nd.content, rows: 8, block: true, required: true, hint: '支持 Markdown，至少 10 个字' }) +
        buttonsRow(n ? '存起来' : '发出去') + '</form>';
      return TF.ui.modal({ id: 'admin-modal', title: n ? '编辑公告' : '发公告', body: body, size: 'lg' });
    }
    if (m.kind === 'notice-view') {
      var nv = TF.store.getNotice(m.id);
      if (!nv) return '';
      body = '<div class="cluster">' + stBadge(LEVEL, nv.level) + (nv.top ? TF.ui.badge('置顶', 'primary') : '') +
        '<span class="metaitem">' + IC('clock', 13) + E(FMT(nv.createdAt)) + '</span></div>' +
        '<h3 class="mt-3">' + E(nv.title) + '</h3><hr class="divider">' +
        '<div class="markdown markdown--preview">' + TF.util.md(nv.content) + '</div>' +
        '<div class="cluster mt-4"><button type="button" class="btn btn--primary" data-modal-close>关了</button></div>';
      return TF.ui.modal({ id: 'admin-modal', title: '公告预览', body: body, size: 'lg' });
    }
    if (m.kind === 'ban') {
      var u = TF.store.getUser(m.id);
      if (!u) return '';
      body = '<form class="form" data-action="admin.user.ban"><input type="hidden" name="id" value="' + AT(u.id) + '">' +
        '<p class="text-sm text-2">封了 <b>' + E(u.nickname || u.username) + '</b>（@' + E(u.username) + '）之后，他登不上、发不了帖也评不了论。</p>' +
        TF.ui.textarea({ label: '封禁原因', name: 'reason', rows: 3, required: true, placeholder: '例如：连着发了好几条广告', hint: '原因会发到他的消息中心，写清楚点' }) +
        buttonsRow('封禁', true) + '</form>';
      return TF.ui.modal({ id: 'admin-modal', title: '封禁账号', body: body });
    }
    if (m.kind === 'report') {
      var r = TF.store.adminGet('report', m.id);
      if (!r) return '';
      var isResolve = m.status === 'resolved';
      body = '<form class="form" data-action="admin.report.note"><input type="hidden" name="id" value="' + AT(r.id) + '">' +
        '<input type="hidden" name="status" value="' + AT(m.status) + '">' +
        '<p class="text-sm text-2">' + (isResolve ? '当成真的处理' : '当成误报驳回') + '：<b>' + E(EXC(r.reason, 40)) + '</b></p>' +
        TF.ui.textarea({ label: '备注', name: 'note', rows: 3, placeholder: isResolve ? '例如：帖子已下架，也提醒了作者' : '例如：内容没问题，是误会', hint: '备注会一起发给举报人' }) +
        buttonsRow(isResolve ? '标记已处理' : '驳回') + '</form>';
      return TF.ui.modal({ id: 'admin-modal', title: isResolve ? '处理举报' : '驳回举报', body: body });
    }
    if (m.kind === 'modboards') {
      /* 版主负责的版块：勾上哪些，他就只能管哪些（不勾 = 不限，能管全部内容） */
      var ub = findUserForAction ? findUserForAction({ param: { id: m.id, nick: m.nick } }) : null;
      body = '<form class="form" data-action="admin.user.boards.save">' +
        '<input type="hidden" name="id" value="' + AT(m.id) + '">' +
        '<p class="text-sm text-2">给 <b>' + E(m.nick || '这位版主') + '</b> 勾上他负责的版块：' +
        '他只能删/改/置顶这些版块里的帖子和评论，用户管理和站点设置仍然只有超管能动。</p>' +
        '<div class="mt-3">' + (m.boxes || '（还没有版块）') + '</div>' +
        '<p class="text-xs text-muted mt-3">一个都不勾 = 不限制（他能管所有版块的内容）。</p>' +
        buttonsRow('存起来') + '</form>';
      return TF.ui.modal({ id: 'admin-modal', title: '版主负责哪些版块', body: body, size: 'lg' });
    }
    if (m.kind === 'pwd') {
      body = '<p class="text-sm text-2"><b>' + E(m.name) + '</b> 的新密码，复制给他：</p>' +
        '<div class="cluster mt-3"><code class="mono text-lg">' + E(m.pwd) + '</code>' +
        '<button type="button" class="btn btn--outline btn--sm" data-copy="' + AT(m.pwd) + '">' + IC('key', 13) + '<span>复制</span></button></div>' +
        '<p class="text-xs text-muted mt-3">只显示这一次，关了就得再重置一回。</p>' +
        '<div class="cluster mt-4"><button type="button" class="btn btn--primary" data-modal-close>好</button></div>';
      return TF.ui.modal({ id: 'admin-modal', title: '密码重置好了', body: body, size: 'sm' });
    }
    return '';
  }

  /* ------------------------------------------------------ 1 数据总览 */
  function renderDashboard(ctx) {
    var a = TF.store.adminStats();
    var trend = a.trend || [];
    var labels = trend.map(function (t) { return t.date; });
    var pv = { labels: labels, series: [{ name: '浏览量', data: trend.map(function (t) { return t.pv; }) }, { name: '独立访客', data: trend.map(function (t) { return t.uv; }) }] };
    var cp = { labels: labels, series: [{ name: '发帖', data: trend.map(function (t) { return t.posts; }) }, { name: '评论', data: trend.map(function (t) { return t.comments; }) }] };
    var sv = a.studentVerify || { pending: 0, external: 0 };
    var stats = '<div class="statgrid">' +
      TF.ui.statCard({ label: '注册成员', value: NUM(a.users.total), delta: a.users.today, icon: 'users', tone: 'accent' }) +
      TF.ui.statCard({ label: '帖子', value: NUM(a.posts.total), delta: a.posts.today, icon: 'edit' }) +
      TF.ui.statCard({ label: '评论', value: NUM(a.comments.total), delta: a.comments.today, icon: 'comment', tone: 'success' }) +
      TF.ui.statCard({ label: '待审核', value: NUM(a.posts.pending), icon: 'alert', tone: 'warn' }) +
      TF.ui.statCard({ label: '待处理举报', value: NUM(a.reports.pending), icon: 'flag', tone: 'danger' }) +
      (isSuper() ? TF.ui.statCard({ label: '待认证学生', value: NUM(sv.pending), icon: 'shield', tone: 'warn' }) : '') +
      TF.ui.statCard({ label: '今日浏览', value: NUM(a.pvToday), icon: 'chart' }) +
      '</div>';
    var hot = TF.store.hotPosts(6).map(function (p, i) {
      return '<a class="rankrow" href="#/post/' + AT(p.id) + '"><span class="rankrow__no">' + (i + 1) + '</span>' +
        '<span class="rankrow__title">' + E(p.title) + '</span><span class="metaitem">' + IC('eye', 12) + NUM(p.views) + '</span></a>';
    }).join('');
    var newUsers = (a.latestUsers || []).map(function (u) {
      return '<div class="logrow">' + TF.ui.avatar(u, 26) + '<span class="logrow__text">' + E(u.nickname || u.username) +
        ' <span class="text-xs text-muted">@' + E(u.username) + ' · ' + E(REL(u.createdAt)) + '</span></span>' + roleBadge(u.role) + '</div>';
    }).join('');
    var logs = (a.latestLogs || []).map(function (g) {
      var u = TF.store.getUser(g.actorId);
      return '<div class="logrow"><span class="logrow__time">' + E(FMT(g.createdAt)) + '</span><span class="logrow__text">' +
        (u ? '<b>' + E(u.nickname || u.username) + '</b> ' : '') + E(g.detail || g.action) + '</span></div>';
    }).join('');
    var tags = (a.hotTags || []).map(function (t) {
      return '<a class="tagchip" href="#/search?q=' + encodeURIComponent(t.name) + '">' + E(t.name) + '<b>' + NUM(t.value) + '</b></a>';
    }).join('');
    var actions = '<span class="text-xs text-muted">' + NUM(a.users.total) + ' 人 · ' + NUM(a.posts.total) + ' 帖</span>' +
      (sv.pending > 0 ? '<a class="btn btn--outline btn--sm" href="#/admin/verify">' + NUM(sv.pending) + ' 位同学待学生认证</a>' : '') +
      (a.reports.pending > 0 ? '<a class="btn btn--danger btn--sm" href="#/admin/reports?status=pending">' + NUM(a.reports.pending) + ' 条举报待处理</a>' : '') +
      (a.posts.pending > 0 ? '<a class="btn btn--outline btn--sm" href="#/admin/posts?status=pending">' + NUM(a.posts.pending) + ' 篇待审核</a>' : '');
    /* 手机上图表压矮一档，少滚两屏 */
    var ch = { line: isPhone() ? 168 : 232, bar: isPhone() ? 190 : 232 };
    return head('dashboard', actions) + stats +
      '<div class="grid grid--2 mt-3">' + block('近 14 天浏览', TF.ui.chart('line', pv, { aria: '近 14 天浏览量折线图', height: ch.line })) +
      block('近 14 天发帖与评论', TF.ui.chart('line', cp, { aria: '近 14 天发帖与评论折线图', height: ch.line })) + '</div>' +
      '<div class="grid grid--2 mt-3">' + block('角色分布', TF.ui.chart('donut', a.roleDist, { centerLabel: '成员', center: NUM(a.users.total) })) +
      block('各版块帖子数', TF.ui.chart('bar', a.boardDist, { aria: '各版块帖子数柱状图', height: ch.bar })) + '</div>' +
      '<div class="grid grid--3 mt-3">' +
      block('热门标签', tags ? '<div class="tagcloud">' + tags + '</div>' : emptyLine('还没有标签')) +
      block('热帖', hot || emptyLine('还没有热帖'), { flush: !!hot, more: { href: '#/admin/posts?sort=hot', text: '更多' } }) +
      block('新注册', newUsers || emptyLine('还没有新注册'), { flush: !!newUsers }) +
      '</div>' +
      '<div class="mt-3">' + block('最近操作', logs || emptyLine('还没有操作'), { flush: !!logs, more: { href: '#/admin/logs', text: '全部' } }) + '</div>';
  }

  /* ------------------------------------------------------ 2 帖子管理 */
  function renderPosts(ctx) {;
    var f = { keyword: Q(ctx, 'keyword', ''), status: Q(ctx, 'status', ''), boardId: Q(ctx, 'boardId', ''), sort: Q(ctx, 'sort', 'new'), page: QN(ctx, 'page', 1) };
    var res = TF.store.adminList({ type: 'post', keyword: f.keyword, status: f.status, boardId: f.boardId, sort: f.sort, page: f.page, size: 15 });
    if (isPhone()) {
      return head('posts', '<span class="text-xs text-muted">共 ' + NUM(TF.store.adminStats().posts.total) + ' 帖</span>') +
        filterbar('posts', filtersFor('posts', f)) + postsCards(res) + bulkbar('post', BULK_OPS.post) + pager('posts', f, res);
    }
    var rows = (res.list || []).map(function (p) {
      var u = TF.store.getUser(p.authorId), b = TF.store.getBoard(p.boardId);
      var mark = (p.pinned ? TF.ui.badge('置顶', 'primary') : '') + (p.featured ? TF.ui.badge('精华', 'warn') : '') + (p.locked ? TF.ui.badge('锁帖', 'default') : '');
      return [
        checkTd(p.id, 'post'),
        td('<span class="mono text-xs text-muted">#' + E(p.id) + '</span>'),
        td('<a href="#/post/' + AT(p.id) + '"><b>' + E(p.title) + '</b></a>' + (mark ? ' ' + mark : '')),
        td(userLink(u)),
        td(b ? E(b.name) : '<span class="text-muted">—</span>'),
        td(stBadge(POST_STATUS, p.status)),
        td('<span class="mono">' + NUM(p.views) + '</span>', 'num'),
        td('<span class="mono">' + NUM(p.likes) + '</span>', 'num'),
        td('<span class="mono">' + NUM(p.commentCount) + '</span>', 'num'),
        td('<span class="text-xs text-muted">' + E(REL(p.createdAt)) + '</span>'),
        td('<div class="table__actions">' +
          TF.ui.button({ icon: 'edit', variant: 'ghost', size: 'sm', title: '编辑', attrs: { 'aria-label': '编辑帖子' }, action: 'admin.post.edit', param: { id: p.id } }) +
          TF.ui.button({ text: p.pinned ? '取消置顶' : '置顶', variant: 'ghost', size: 'sm', action: 'admin.one', param: { type: 'post', id: p.id, op: p.pinned ? 'unpin' : 'pin', msg: p.pinned ? '取消置顶了' : '置顶了' } }) +
          TF.ui.button({ text: p.featured ? '取消加精' : '加精', variant: 'ghost', size: 'sm', action: 'admin.one', param: { type: 'post', id: p.id, op: p.featured ? 'unfeature' : 'feature', msg: p.featured ? '取消加精了' : '加精了' } }) +
          TF.ui.button({ text: p.status === 'published' ? '下架' : '发布', variant: 'ghost', size: 'sm', action: 'admin.post.status', param: { id: p.id, status: p.status === 'published' ? 'hidden' : 'published' } }) +
          TF.ui.button({ icon: 'trash', variant: 'danger', size: 'sm', title: '删掉', attrs: { 'aria-label': '删除帖子' }, action: 'admin.post.delete', param: { id: p.id } }) +
