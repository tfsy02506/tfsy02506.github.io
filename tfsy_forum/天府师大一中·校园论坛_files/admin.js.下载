          '<div class="cluster mt-3 center">' + links + '</div></div></div>', title: '管理后台'
      };
    }
    return {
      html: '<div class="page" data-page="admin">' + RENDER[section](ctx) + editModal() + '</div>',
      title: SEC[section].title,
      onMount: function (root) {
