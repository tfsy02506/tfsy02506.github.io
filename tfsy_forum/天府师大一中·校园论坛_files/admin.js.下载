      block('发通知', form) +
      '<div class="mt-3">' + block('最近发的', table([{ t: '时间' }, { t: '标题' }, { t: '发给' }, { t: '状态' }], recRows, '还没发过通知'), { more: { href: '#/admin/logs?action=message.', text: '推送日志' } }) + '</div>';
  }

