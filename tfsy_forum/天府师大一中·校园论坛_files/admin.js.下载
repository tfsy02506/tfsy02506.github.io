  TF.app.on('admin.board.move', function (ctx) {
    var list = TF.store.listBoards();
    var i = -1;
    for (var k = 0; k < list.length; k++) if (list[k].id === ctx.param.id) i = k;
    var j = i + (ctx.param.dir < 0 ? -1 : 1);
    if (i < 0) { TF.ui.toast('版块不存在', 'error'); return; }
    if (j < 0 || j >= list.length) { TF.ui.toast(ctx.param.dir < 0 ? '已经在最前面' : '已经在最后面', 'warn'); return; }
    var arr = list.slice();
    var t = arr[i]; arr[i] = arr[j]; arr[j] = t;
    var okCount = 0;
    for (var m = 0; m < arr.length; m++) {
      if (Number(arr[m].order) === m + 1) continue;
      var r = TF.store.adminSave('board', { id: arr[m].id, name: arr[m].name, order: m + 1 });
      if (r && r.ok) okCount++;
    }
    finish({ ok: okCount > 0, count: okCount }, '顺序调好了');
