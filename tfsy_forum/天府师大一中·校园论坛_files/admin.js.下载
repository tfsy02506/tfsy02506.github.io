  /* ------------------------------------------------------ 8 消息推送 */
  function pushCount(target, role, username) {
    try {
      if (target === 'role') return TF.store.adminList({ type: 'user', role: role || 'student', status: 'active', size: 1 }).total;
      if (target === 'user') return username && TF.store.findUserByUsername(username) ? 1 : 0;
      return TF.store.adminList({ type: 'user', status: 'active', size: 1 }).total;
    } catch (e) { return 0; }
  }
  function updateEstimate(form) {
    if (!form) return;
    var est = form.querySelector('[data-push-est]');
    if (!est) return;
    var picked = form.querySelector('input[name="target"]:checked');
    var roleEl = form.querySelector('select[name="role"]');
    var userEl = form.querySelector('input[name="userId"]');
    est.textContent = String(pushCount(picked ? picked.value : 'all', roleEl ? roleEl.value : 'student', userEl ? userEl.value : ''));
  }
  function renderMessages(ctx) {
    var target = Q(ctx, 'target', 'all');
    if (['all', 'role', 'user'].indexOf(target) < 0) target = 'all';
    var role = Q(ctx, 'role', 'student');
    var users = TF.store.adminList({ type: 'user', size: 500 }).list;
    var est = pushCount(target, role, '');
    var radios = [
      { value: 'all', label: '全体', desc: '所有没被封的成员', icon: 'users' },
      { value: 'role', label: '按角色', desc: '只发学生或只发版主', icon: 'shield' },
      { value: 'user', label: '某个人', desc: '只发给一个账号', icon: 'user' }
    ].map(function (o) {
      var on = o.value === target;
      return '<label class="radiocard' + (on ? ' is-active' : '') + '"><input type="radio" name="target" value="' + AT(o.value) + '"' + (on ? ' checked' : '') + ' data-action-change="admin.push.target">' +
        '<span class="radiocard__icon">' + IC(o.icon, 16) + '</span><span><b>' + E(o.label) + '</b><i>' + E(o.desc) + '</i></span></label>';
    }).join('');
    var form = '<form class="form" data-action="admin.push.send">' +
      '<div class="radiocards">' + radios + '</div>' +
      '<div class="formgrid mt-3">' +
        '<div class="' + (target === 'role' ? '' : 'is-hidden') + '" data-push-role>' +
          TF.ui.selectField({ label: '发给', name: 'role', value: role, options: [{ value: 'student', label: '学生' }, { value: 'mod', label: '版主' }, { value: 'admin', label: '超管' }] }) +
        '</div>' +
        '<div class="' + (target === 'user' ? '' : 'is-hidden') + '" data-push-user>' +
          TF.ui.field({ label: '用户名', name: 'userId', placeholder: '填对方登录用的用户名', hint: '写错会发不出去' }) +
        '</div>' +
      '</div>' +
      '<div class="mt-3">' + TF.ui.field({ label: '标题', name: 'title', required: true, maxlength: 30, block: true, placeholder: '例如：周六运动会照常办' }) + '</div>' +
      TF.ui.textarea({ label: '内容', name: 'body', rows: 5, required: true, block: true, maxlength: 300, placeholder: '时间、地点、要带什么，说清楚' }) +
      '<div class="cluster mt-3"><span class="text-sm text-2">会发给 <b class="mono" data-push-est>' + est + '</b> 个人</span>' +
      '<span class="spacer"></span><button type="submit" class="btn btn--primary' + (isPhone() ? ' btn--block' : ' btn--sm') + '">' + IC('send', 13) + '<span>发出去</span></button>' +
      '<button type="reset" class="btn btn--ghost' + (isPhone() ? ' btn--block' : ' btn--sm') + '">清空</button></div></form>';
    var rec = TF.store.adminList({ type: 'message', status: 'system', page: 1, size: 10 });
    var recRows = (rec.list || []).map(function (m) {
      var u = TF.store.getUser(m.userId);
      return [
        td('<span class="text-xs text-muted">' + E(FMT(m.createdAt)) + '</span>'),
        td('<b>' + E(m.title) + '</b> <span class="text-xs text-muted">' + E(EXC(m.body, 36)) + '</span>'),
        td(userLink(u)),
        td(m.read ? TF.ui.badge('已读', 'success') : TF.ui.badge('没读', 'warn'))
      ];
    });
