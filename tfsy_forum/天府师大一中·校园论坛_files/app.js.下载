  /* ------------------------------------------------------- data-action 总线 */
  function readValues(scope) {
    var out = {};
    if (!scope) return out;
    var nodes = scope.querySelectorAll('input[name],select[name],textarea[name]');
    for (var i = 0; i < nodes.length; i++) {
      var n = nodes[i];
      var name = n.getAttribute('name');
      if (!name) continue;
      if (n.type === 'checkbox') {
        if (n.checked) out[name] = n.value || true;
        else if (!(name in out)) out[name] = '';
      } else if (n.type === 'radio') {
        if (n.checked) out[name] = n.value;
      } else if (n.tagName === 'SELECT' && n.multiple) {
        out[name] = Array.prototype.filter.call(n.options, function (o) { return o.selected; }).map(function (o) { return o.value; });
      } else {
        out[name] = n.value;
      }
    }
    return out;
  }
  function dispatch(action, el, event) {
    var handlers = actions[action];
    var form = el.closest ? el.closest('form') : null;
    var param = {};
    var raw = el.getAttribute && el.getAttribute('data-param');
    if (raw) { try { param = JSON.parse(raw) || {}; } catch (e) { param = {}; } }
    var ctx = {
      action: action,
      el: el,
      event: event,
      param: param,
      data: el.dataset || {},
      form: form,
      values: function (scope) { return readValues(scope || form || el); },
      route: TF.route
    };
    if (!handlers || !handlers.length) {
      try { console.warn('[TF] 未注册的 data-action：' + action, el); } catch (e) {}
      return;
    }    for (var i = 0; i < handlers.length; i++) {
      try { handlers[i](ctx); }
      catch (e) { catchLog(action, e); }
    }
  }
  function bindGlobal() {
    document.addEventListener('click', function (ev) {
      var t = ev.target;
      if (!t || !t.closest) return;
      /* **关键修复（用户实测反馈的那条 bug）**：
         表单的 data-action 只能在"提交"时触发，不能在点击时触发。
         以前这里用 closest('[data-action]')，点到输入框时会命中外层的
         <form data-action="settings.profile">，于是"点一下输入框 = 点了一次提交" ——
         用户看到的就是"一选中输入框就自动保存 / 自动发送"。
         现在：点击只认**元素自己**的 data-action（按钮、链接等）；表单提交走 submit 事件。 */
      var el = t.closest('[data-action]');
      if (el && el.tagName === 'FORM') el = null;
      if (!el) {
        var inFormCtrl = /^(INPUT|TEXTAREA|SELECT|LABEL|OPTION)$/.test(t.tagName);
        if (inFormCtrl && t.closest('form[data-action]')) return;   /* 表单控件交给 submit/focus 处理 */
        var m = t.closest('[data-menu]');
        document.querySelectorAll('.usermenu.is-open').forEach(function (n) {
          if (!m || n !== m) n.classList.remove('is-open');
        });
        return;
      }
      var action = el.getAttribute('data-action');
      var tag = el.tagName;
      if (tag === 'A' && el.getAttribute('href') && el.getAttribute('href').charAt(0) === '#') { /* 路由跳转交给浏览器 */ }
      else if (tag === 'A' && !el.getAttribute('href')) ev.preventDefault();
      if (tag === 'BUTTON' && !el.getAttribute('type') && el.closest('form')) el.setAttribute('type', 'button');
      dispatch(action, el, ev);
    }, false);

    /* 文件输入框的点击在捕获阶段掐掉：只让它打开文件选择器，
       绝不允许它冒泡或触发"表单隐式提交"。
       背景：点表单里的 <label for>（关联隐藏 file 输入框）或 <input type=file> 时，
       浏览器会触发**隐式提交**，用户看到的是"点选图片，帖子/资料就被提交了"。 */
    document.addEventListener('click', function (ev) {
      var el = ev.target;
      if (el && el.tagName === 'INPUT' && el.type === 'file') ev.stopPropagation();
    }, true);

    /* 提交处理：只认「用户真的点了提交按钮」和「脚本派发的合成 submit」。
       隐式提交（点 label / radio / checkbox / file 输入框）一律忽略并阻止 —— 见下面判定。
       另外做防重：一次点击只处理一次（曾经"点一次发布发出两篇帖子"）。 */
    var lastHandledSubmitAt = 0;

    document.addEventListener('submit', function (ev) {
      var form = ev.target;
      if (!form || !form.getAttribute) return;
      var action = form.getAttribute('data-action');
      if (!action) return;
      /* 一律不让浏览器真的提交（避免页面跳走），是否处理看下面的判定 */
      ev.preventDefault();
      var sub = ev.submitter || null;
      var viaButton = !!(sub && sub.tagName === 'BUTTON' && String(sub.getAttribute('type') || 'submit') === 'submit');
      /* 脚本派发的合成事件（isTrusted=false）也算用户意图：
         既方便自动化测试，也兼容浏览器扩展/自动化工具。 */
      var synthetic = (ev.isTrusted === false);
      /* 隐式提交（点 label / radio / checkbox / file 输入框）特征是：
         事件可信、没有 submitter、且没有点过提交按钮 —— 这类一律忽略。 */
      if (!viaButton && !synthetic) return;
      /* 防止一次点击被处理两遍（曾经"点一次发布发出两篇"） */
      var now = Date.now();
      if (now - lastHandledSubmitAt < 600 && !synthetic) return;
      lastHandledSubmitAt = now;
      dispatch(action, form, ev);
    }, false);

    document.addEventListener('change', function (ev) {
      var el = ev.target;
      if (!el || !el.getAttribute) return;
      if (el.getAttribute('data-action-change')) dispatch(el.getAttribute('data-action-change'), el, ev);
      if (el.getAttribute('data-autosubmit') && el.form) {
        try { el.form.dispatchEvent(new Event('submit', { cancelable: true, bubbles: true })); } catch (e) {}
      }
    }, false);

    document.addEventListener('keydown', function (ev) {
      if (ev.key === 'Escape') {
        document.querySelectorAll('.usermenu.is-open').forEach(function (n) { n.classList.remove('is-open'); });
      }
      if (ev.key === '/' && !/input|textarea|select/i.test((ev.target && ev.target.tagName) || '') && !ev.ctrlKey && !ev.metaKey) {
        var s = document.querySelector('.searchbar__input');
        if (s) { ev.preventDefault(); s.focus(); }
      }
    }, false);

    window.addEventListener('hashchange', render, false);
    document.addEventListener('hashchange', render, false);

    /* 回车守卫（冒泡阶段：让输入框自己的 keydown 先跑，它处理过就不重复拦）：
       单行输入框里按回车，浏览器会触发**隐式表单提交** —— 用户看到的就是
       "在某一行打完字一回车，资料/帖子就被提交了"。这里拦掉，改成失焦。
       例外：输入框自己处理了回车（例如"回车加标签"）会 preventDefault，这里就不插手。 */
    document.addEventListener('keydown', function (ev) {
      if (ev.key !== 'Enter' || ev.defaultPrevented || ev.isComposing) return;
      var el = ev.target;
      if (!el || el.tagName !== 'INPUT') return;
      var type = String(el.type || 'text').toLowerCase();
      if (type === 'file' || type === 'checkbox' || type === 'radio' || type === 'submit' || type === 'button') return;
      var form = el.closest ? el.closest('form[data-action]') : null;
      if (!form) return;
      ev.preventDefault();
      try { el.blur(); } catch (e) { /* 忽略 */ }
    }, false);
  }

