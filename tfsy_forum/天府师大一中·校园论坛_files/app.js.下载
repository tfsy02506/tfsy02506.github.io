  /* ----------------------------------------------------------------- 引导 */
  /* 调试/验收钩子（只在带查询串时生效，用完立即从地址栏擦除）：
   *   index.html?theme=dark     预设主题（light|dark|auto），用于截图与暗色验收
   * 注意：不再有 ?as=xxx 自动登录演示账号（演示账号已删除，登录必须走真实接口）。 */
  function applyBootQuery() {
    var q = location.search || '';
    if (!q || q === '?') return;
    var p = {};
    q.replace(/^\?/, '').split('&').forEach(function (kv) {
      if (!kv) return;
      var i = kv.indexOf('=');
      p[decodeURIComponent(i < 0 ? kv : kv.slice(0, i))] = i < 0 ? '' : decodeURIComponent(kv.slice(i + 1));
    });
    if (p.theme && TF.ui && TF.ui.theme && TF.ui.theme.set) {
      try { TF.ui.theme.set(p.theme); } catch (e) {}
    }
    try {
      if (history.replaceState) history.replaceState(null, '', location.pathname + (location.hash || '#/home'));
    } catch (e) {}
  }

  /* 服务器不可用时的提示条：宁可见地说出来，也不要白屏或静默空站 */
  function offlineBanner() {
    if (TF.api && TF.api.online) return;
    var host = document.getElementById('page-host');
    var box = document.createElement('div');
    box.className = 'noticebar noticebar--warn';
    box.setAttribute('data-offline', '1');
    box.innerHTML = '<b>连不上服务器</b>　页面显示的是缓存结构，发帖、登录等操作暂时用不了。' +
      '如果你是管理员：确认后端已经在跑（<code>node server/index.mjs</code>）再刷新。';
    var target = host || document.getElementById('app');
    if (target && target.parentNode) target.parentNode.insertBefore(box, target);
  }

  /* 关键：TF.app 在上方已挂载，因此 pages-*.js / admin.js 即使在 app.js 之后装载，
   * 也能在模块顶层安全调用 TF.app.on / TF.app.register（契约 §9）。
   * 启动流程（SERVER-CONTRACT §5）：主题 → 等 TF.api.ready（拿服务器快照）→ 灌进 store
   * → 渲染。服务器连不上也照常渲染（离线态），只是不能写。 */
  /* ============================================================ 诊断开关
   * 用法：在地址后面加 ?debug=form（设置页底部也有一个「打开诊断模式」的链接）
   * 打开后会做三件事：
   *   1) 左上角显示一个红条，写着当前前端文件的版本号（用来确认浏览器有没有在跑旧代码）
   *   2) 把每一次 click / focus / change / submit / 每个接口请求都打到控制台（F12 → Console）
   *   3) 提供 window.tfDebug.dump() 复制全部记录、window.tfDebug.version() 看版本
   * 排查完把 ?debug=form 去掉即可（不影响正常使用）。 */
  function startDiagnostics() {
    var q = String(location.search || '') + String(location.hash || '');
    if (!/[?&]debug=/.test(q)) return;
    if (window.tfDebug && window.tfDebug.__on) return;   /* 只装一次 */
    var logs = [];
    function stamp() { var d = new Date(); return d.toTimeString().slice(0, 8) + '.' + String(d.getMilliseconds()).padStart(3, '0'); }
    function rec(kind, text) {
      var line = stamp() + '  [' + kind + '] ' + text;
      logs.push(line);
      /* 只有在诊断模式下才输出到控制台（正常使用不会刷控制台） */
      try { if (window.console) console.debug('[tf] ' + line); } catch (e) {}
    }
    function attrOf(el, name) { try { return el.getAttribute ? (el.getAttribute(name) || '') : ''; } catch (e) { return ''; } }
    function desc(el) {
      if (!el || !el.tagName) return String(el);
      var s = el.tagName;
      if (el.id) s += '#' + el.id;
      var act = attrOf(el, 'data-action');
      if (act) s += '[action=' + act + ']';
      var nm = attrOf(el, 'name');
      if (nm) s += '[name=' + nm + ']';
      var tp = attrOf(el, 'type');
      if (tp) s += '[type=' + tp + ']';
      if (el.className && typeof el.className === 'string' && el.className.trim()) s += '.' + el.className.trim().split(/\s+/).slice(0, 2).join('.');
      return s;
    }
    ['click', 'focusin', 'change', 'input', 'submit', 'keydown'].forEach(function (type) {
      document.addEventListener(type, function (ev) {
        if (type === 'keydown' && ev.key !== 'Enter') return;
        if (type === 'input' && logs.length > 400) return;
        var extra = '';
        if (type === 'submit') {
          var f = ev.target || {};
          extra = ' formAction=' + attrOf(f, 'data-action') +
            ' submitter=' + (ev.submitter ? desc(ev.submitter) : '无') + ' isTrusted=' + ev.isTrusted;
        }
        rec(type, desc(ev.target) + extra);
      }, true);
    });
    /* 记所有接口请求（谁在什么时候打了服务器） */
    if (window.XMLHttpRequest && XMLHttpRequest.prototype.open) {
      var xo = XMLHttpRequest.prototype.open;
      XMLHttpRequest.prototype.open = function (m, u) {
        rec('API', m + ' ' + String(u).replace(location.origin, ''));
        return xo.apply(this, arguments);
      };
      var xs = XMLHttpRequest.prototype.send;
      XMLHttpRequest.prototype.send = function () {
        var st = this;
        this.addEventListener('loadend', function () { rec('API返回', st.status + ' ' + String(st.responseURL || '').replace(location.origin, '')); });
        return xs.apply(this, arguments);
      };
    }
    if (window.fetch) {
      var of = window.fetch;
      window.fetch = function (input, init) {
        var u = typeof input === 'string' ? input : (input && input.url) || '';
        var m = (init && init.method) || (input && input.method) || 'GET';
        if (/\/api\//.test(u)) rec('API', m + ' ' + String(u).replace(location.origin, ''));
        return of.apply(this, arguments);
      };
    }

    var meta = document.querySelector('meta[name="tf-build"]');
    var build = meta ? meta.getAttribute('content') : '(未注入)';
    var bar = document.createElement('div');
    bar.setAttribute('data-debug-bar', '1');
    bar.style.cssText = 'position:fixed;left:0;top:0;right:0;z-index:9999;background:#c0392b;color:#fff;' +
      'font:12px/1.6 ui-monospace,Consolas,monospace;padding:4px 10px;white-space:pre-wrap';
    bar.textContent = '诊断模式已开（前端 build ' + build + '）· 点一下输入框，然后把 Console 里 [submit]/[API] 的行发我 · ' +
      'window.tfDebug.dump() 复制全部 · 去掉地址里的 ?debug=form 关闭';
    document.body.appendChild(bar);
    document.body.style.paddingTop = '30px';

    window.tfDebug = {
      __on: true,
      version: function () { return build; },
      logs: function () { return logs.slice(); },
      dump: function () {
        var text = 'build=' + build + '\n' + logs.join('\n');
        try { console.log(text); } catch (e) {}
        try { if (navigator.clipboard) navigator.clipboard.writeText(text); } catch (e) {}
        return text;
      },
      clear: function () { logs.length = 0; return '已清空'; }
    };
    rec('诊断', 'build=' + build + ' ua=' + navigator.userAgent.slice(0, 80));
  }

  function boot() {
    var t = ui.theme();
    if (t && t.init) { try { t.init(); } catch (e) {} }
    bindGlobal();
    applyBootQuery();
    startDiagnostics();

    var start = function () {
      try { store.init(); } catch (e) { catchLog('store.init', e); }
      TF.app.data.settings = store.getSettings() || {};
      TF.app.data.boards = store.listBoards();
      TF.app.data.notices = store.listNotices(6);
      TF.app.data.unread = store.unreadCount();
      refreshData();
      /* 自检：后台动作没接上时给出可见提示（避免“点了没反应”的静默失败） */
      try {
        if (!actions['admin.filter'] && routes.length) {
          console.warn('[TF] 管理后台动作未注册：admin.js 可能加载失败');
        }
      } catch (e) {}
      if (!location.hash || location.hash === '#' || location.hash === '#/') location.hash = '#/home';
      render();
      offlineBanner();
      document.documentElement.classList.add('booted');
    };

    var ready = TF.api && TF.api.ready;
    if (ready && typeof ready.then === 'function') {
      ui.loading(true, '正在连接服务器…');
      ready.then(function () { ui.loading(false); start(); })
        .catch(function (e) { ui.loading(false); catchLog('api.ready', e); start(); });
    } else {
      /* 没有 api-client（例如被单独打开的老版本文件）：仍然以离线态渲染，不要白屏 */
      start();
    }
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot, false);
  else boot();
})();
