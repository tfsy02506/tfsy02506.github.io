  /* ------------------------------------------------------------------ 渲染 */
  var current = { path: '', render: null, ctx: null, host: null, cleanup: null };
  function resolve(path) {
    for (var i = 0; i < routes.length; i++) {
      var m = match(routes[i].pattern, path);
      if (m) return { route: routes[i], params: m.params };
    }
    /* 未命中任何路由 → 回落到页面模块注册的 404 页（契约 §7：404 由 pages-core 提供）。
     * 这样「刷新/分享一个坏链接」也能看到设计好的 404，而不是内置兜底。 */
    if (path !== '/404') {
      for (var j = 0; j < routes.length; j++) {
        if (routes[j].pattern === '/404') return { route: routes[j], params: { rest: path } };
      }
    }
    return null;
  }
  /* 需要登录才能访问的路由（框架级兜底，不依赖页面模块是否声明 meta.auth）。
   * '/new' 覆盖发帖，'/edit' 覆盖 /edit/:id，两者都必须登录。 */
  var AUTH_PATHS = ['/me', '/messages', '/settings', '/new', '/edit'];
  function needAuth(path) {
    for (var i = 0; i < AUTH_PATHS.length; i++) {
      var p = AUTH_PATHS[i];
      if (path === p || path.indexOf(p + '/') === 0) return true;
    }
    return false;
  }
  /* 学生认证（新增）：校外人员只能用娱乐中心；首页/认证页/自己的资料页是允许的 */
  var VERIFY_ALLOWED_PATHS = ['/home', '/verify', '/games', '/login', '/register', '/forgot', '/me', '/settings'];
  function needVerify(path) {
    for (var i = 0; i < VERIFY_ALLOWED_PATHS.length; i++) {
      var p = VERIFY_ALLOWED_PATHS[i];
      if (path === p || (p !== '/home' && path.indexOf(p + '/') === 0)) return false;
    }
    return true;
  }
  /* 守卫判定（纯逻辑，便于单测与自查）：
   * 返回 {allow:boolean, redirect:string, reason:'guest-admin'|'not-admin'|'guest-auth'|'need-verify'|''}
   * verified 传 false 表示「校外人员」；前端跳转只是体验，服务端还有同样的强制闸门。 */
  function guardPlan(routePath, user, isAdminUser, verified) {
    var isAdminArea = routePath === '/admin' || routePath.indexOf('/admin/') === 0;
    /* 后台区（R5）：需要版主或超级管理员 */
    var backstageOk = !!user && (user.role === 'admin' || user.role === 'mod');
    if (isAdminArea && !backstageOk) {
      if (!user) return { allow: false, redirect: '/login', reason: 'guest-admin' };
      return { allow: false, redirect: '/home', reason: 'not-admin' };
    }
    /* 后台里仅超级管理员可用的分区（R5） */
    if (isAdminArea && user && user.role !== 'admin') {
      var SUPER_ONLY = ['users', 'boards', 'messages', 'settings', 'logs', 'verify'];
      var sec = (routePath.split('/')[2] || 'dashboard').toLowerCase();
      if (SUPER_ONLY.indexOf(sec) >= 0) return { allow: false, redirect: '/admin/dashboard', reason: 'not-super' };
    }
    if (needAuth(routePath) && !user) return { allow: false, redirect: '/login', reason: 'guest-auth' };
    /* 校外人员：看帖/发帖/评论/消息/搜索/别人主页都要先认证 */
    if (user && verified === false && !isAdminArea && needVerify(routePath)) {
      return { allow: false, redirect: '/verify', reason: 'need-verify' };
    }
    return { allow: true, redirect: '', reason: '' };
  }
  function guard(routePath, ctx) {
    return true;
  }
  function render() {
    try { startDiagnostics(); } catch (e) { /* 诊断失败不影响页面 */ }
    var parsed = parseHash();
    var hit = resolve(parsed.path);
    var app = document.getElementById('app');
    if (!app) return;
    var settings = store.getSettings() || {};
    var user = store.currentUser();

    if (!hit) {
      // 未注册路由：交给兜底（pages-core 的 404），否则显示内置 404
      var fallback = resolve('/404');
      if (fallback) hit = fallback;
      else {
        app.innerHTML = headerHTML({ path: parsed.path, query: parsed.query, params: {} }, user, settings) +
          '<main class="main"><div class="container"><div class="page" data-page="404">' +
          TF.ui.empty({ icon: 'alert', title: '页面不存在', desc: '地址 ' + parsed.path + ' 没有对应的页面', action: '<a class="btn btn--primary" href="#/home">返回首页</a>' }) +
          '</div></div></main>' + footerHTML(settings, null);
        return;
      }
    }
    var meta = hit.route.meta || {};
    TF.route = { param: hit.params || {}, query: parsed.query, path: parsed.path, meta: meta };
    var ctx = { path: parsed.path, query: parsed.query, params: hit.params || {}, meta: meta, route: hit.route.pattern };
    if (!guard(parsed.path, ctx)) return;

    ui.loading(true);
    var out;
    try {
      out = hit.route.render(ctx);
    } catch (err) {
      ui.loading(false);
      renderCrash(err, ctx);
      return;
    }
    if (out && typeof out.then === 'function') {
      out.then(function (v) { paint(v, ctx, hit, settings, user, app); })
        .catch(function (e) { ui.loading(false); renderCrash(e, ctx); });
      return;
    }
    paint(out, ctx, hit, settings, user, app);
  }
  function paint(out, ctx, hit, settings, user, app) {
    ui.loading(false);
    if (typeof out === 'string') out = { html: out };
    if (!out) out = { html: '' };
    /* 释放上一页的 onMount 清理函数（定时器/全局监听器），避免切换页面后泄漏 */
    if (current && typeof current.cleanup === 'function') {
      try { current.cleanup(); } catch (e) { catchLog('cleanup', e); }
    }
    current.path = ctx.path;
    current.ctx = ctx;
    current.cleanup = null;
    var isAdminArea = ctx.path === '/admin' || ctx.path.indexOf('/admin/') === 0;
    var isAuthArea = ctx.path === '/login' || ctx.path === '/register' || ctx.path === '/forgot';
    if (isAdminArea) app.innerHTML = adminShellHTML({ params: ctx.params || {}, path: ctx.path }, user, settings);
    else if (isAuthArea) { app.classList.add('app--auth'); app.innerHTML = authShellHTML(user, settings); }
    else { app.classList.remove('app--auth'); app.innerHTML = appShellHTML({ path: ctx.path, query: ctx.query, params: ctx.params }, user, settings, TF.app.data.stats); }
    var host = document.getElementById('page-host');
    if (host) host.innerHTML = out.html || '';
    current.path = ctx.path;
    current.ctx = ctx;
    current.host = host;
    document.body.classList.remove('nav-open');
    if (out.title) document.title = out.title + ' · ' + (settings.siteName || '天府师大一中·校园论坛');
    else document.title = (settings.siteName || '天府师大一中·校园论坛');
    if (host) {
      ui.init(host);
      ui.init(document.getElementById('app'));
      if (typeof out.onMount === 'function') {
        /* onMount 可以返回一个清理函数：下次渲染前会被调用（定时器/监听器请在此释放），
         * 例如轮播：onMount: function (root) { var t = setInterval(...); return function () { clearInterval(t); }; } */
        try {
          var ret = out.onMount(host, ctx);
          if (typeof ret === 'function') current.cleanup = ret;
          else if (ret && typeof ret.dispose === 'function') current.cleanup = function () { ret.dispose(); };
        } catch (e) { catchLog('onMount', e); }
      }
      var f = host.querySelector('input:not([type=hidden]),textarea');
      if (f && ctx.meta && ctx.meta.focus) try { f.focus(); } catch (e) {}
    }
    if (!(ctx.meta && ctx.meta.keepScroll)) window.scrollTo(0, 0);
  }
  function renderCrash(err, ctx) {
    try { console.error('[TF] 页面渲染失败', ctx && ctx.path, err); } catch (e) {}
    var app = document.getElementById('app');
    if (!app) return;
    if (app.querySelector('.crash')) return;
    var box = document.createElement('div');
    box.className = 'page crash';
    box.setAttribute('data-page', 'error');
    box.innerHTML = '<div class="container"><div class="card card--pad" style="margin:48px auto;max-width:620px;text-align:center">' +
      '<div class="empty__icon">' + TF.ui.icon('alert', 34) + '</div>' +
      '<h2>这个页面出了点问题</h2>' +
      '<p class="text-2 muted">错误信息：' + TF.util.esc(err && err.message ? err.message : String(err)) + '</p>' +
      '<p class="text-muted text-sm">可以先返回首页，或刷新页面重试。你的帖子都存在服务器上，不会丢。</p>' +
      '<div class="cluster center"><button class="btn btn--primary" data-action="app.home">返回首页</button>' +
      '<button class="btn btn--outline" data-action="app.reload">刷新页面</button></div></div></div>';
    var main = app.querySelector('.main');
    if (main) main.innerHTML = '' , main.appendChild(box);
    else app.appendChild(box);
  }
  function catchLog(where, e) {
    try { console.error('[TF] 挂载失败 @' + where, e); } catch (x) {}
    ui.toast('部分交互初始化失败：' + (e && e.message ? e.message : e), 'warn');
  }

  function refresh() { render(); }
  function refreshUser() {
    var app = document.getElementById('app');
    if (!app) return;
