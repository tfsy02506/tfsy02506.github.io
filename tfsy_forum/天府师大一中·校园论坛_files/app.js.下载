          '</button>' +
          '<div class="usermenu__panel">' +
            '<div class="usermenu__head">' + TF.ui.avatar(user, 44) +
              '<div><b>' + TF.util.esc(user.nickname || user.username) + '</b> ' + roleBadge(user) + ' ' + statusBadge +
              '<div class="text-xs text-muted">' + TF.util.esc(user.grade || '') + ' ' + TF.util.esc(user.klass || '') + ' · ' + TF.util.num(user.points || 0) + ' 积分</div></div>' +
            '</div>' +
            (verified
              ? '<a class="usermenu__item" href="#/me">' + TF.ui.icon('user', 15) + '<span>我的主页</span></a>' +
                '<a class="usermenu__item" href="#/new">' + TF.ui.icon('edit', 15) + '<span>发新帖</span></a>' +
                '<a class="usermenu__item" href="#/messages">' + TF.ui.icon('mail', 15) + '<span>消息中心</span>' +
                  (unread > 0 ? '<span class="badge badge--danger">' + unread + '</span>' : '') + '</a>'
              : '<a class="usermenu__item" href="#/verify">' + TF.ui.icon('shield', 15) +
                '<span>学生认证' + (store.studentStatus() === 'pending' ? '（审核中）' : '') + '</span></a>') +
            '<a class="usermenu__item" href="#/settings">' + TF.ui.icon('settings', 15) + '<span>账号设置</span></a>' +
            (store.isAdmin() || store.isMod() ? '<a class="usermenu__item" href="#/admin">' + TF.ui.icon('shield', 15) + '<span>' + (store.isAdmin() ? '管理后台' : '内容管理') + '</span></a>' : '') +
            (boardLinks ? '<div class="usermenu__sep"></div><div class="usermenu__label">我的版块</div>' + boardLinks : '') +
            '<div class="usermenu__sep"></div>' +
            '<button class="usermenu__item" data-action="auth.logout">' + TF.ui.icon('logout', 15) + '<span>退出登录</span></button>' +
          '</div>' +
        '</div>';
    } else {
      right =
        '<button class="iconbtn" data-action="theme.toggle" title="切换主题" aria-label="切换主题">' + TF.ui.icon('moon', 18) + '</button>' +
        '<a class="btn btn--ghost btn--sm" href="#/login">登录</a>' +
        '<a class="btn btn--primary btn--sm" href="#/register">免费注册</a>';
    }
    return '' +
      '<header class="header">' +
        '<div class="header__inner container">' +
          '<a class="brand" href="#/home">' +
            '<span class="brand__logo" aria-hidden="true">' + logoHTML(28) + '</span>' +
            '<span class="brand__name">' + TF.util.esc(settings.siteName || '天府师大一中·校园论坛') + '</span>' +
          '</a>' +
          '<form class="searchbar" data-action="shell.search" role="search">' +
            '<span class="searchbar__icon">' + TF.ui.icon('search', 16) + '</span>' +
            '<input class="searchbar__input" name="q" type="search" placeholder="搜索帖子、同学、版块…" value="' + TF.util.attr(route.query.q || '') + '" aria-label="站内搜索">' +
            '<kbd class="kbd">Enter</kbd>' +
          '</form>' +
          '<nav class="nav">' + nav + '</nav>' +
          '<div class="header__right">' +
            /* 手机上：搜索收成图标（点进 /search 页），其余入口交给底部 Tab 栏 */
            '<a class="iconbtn iconbtn--search" href="#/search" aria-label="搜索">' + TF.ui.icon('search', 20) + '</a>' +
            '<button class="iconbtn navToggle" data-action="shell.navToggle" aria-label="菜单">' + TF.ui.icon('menu', 20) + '</button>' +
            right +
          '</div>' +
        '</div>' +
        '<div class="header__mobile">' + nav + '</div>' +
      '</header>' +
      mobileTabbarHTML(route, user, unread);
  }

  /* ------------------------------------------------------- 手机底部 Tab 栏
   * 只在 ≤620px 显示（桌面 CSS 里 display:none）。
   * 5 个位置：首页 / 论坛 / 发帖(中间凸起) / 娱乐 / 我的。未登录时最后一个换成"登录"。
   * 「消息」不放这里（图标和「我的」容易混），改由顶栏铃铛进入（带未读小红点），
   * 这样底部能腾出一格给「娱乐」。
   * 这是手机上最主要的导航方式，解决"顶栏折两行、入口点不到"的问题。 */
  function mobileTabbarHTML(route, user, unread) {
    var p = route.path || '/home';
    var is = function (a) { return p === a || (a !== '/home' && p.indexOf(a) === 0); };
    var item = function (href, icon, label, active, badge) {
      return '<a class="tabbar__item' + (active ? ' is-active' : '') + '" href="' + href + '"' +
        (active ? ' aria-current="page"' : '') + '>' +
        '<span class="tabbar__icon">' + TF.ui.icon(icon, 22) +
          (badge ? '<i class="tabbar__badge">' + (badge > 99 ? '99+' : badge) + '</i>' : '') +
        '</span><span class="tabbar__label">' + label + '</span></a>';
    };
    /* 校外访客（未认证）：底部只留 首页 / 娱乐 / 学生认证 / 我的。
       发帖、论坛、消息这些先不给入口，点了也会被守卫送到认证页。 */
    if (user && !store.isVerified()) {
      return '' +
        '<nav class="tabbar" aria-label="主导航">' +
          item('#/home', 'home', '首页', p === '/home') +
          item('#/games', 'sparkle', '娱乐', is('/games')) +
          item('#/verify', 'shield', '认证', is('/verify')) +
          item('#/me', 'user', '我的', is('/me') || is('/settings')) +
        '</nav>';
    }
    return '' +
      '<nav class="tabbar" aria-label="主导航">' +
        item('#/home', 'home', '首页', p === '/home') +
        item('#/forum', 'forum', '论坛', is('/forum') || is('/board') || is('/post')) +
        '<a class="tabbar__fab" href="' + (user ? '#/new' : '#/login') + '" aria-label="发帖">' +
          TF.ui.icon('plus', 24) + '</a>' +
        item('#/games', 'sparkle', '娱乐', is('/games')) +
        (user
          ? item('#/me', 'user', '我的', is('/me') || is('/u/') || is('/settings'))
          : item('#/login', 'user', '登录', is('/login'))) +
      '</nav>';
  }
