    ].filter(function (n) { return n.group || !n.superOnly || isSuper; });
    var current = route.params.section || 'dashboard';
    var links = '';
    var pendingGroup = '';
    var pendingGroupHasItem = false;
    var flushGroup = function () {
      if (pendingGroupHasItem) links += '<div class="sidebar__group">' + pendingGroup + '</div>';
      pendingGroup = '';
      pendingGroupHasItem = false;
    };
    nav.forEach(function (n) {
      if (n.group) { flushGroup(); pendingGroup = n.group; return; }
      pendingGroupHasItem = true;
      var active = current === n.key;
      links += '<a class="sidebar__link' + (active ? ' is-active' : '') + '" href="#/admin/' + n.key + '">' +
        TF.ui.icon(n.icon, 17) + '<span>' + n.label + '</span></a>';
    });
    flushGroup();
    return '' +
      '<div class="app__adminwrap">' +
        '<aside class="sidebar" id="sidebar">' +
          '<a class="sidebar__brand" href="#/home">' +
