    }).join('');
    var nav = effNav.map(function (n) {
      var active = route.path === n.path || (n.path === '/notices' && route.path.indexOf('/notice') === 0) ||
        (n.path === '/verify' && route.path.indexOf('/verify') === 0);
      return '<a class="nav__item' + (active ? ' is-active' : '') + '" href="#' + n.path + '">' +
        TF.ui.icon(n.icon, 16) + '<span>' + n.label + '</span></a>';
    }).join('');
    var unread = user ? store.unreadCount() : 0;
    var statusBadge = !user ? '' : (verified ? '' : '<span class="badge badge--warn" title="完成学生认证后解锁论坛">校外访客</span>');
    var right;
    if (user) {
      right =
        (verified ? '<a class="iconbtn" href="#/new" title="发帖" aria-label="发帖">' + TF.ui.icon('plus', 18) + '</a>' : '') +
        (verified ? '<a class="iconbtn" href="#/messages" title="消息" aria-label="消息">' + TF.ui.icon('bell', 18) +
          (unread > 0 ? '<i class="iconbtn__dot"></i>' : '') + '</a>' : '') +
        '<a class="iconbtn" href="#/settings" title="设置" aria-label="设置">' + TF.ui.icon('settings', 18) + '</a>' +
        (store.isAdmin() ? '<a class="btn btn--primary btn--sm" href="#/admin">' + TF.ui.icon('shield', 16) + '<span>管理后台</span></a>' : '') +
