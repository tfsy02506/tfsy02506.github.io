/* 天府师大一中·校园论坛 — 应用外壳 / 路由 / 守卫 / data-action 事件总线
 * 装载顺序（CONTRACT §1 修订 R3）：util → store → seed → design → **app** → pages-core → pages-forum → admin
 * 本文件在顶部即创建 TF.app，因此页面模块可在模块顶层安全调用 TF.app.on / TF.app.register；
 * 真正的启动（boot）在 DOMContentLoaded 执行。
 * 本文件由 Lead 维护。页面模块通过 TF.app.register / TF.app.on / TF.app.go 使用。
 */
(function () {
  'use strict';

  var TF = (window.TF = window.TF || {});
  TF.extend = TF.extend || function (n, o) { TF[n] = Object.assign(TF[n] || {}, o); return TF[n]; };
  TF.route = TF.route || { param: {}, query: {}, path: '' };

  /* ------------------------------------------------------------------ 小工具 */
  function guarded(name, fn) {
    return function () {
      var m = TF[name];
      if (!m) return undefined;
      try { return fn.apply(null, arguments); } catch (e) { return undefined; }
    };
  }
  var store = {
    init: guarded('store', function () { return TF.store.init(); }),
    currentUser: guarded('store', function () { return TF.store.currentUser(); }),
    isLogin: guarded('store', function () { return !!(TF.store.currentUser && TF.store.currentUser()); }),
    isAdmin: guarded('store', function () { return !!(TF.store.isAdmin && TF.store.isAdmin()); }),
    isMod: guarded('store', function () { return !!(TF.store.isMod && TF.store.isMod()); }),
    /* 学生认证：external 校外人员 / pending 审核中 / student 已认证 / rejected 被驳回。
       兼容旧版 store.js（没有 isVerified 方法）：**按已认证处理**，绝不把老用户误锁在门外。
       真正的拦截在服务端（403 needStudentVerify），前端只是体验。 */
    isVerified: function () {
      if (!TF.store || typeof TF.store.isVerified !== 'function') return true;
      return !!TF.store.isVerified();
    },
    studentStatus: function () {
      if (!TF.store || typeof TF.store.studentStatus !== 'function') return 'student';
      return TF.store.studentStatus() || 'student';
    },
    canManage: guarded('store', function () { return !!(TF.store.canManage && TF.store.canManage()); }),
    unreadCount: guarded('store', function () { return TF.store.unreadCount() || 0; }),
    listBoards: guarded('store', function () { return TF.store.listBoards() || []; }),
    listNotices: guarded('store', function () { return TF.store.listNotices(5) || []; }),
    getSettings: guarded('store', function () { return TF.store.getSettings() || {}; }),
    logout: guarded('store', function () { return TF.store.logout(); }),
    log: guarded('store', function (a, t, d) { return TF.store.log(a, t, d); })
  };
  var ui = {
    icon: function (n, s, c) { return TF.ui && TF.ui.icon ? TF.ui.icon(n, s, c) : ''; },
    toast: function (m, t, ms) {
      if (TF.ui && TF.ui.toast) return TF.ui.toast(m, t, ms);
    },
    init: function (root) { if (TF.ui && TF.ui.init) try { TF.ui.init(root); } catch (e) {} },
    modal: function () { return TF.ui && TF.ui.modal ? TF.ui.modal : null; },
    theme: function () { return TF.ui && TF.ui.theme ? TF.ui.theme : null; },
    loading: function (on, text) { if (TF.ui && TF.ui.loading) try { TF.ui.loading(on, text); } catch (e) {} }
  };

  function go(path, query) {
    path = String(path || '/home');
    if (path.charAt(0) !== '/') path = '/' + path;
    var qs = serializeQuery(query);
    location.hash = '#' + path + (qs ? '?' + qs : '');
  }
  function goBack() {
    if ((window.history && history.length) > 1) history.back();
    else go('/home');
  }
  function serializeQuery(obj) {
    if (!obj) return '';
    var parts = [];
    Object.keys(obj).forEach(function (k) {
      var v = obj[k];
      if (v === undefined || v === null || v === '') return;
      parts.push(encodeURIComponent(k) + '=' + encodeURIComponent(v));
    });
    return parts.join('&');
  }
  function parseHash() {
    var raw = String(location.hash || '').replace(/^#/, '');
    var qIdx = raw.indexOf('?');
    var path = qIdx >= 0 ? raw.slice(0, qIdx) : raw;
    var query = {};
    if (qIdx >= 0) {
      raw.slice(qIdx + 1).split('&').forEach(function (kv) {
        if (!kv) return;
        var i = kv.indexOf('=');
        var k = i < 0 ? kv : kv.slice(0, i);
        var v = i < 0 ? '' : kv.slice(i + 1);
        try { query[decodeURIComponent(k)] = decodeURIComponent(v.replace(/\+/g, ' ')); }
        catch (e) { query[k] = v; }
      });
    }
    path = path.replace(/\/+$/, '') || '/home';
    return { path: path, query: query };
  }
  function match(pattern, path) {
    var p = pattern.split('/').filter(Boolean);
    var s = path.split('/').filter(Boolean);
    if (p.length > s.length) return null;
    for (var i = 0; i < p.length; i++) {
      if (p[i].charAt(0) === ':') continue;
      if (p[i].toLowerCase() !== s[i].toLowerCase()) return null;
    }
    var rest = s.slice(p.length);
    var params = { rest: rest, splat: rest.join('/') };
    for (var j = 0; j < p.length; j++) {
      if (p[j].charAt(0) === ':') params[p[j].slice(1)] = s[j];
    }
    return { params: params, rest: rest, exact: rest.length === 0 };
  }

  /* ---------------------------------------------------------------- 注册表 */
  var routes = [];
  function register(pattern, render) {
    if (typeof pattern !== 'string' || typeof render !== 'function') return;
    routes.push({ pattern: pattern, render: render });
  }
  var actions = {};
  function on(action, handler) {
    if (!action || typeof handler !== 'function') return;
    (actions[action] = actions[action] || []).push(handler);
  }

  /* ------------------------------------------------------------- 顶栏 / 布局 */

