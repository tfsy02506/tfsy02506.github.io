/* 棋牌娱乐模块 · 前端页面
 *
 * 路由：
 *   #/games            娱乐中心（六种游戏、随机匹配、创建房间、房间列表、我的战绩）
 *   #/games/match      随机匹配等待页（抽取动画 → 队列人数/等待时间/取消）
 *   #/games/room/:id   房间（等人/准备/开局）与对局（六种游戏各自的界面）
 *
 * 说明：
 *   · 复用了现有 TF.ui / TF.app / TF.api 体系，没有另建一套；
 *   · 所有对局状态都来自服务端，前端只提交操作请求；
 *   · 实时更新用 SSE（/api/games/stream），断线时自动退回 2 秒轮询。
 */
(function () {
  'use strict';

  var esc = TF.util.esc;
  var attr = TF.util.attr;
  function S(v) { return v === null || v === undefined ? '' : String(v); }
  function icon(n, s) { return TF.ui.icon(n, s); }
  function toast(m, t) { TF.ui.toast(m, t || 'info'); }
  function api() { return TF.api && TF.api.games; }
  function me() { return TF.store && TF.store.currentUser ? TF.store.currentUser() : null; }
  function loggedIn() { return !!me(); }
  function key(e) { return (e && e.error) ? e.error : '网络出错了，再试一次'; }
  function confirmBox(o) {
    if (TF.ui.confirm) return TF.ui.confirm(o);
    return Promise.resolve(window.confirm(o.title + '\n' + (o.body || '')));
  }
  function fmtSec(ms) {
    var s = Math.max(0, Math.floor((Number(ms) || 0) / 1000));
    var m = Math.floor(s / 60);
    return m ? (m + ' 分 ' + (s % 60) + ' 秒') : (s + ' 秒');
  }

  /* 图标映射（服务端给的是语义名，前端映射到已注册的图标） */
  var GICON = { gomoku: 'grid', chess: 'crown', xiangqi: 'flag', doudizhu: 'cards', uno: 'palette', mahjong: 'mahjong' };
  var GCOLOR = { gomoku: 0, chess: 1, xiangqi: 2, doudizhu: 3, uno: 4, mahjong: 5 };

  /* 页面级状态（跨渲染保留，避免刷新丢选中/动画） */
  var G = {
    catalog: null, catalogAt: 0,
    queue: null,
    rooms: null,
    room: null, roomId: '',
    history: null,
    rolling: false, picked: '', pickedName: '',
    es: null, tick: null, busy: false, error: '',
    /* 实时更新节流：只有状态签名变了才重画 */
    roomSig: '', queueSig: '', queueStartedAt: 0, pollBusy: false,
    roomLoadedAt: 0, allowPortrait: false,
    /* 测试/排查用计数：渲染了几次、轮询了几次 */
    renders: 0, polls: 0
  };
  var SEL = { from: -1, cards: {}, color: -1, unoSay: false, unoColor: 0 };
  if (typeof window !== 'undefined') window.__tfGames = G;

  /* ============================================================ 实时通道
   * 关键原则：**不要无脑重渲染整页**。
   * 之前每 2.2 秒 TF.app.refresh() 一次，手机上元素会在点击瞬间被替换 →
   * 出牌/退出点了没反应，而且肉眼看到"一直在自动刷新"。
   * 现在改成：轮询只取一次房间状态，比较"状态签名"，只有真的变了才重渲染；
   * 选牌这种纯前端交互直接改 DOM，不触发渲染。
   */

  function stopLive() {
    if (G.es) { try { G.es.close(); } catch (e) {} G.es = null; }
  }

  /* 房间状态签名：这些字段变化 = 需要重画 */
  function roomSignature(room) {
    if (!room) return '';
    var st = room.state || {};
    var members = (room.members || []).map(function (m) {
      return [m.seat, m.ready ? 1 : 0, m.online ? 1 : 0, m.left ? 1 : 0].join('');
    }).join(';');
    return [
      room.version, room.status, room.mySeat, members,
      st.phase, st.turn, st.bidTurn, st.landlord, st.multiplier, st.ended ? 1 : 0,
      (st.handCounts || []).join(','),
      st.lastPlay && st.lastPlay.cards ? st.lastPlay.cards.length + ':' + st.lastPlay.seat : '',
      st.claim ? (st.claim.tile && st.claim.tile.id) + ':' + ((st.claim.eligibele || st.claim.eligible || []).length) : '',
      st.myTurn ? 1 : 0, st.myTurnToBid ? 1 : 0
    ].join('|');
  }

  /* 队列状态签名：人数/游戏变了才重画（已等待时间单独更新文字，不重画） */
  function queueSignature(q) {
    if (!q) return '';
    return [q.inQueue ? 1 : 0, q.game || '', q.count || 0, q.roomId || '', q.seats || 0].join('|');
  }

  function pollRoom() {
    if (G.pollBusy || !G.roomId || !loggedIn() || !api()) return;
    G.pollBusy = true; G.polls++;
    api().room(G.roomId).then(function (d) {
      G.pollBusy = false;
      if (location.hash.indexOf('#/games/room/') !== 0) return;
      var sig = roomSignature(d.room);
      G.lastRoomAt = Date.now();
      if (sig !== G.roomSig) {
        G.room = d.room;
        G.roomSig = sig;
        TF.app.refresh();
      }
    }, function (e) {
      G.pollBusy = false;
      /* 房间没了（被解散/被清理）→ 提示并回娱乐中心 */
      if (e && e.status === 404 && location.hash.indexOf('#/games/room/') === 0) {
        toast('房间已关闭', 'warn');
        G.room = null; G.roomId = '';
        TF.app.go('/games');
      }
    });
  }

  function pollQueue() {
    if (G.pollBusy || !loggedIn() || !api()) return;
    G.pollBusy = true; G.polls++;
    api().queue().then(function (d) {
      G.pollBusy = false;
      if (location.hash.indexOf('#/games/match') !== 0) return;
      if (d.queue && d.queue.roomId) { TF.app.go('/games/room/' + d.queue.roomId); return; }
      var sig = queueSignature(d.queue);
      if (sig !== G.queueSig) {
        G.queue = d.queue;
        G.queueSig = sig;
        TF.app.refresh();
      }
      updateWaitedTexts();
    }, function () { G.pollBusy = false; });
  }

  /* 匹配页"已等待 X 秒"只改文字，不重画整页 */
  function updateWaitedTexts() {
    var nodes = document.querySelectorAll('[data-waited]');
    if (!nodes.length || !G.queueStartedAt) return;
    var text = fmtSec(Date.now() - G.queueStartedAt);
    for (var i = 0; i < nodes.length; i++) nodes[i].textContent = text;
  }

  function ensureLive() {
    if (location.hash.indexOf('#/games') !== 0) { stopLive(); return; }
    if (!loggedIn()) { stopLive(); return; }
    if (!G.es && window.EventSource) {
      try {
        G.es = new EventSource('/api/games/stream');
        G.es.addEventListener('matched', function (ev) {
          var d = null;
          try { d = JSON.parse(ev.data); } catch (e) {}
          if (!d || !d.roomId) return;
          G.rolling = false; G.picked = ''; G.pickedName = '';
          TF.app.go('/games/room/' + d.roomId);
        });
        /* 收到房态变化通知：交给轮询做"签名比较"，变了才重画 */
        G.es.addEventListener('room', function () { pollRoom(); });
        G.es.addEventListener('gameStart', function () { pollRoom(); });
        G.es.addEventListener('gameEnd', function () { pollRoom(); });
        G.es.onerror = function () { /* 浏览器会自动重连；失败时靠轮询兜底 */ };
      } catch (e) { G.es = null; }
    }
    if (!G.tick) {
      G.tick = setInterval(function () {
        if (location.hash.indexOf('#/games') !== 0) { stopLive(); return; }
        if (location.hash.indexOf('#/games/match') === 0) { pollQueue(); return; }
        if (location.hash.indexOf('#/games/room/') === 0) { pollRoom(); return; }
        /* 匹配页放着不动时，也把"已等待"每秒走一下 */
        updateWaitedTexts();
      }, 1000);
    }
  }

  /* ============================================================ 公共片段 */

  function loginTip(text) {
    return '<div class="gcard gcard--flat"><div class="gcard__body g-empty-box">' +
      '<p class="g-muted">' + esc(text || '这个功能要登录之后才能用') + '</p>' +
      '<div class="mt-3"><a class="btn btn--primary" href="#/login?redirect=' +
      encodeURIComponent(location.hash.replace(/^#/, '')) + '">去登录</a>' +
      '<a class="btn btn--ghost ml-2" href="#/register">注册</a></div></div></div>';
  }

  function errBox(msg, retryAction) {
    return '<div class="gcard gcard--flat"><div class="gcard__body g-empty-box">' +
      '<p class="g-error">' + esc(msg) + '</p>' +
      (retryAction ? '<div class="mt-3"><button type="button" class="btn btn--ghost" data-action="' + attr(retryAction) + '">' + icon('refresh', 15) + ' 重新加载</button></div>' : '') +
      '</div></div>';
  }

  function avatarHTML(m, size) {
    return TF.ui.avatar({ id: m.id, nickname: m.nickname, avatar: m.avatar, avatarUrl: m.avatarUrl }, size || 36, 'avatar--round');
  }

  function gameName(id) {
    var g = findGame(id);
    return g ? g.name : id;
  }
  function findGame(id) {
    for (var i = 0; i < (G.catalog || []).length; i++) if (G.catalog[i].id === id) return G.catalog[i];
    return null;
  }
  function ruleText(g) { return (g && g.ruleName) ? g.ruleName : ''; }

  /* ============================================================ 娱乐中心 */

  function loadHub() {
    if (!api()) return Promise.resolve();
    var now = Date.now();
    if (G.catalog && now - G.catalogAt < 4000 && G.rooms) return Promise.resolve();
    G.error = '';
    return Promise.all([
      api().catalog().then(function (d) { G.catalog = d.games || []; G.catalogAt = Date.now(); }, function (e) { G.error = key(e); }),
      api().rooms('').then(function (d) { G.rooms = d.rooms || []; }, function (e) { if (!G.error) G.error = key(e); })
    ]);
  }

  function hubHTML() {
    var u = me();
    var html = '<div class="page games" data-page="games">';

    /* 顶部：随机匹配 */
    html += '<section class="ghero">' +
      '<div class="ghero__main">' +
        '<h1 class="ghero__title">' + icon('sparkle', 22) + ' 娱乐中心</h1>' +
        '<p class="ghero__desc">六种棋牌，随机匹配或者和同学开一局。所有操作都由服务器判定，输了也是真的输了。</p>' +
        '<div class="ghero__acts">' +
          (loggedIn()
            ? '<button type="button" class="btn btn--primary btn--lg" data-action="games.random">' + icon('dice', 18) + ' 随机匹配</button>'
            : '<a class="btn btn--primary btn--lg" href="#/login?redirect=%2Fgames">登录后开始</a>') +
          '<button type="button" class="btn btn--ghost btn--lg" data-action="games.create.open">' + icon('plus', 18) + ' 创建房间</button>' +
          (loggedIn() ? '<a class="btn btn--ghost btn--lg" href="#/games/match">' + icon('users', 18) + ' 我的匹配</a>' : '') +
        '</div>' +
        '<p class="ghero__hint">' + (G.catalog ? ('当前在线 ' + ((G.catalog[0] && G.catalog[0].onlinePlayers) || 0) + ' 人 · 排队中 ' +
          G.catalog.reduce(function (n, g) { return n + (g.queue || 0); }, 0) + ' 人') : '') + '</p>' +
      '</div>' +
    '</section>';

    if (G.error) html += errBox(G.error, 'games.reload');

    /* 六种游戏 */
    html += '<h2 class="gsection">选一个游戏</h2><div class="ggrid">';
    var games = G.catalog || [];
    for (var i = 0; i < games.length; i++) {
      var g = games[i];
      html += '<div class="gcard gcard--game" data-game="' + attr(g.id) + '">' +
        '<div class="gcard__head">' +
          '<span class="gicon gicon--' + attr(g.id) + '">' + icon(GICON[g.id] || 'cards', 26) + '</span>' +
          '<div><b class="gcard__title">' + esc(g.name) + '</b>' +
          '<div class="g-muted g-tiny">' + g.seats + ' 人对局</div></div>' +
        '</div>' +
        '<p class="gcard__desc">' + esc(g.desc || '') + '</p>' +
        '<p class="g-tiny g-muted">规则：' + esc(ruleText(g)) + '</p>' +
        '<div class="gcard__foot">' +
          '<span class="g-tiny g-muted">' + (g.queue ? ('排队 ' + g.queue + ' 人') : '暂时没人排队') + '</span>' +
          '<span class="gspacer"></span>' +
          (loggedIn()
            ? '<button type="button" class="btn btn--sm btn--primary" data-action="games.match.game" data-param="' + attr(JSON.stringify({ game: g.id })) + '">匹配</button>' +
              '<button type="button" class="btn btn--sm btn--ghost" data-action="games.create.open" data-param="' + attr(JSON.stringify({ game: g.id })) + '">建房</button>'
            : '<a class="btn btn--sm btn--ghost" href="#/login?redirect=%2Fgames">登录</a>') +
        '</div>' +
      '</div>';
    }
    html += '</div>';

    /* 房间列表 */
    var rooms = G.rooms || [];
    html += '<h2 class="gsection">等人加入的房间</h2>';
    if (!rooms.length) {
      html += '<div class="gcard gcard--flat"><div class="gcard__body g-muted">还没有人开房。你可以点上面的「创建房间」开一间，把房间号发到群里叫同学来。</div></div>';
    } else {
      html += '<div class="glist">';
      for (var r = 0; r < rooms.length; r++) {
        var rm = rooms[r];
        html += '<div class="grow">' +
          '<span class="gicon gicon--sm gicon--' + attr(rm.game) + '">' + icon(GICON[rm.game] || 'cards', 18) + '</span>' +
          '<div class="grow__main"><b>' + esc(rm.name) + '</b>' +
            '<div class="g-tiny g-muted">' + esc(rm.gameName) + ' · ' + esc(rm.hostNickname) + ' 开的 · ' +
            rm.members + '/' + rm.seats + ' 人' + (rm.hasPassword ? ' · 有密码' : '') + '</div></div>' +
          (loggedIn()
            ? '<button type="button" class="btn btn--sm btn--primary" data-action="games.join.open" data-param="' +
              attr(JSON.stringify({ id: rm.id, hasPassword: rm.hasPassword })) + '">加入</button>'
            : '') +
        '</div>';
      }
      html += '</div>';
    }

    /* 我的战绩 */
    if (loggedIn()) {
      html += '<h2 class="gsection">我的最近对局</h2>';
      if (!G.history) {
        html += '<div class="gcard gcard--flat"><div class="gcard__body g-muted">加载中…</div></div>';
      } else if (!G.history.length) {
        html += '<div class="gcard gcard--flat"><div class="gcard__body g-muted">还没有对局记录。开一局试试。</div></div>';
      } else {
        html += '<div class="glist">';
        for (var h = 0; h < G.history.length; h++) {
          var it = G.history[h];
          html += '<div class="grow">' +
            '<span class="gicon gicon--sm gicon--' + attr(it.game) + '">' + icon(GICON[it.game] || 'cards', 18) + '</span>' +
            '<div class="grow__main"><b>' + esc(it.gameName) + '</b>' +
              '<div class="g-tiny g-muted">' + esc(it.detail || '') + ' · ' + esc((it.players || []).join('、')) + '</div></div>' +
            '<span class="gbadge ' + (it.iWon ? 'gbadge--win' : '') + '">' + (it.iWon ? '赢了' : '没赢') + '</span>' +
          '</div>';
        }
        html += '</div>';
      }
    }

    /* 弹窗：建房 / 加入 */
    html += createRoomModalHTML() + joinModalHTML();
    html += '</div>';
    return html;
  }

  function createRoomModalHTML() {
    var opts = (G.catalog || []).map(function (g) {
      return { value: g.id, label: g.name + '（' + g.seats + ' 人）' };
    });
    if (!opts.length) opts = [{ value: 'gomoku', label: '五子棋' }];
    return TF.ui.modal({
      id: 'games-create', title: '创建房间',
      body: '<form data-action="games.create.submit">' +
        TF.ui.selectField({ label: '玩什么', name: 'game', options: opts }) +
        '<div class="mt-3">' + TF.ui.field({ label: '房间名', name: 'name', maxlength: 24, placeholder: '可以不填' }) + '</div>' +
        '<div class="mt-3">' + TF.ui.field({ label: '房间密码', name: 'password', maxlength: 20, placeholder: '不填就是公开房间', hint: '想让认识的人才能进来就设一个' }) + '</div>' +
        '<p class="g-tiny g-muted mt-3">建好之后把房间号发给同学，他们输入房间号就能进来。</p>' +
        '<div class="cluster gap-2 mt-4"><button class="btn btn--primary" type="submit">开房</button>' +
        '<button class="btn" type="button" data-modal-close>取消</button></div></form>'
    });
  }

  function joinModalHTML() {
    return TF.ui.modal({
      id: 'games-join', title: '加入房间',
      body: '<form data-action="games.join.submit">' +
        '<input type="hidden" name="id" value="">' +
        '<div data-pw><label class="field__label">房间密码</label>' +
        '<input class="input" name="password" type="password" maxlength="20" placeholder="这个房间有密码">' +
        '<div class="field__hint">没密码的房间会直接进去</div></div>' +
        '<div class="cluster gap-2 mt-4"><button class="btn btn--primary" type="submit">进去</button>' +
        '<button class="btn" type="button" data-modal-close>取消</button></div></form>'
    });
  }

  /* ============================================================ 匹配等待页 */

  function matchHTML() {
    var u = me();
    if (!u) {
      return '<div class="page games" data-page="games">' + loginTip('要登录才能匹配对手') + '</div>';
    }
    var q = G.queue || { inQueue: false };
    var html = '<div class="page games" data-page="games" data-sub="match">';

    if (G.rolling) {
      /* 抽取动画：六张卡片滚动高亮 */
      html += '<section class="gmroll">' +
        '<h1 class="gmroll__title">正在抽……</h1>' +
        '<p class="g-muted">六种游戏里随机抽一个，抽到就进去匹配。</p>' +
        '<div class="gmroll__grid">' +
          (G.catalog || []).map(function (g) {
            return '<div class="gmroll__item" data-roll="' + attr(g.id) + '">' +
              '<span class="gicon gicon--' + attr(g.id) + '">' + icon(GICON[g.id] || 'cards', 30) + '</span>' +
              '<b>' + esc(g.name) + '</b></div>';
          }).join('') +
        '</div></section>';
    } else if (q.inQueue) {
      var others = Math.max(0, (q.count || 1) - 1);
      html += '<section class="gmatch">' +
        '<div class="gmatch__top">' +
          '<span class="gicon gicon--lg gicon--' + attr(q.game) + '">' + icon(GICON[q.game] || 'cards', 34) + '</span>' +
          '<div><h1 class="gmatch__title">' + esc(q.gameName || gameName(q.game)) + '</h1>' +
          '<div class="g-muted">已加入匹配队列</div></div>' +
        '</div>' +
        '<div class="gmstat">' +
          '<div class="gmstat__item"><b>' + (q.count || 1) + ' / ' + (q.seats || 2) + '</b><span>当前匹配人数</span></div>' +
          '<div class="gmstat__item"><b data-waited>' + fmtSec(q.waitedMs || 0) + '</b><span>已等待</span></div>' +
          '<div class="gmstat__item"><b>' + (q.needsMore || 0) + ' 人</b><span>还差</span></div>' +
        '</div>' +
        (others === 0
          ? '<div class="gnotice gnotice--wait"><b>当前暂无可匹配的玩家，已为你加入匹配队列，请稍候。</b>' +
            '<div class="g-tiny">等别的同学也点匹配、并且抽到同一个游戏，服务器会自动把你们放进同一局。</div></div>'
          : '<div class="gnotice gnotice--go">已经有 ' + others + ' 位同学在等，人凑齐就自动开局。</div>') +
        '<div class="gmatch__acts">' +
          '<a class="btn btn--ghost" href="#/games">回娱乐中心</a>' +
          '<button type="button" class="btn btn--danger-ghost" data-action="games.match.cancel">取消匹配</button>' +
        '</div>' +
        '<p class="g-tiny g-muted mt-3">离开这个页面也会继续排，回来还能看到进度。</p>' +
      '</section>';
    } else {
      html += '<section class="gmatch">' +
        '<h1 class="gmatch__title">还没在匹配</h1>' +
        '<p class="g-muted">点下面随机抽一个游戏，或者回娱乐中心自己选。</p>' +
        '<div class="gmatch__acts">' +
          '<button type="button" class="btn btn--primary" data-action="games.random">' + icon('dice', 16) + ' 随机匹配</button>' +
          '<a class="btn btn--ghost" href="#/games">回娱乐中心</a>' +
        '</div></section>';
    }
    return html + '</div>';
  }

  /* ============================================================ 房间 / 对局 */

  function roomStatusText(room) {
    if (room.status === 'waiting') return '等人中';
    if (room.status === 'playing') return '对局中';
    if (room.status === 'ended') return '已结束';
    return '已关闭';
  }

  function winnersText(room) {
    var st = room.state || {};
    var members = room.members || [];
    var names = [];
    function nameOf(seatOrId) {
      for (var i = 0; i < members.length; i++) {
        if (String(members[i].id) === String(seatOrId) || members[i].seat === seatOrId) return members[i].nickname;
      }
      return '';
    }
    var game = room.game;
    if (game === 'doudizhu' && st.winners) {
      names = st.winners.map(nameOf);
    } else if (game === 'mahjong' && st.won) {
      names = st.won.map(function (w) { return nameOf(w.seat); });
    } else if (st.winner !== null && st.winner !== undefined) {
      names = [nameOf(st.winner)];
    }
    return names.filter(Boolean);
  }

  function resultText(room) {
    var st = room.state || {};
    var who = winnersText(room);
    var r = st.result || '';
    if (room.game === 'doudizhu') {
