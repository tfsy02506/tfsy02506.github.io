        }) +
        '<p class="field__hint">改完旧密码立刻失效，用新密码登录。密码只有你和服务器的哈希知道，管理员也看不到明文。</p>' +
        '<div class="cluster">' +
        button({ text: '上一步', variant: 'ghost', action: 'auth.forgotRestart' }) +
        '<span class="spacer"></span>' +
        button({ text: '重置密码', variant: 'primary', size: 'lg', type: 'submit' }) +
        '</div>' +
      '</form>' +

      '<div class="divider"></div>' +
      '<p class="text-sm text-2 center">想起来了？<a href="#/login">去登录</a></p>' +
      '</div>';
    return { html: html, onMount: mountForgot, title: '找回密码' };
  }

  function showForgotStep(root, n) {
    if (!root || !root.querySelectorAll) return;
    var forms = root.querySelectorAll('form[data-step]');
    for (var i = 0; i < forms.length; i++) {
      forms[i].classList.toggle('is-hidden', Number(forms[i].getAttribute('data-step')) !== n);
    }
    var dots = root.querySelectorAll('[data-step-dot]');
    for (var k = 0; k < dots.length; k++) {
      dots[k].classList.toggle('is-active', Number(dots[k].getAttribute('data-step-dot')) <= n);
    }
  }
  function mountForgot(root) {
    if (!root || !root.querySelector) return;
    var form3 = root.querySelector('form[data-step="3"]');
    var pwInput = form3 ? form3.querySelector('input[name="password"]') : null;
    if (pwInput && pwInput.addEventListener) {
      pwInput.addEventListener('input', function () { paintStrength(form3); }, false);
    }
    var box = root.querySelector('[data-account-box]');
    if (box) box.innerHTML = '';
    showForgotStep(root, 1);
    var input = root.querySelector('form[data-step="1"] input[name="username"]');
    if (input && !input.value && lastUsername) input.value = lastUsername;
  }

  /* ======================================================================
     7 · 公告列表 / 详情
     ====================================================================== */
  function renderNotices() {
    var list = noticeList();
    var admin = isAdmin();
    var body = list.length
      ? '<div class="noticelist">' + list.map(noticeRowHTML).join('') + '</div>'
      : '<div class="empty--plain">还没有公告</div>';

    var html = '<div class="page" data-page="notices">' +
      crumbHTML([{ text: '首页', href: '#/home' }, { text: '校园公告' }]) +
      '<div class="page__head">' +
        '<h1 class="page__title">校园公告</h1>' +
        '<p class="page__desc">调课、活动报名、维护通知、版规变化都发在这里。置顶的排最前面。</p>' +
      '</div>' +
      (admin
        ? '<div class="cluster mb-3">' +
          '<a class="btn btn--sm" href="#/admin/notices">' + icon('edit', 14) + '去后台管公告</a>' +
          '</div>'
        : '') +
      blockHTML({ cls: 'block--box', title: '全部公告', body: body }) +
      '</div>';
    return { html: html, title: '校园公告' };
  }

  function renderNotice() {
    var id = String(routeParam().id || '');
    var n = noticeOf(id);
    var admin = isAdmin();

    if (!n) {
      return {
        html: '<div class="page" data-page="notice">' +
          crumbHTML([{ text: '首页', href: '#/home' }, { text: '校园公告', href: '#/notices' }, { text: '找不到' }]) +
          '<div class="card card--pad">' +
          '<div class="empty--plain">这条公告不在了，可能被删了。</div>' +
          '</div>' +
          '<div class="cluster mt-4"><a class="btn" href="#/notices">' + icon('arrowLeft', 14) + '返回公告列表</a></div>' +
          '</div>',
        title: '公告'
      };
    }

    var author = userOf(n.authorId);
    var tone = LEVEL_TONE[n.level] || 'info';
    var flag = LEVEL_TEXT[n.level];

    var html = '<div class="page" data-page="notice">' +
      crumbHTML([{ text: '首页', href: '#/home' }, { text: '校园公告', href: '#/notices' }, { text: '公告' }]) +
      '<article class="card card--pad">' +
        '<div class="cluster mb-2">' +
          (flag ? badge(flag, tone) : badge('通知', 'info')) +
          (n.top ? badge('置顶', 'pinned') : '') +
        '</div>' +
        '<h1 class="page__title">' + esc(n.title) + '</h1>' +
        '<div class="listmeta mt-2">' +
          '<span class="listmeta__item">' + icon('user', 13) + (author ? esc(nickOf(author)) : '站务组') + '</span>' +
          '<span class="listmeta__item">' + icon('calendar', 13) + esc(fmtDate(n.createdAt)) + '</span>' +
          '<span class="listmeta__item">' + icon('clock', 13) + esc(relTime(n.createdAt)) + '</span>' +
        '</div>' +
        '<div class="divider"></div>' +
        '<div class="markdown">' + md(n.content) + '</div>' +
      '</article>' +
      '<div class="cluster mt-4">' +
        '<a class="btn" href="#/notices">' + icon('arrowLeft', 14) + '返回公告列表</a>' +
        (admin ? '<a class="btn btn--primary" href="#/admin/notices">' + icon('edit', 14) + '去后台编辑</a>' : '') +
      '</div>' +
      '</div>';
    return { html: html, title: n.title };
  }

  /* ======================================================================
     8 · 404
     ====================================================================== */
  function notFoundPage() {
    return {
      html: '<div class="page" data-page="404">' +
        '<div class="card card--pad">' +
        emptyBox({
          icon: 'question',
          title: '这个页面不存在',
          desc: '地址可能拼错了，也可能内容已经被删掉。',
          action: '<a class="btn btn--primary" href="#/home">回首页</a>' +
            '<a class="btn" href="#/forum">去论坛</a>'
        }) +
        '</div></div>',
      title: '找不到页面'
    };
  }

  /* ======================================================================
     9 · data-action 处理器
     说明：data-action 挂在下单 <form> 上时，app.js 的 click 委托会先以
     event.type === 'click' 派发一次，紧接着 submit 委托再派发一次；
     这里只认 submit，保证一次动作只跑一次。
     ====================================================================== */
  function isSubmit(ctx) { return !ctx.event || ctx.event.type !== 'click'; }

  function onHomeSearch(ctx) {
    if (!isSubmit(ctx)) return;
    var q = String(ctx.values().q || '').trim();
    if (!q) { toast('想搜什么？', 'warn'); return; }
    go('/search', { q: q });
  }

  function onLogin(ctx) {
    if (!isSubmit(ctx)) return;
    var form = ctx.form;
    var v = ctx.values();
    var username = String(v.username || '').trim();
    var password = String(v.password || '');
    if (!username) { fail(form, '用户名填一下'); return; }
    if (!password) { fail(form, '密码填一下'); return; }

    var r;
    try { r = ST().login ? ST().login(username, password) : { ok: false, error: '数据层还没准备好，刷新一下页面' }; }
    catch (e) { r = { ok: false, error: '登录出错了，刷新一下再试' }; }
    if (!r || !r.ok) {
      fail(form, (r && r.error) || '登录失败');
      return;
    }
    formError(form, '');
    lastUsername = v.remember ? username : '';
    toast('登录好了，' + nickOf(r.user), 'success');
    var target = safeRedirect(query().redirect) || '/home';
    refreshUser();
    go(target);
  }

  function onRegister(ctx) {
    if (!isSubmit(ctx)) return;
    var form = ctx.form;
    var v = ctx.values();
    var username = String(v.username || '').trim();
    var nickname = String(v.nickname || '').trim();
    var password = String(v.password || '');
    var password2 = String(v.password2 || '');

    if (!/^[a-zA-Z0-9_]{3,16}$/.test(username)) {
      fail(form, '用户名 3-16 位，只能用字母、数字和下划线'); return;
    }
    if (findByUsername(username)) { fail(form, '「' + username + '」有人用了，换一个'); return; }
    if (nickname.length < 2 || nickname.length > 16) { fail(form, '昵称 2-16 个字'); return; }
    if (password.length < 6) { fail(form, '密码至少 6 位'); return; }
    if (password !== password2) { fail(form, '两次密码不一样'); return; }
    if (!v.agree) {
      var box = form.querySelector ? form.querySelector('[data-agree-error]') : null;
      if (box) {
        box.classList.remove('is-hidden');
        box.innerHTML = icon('alert', 13) + '<span>先勾一下「我看过版规了」</span>';
      }
      fail(form, '要同意版规才能注册');
      return;
    }
    var agreeBox = form.querySelector ? form.querySelector('[data-agree-error]') : null;
    if (agreeBox) { agreeBox.classList.add('is-hidden'); agreeBox.innerHTML = ''; }
    formError(form, '');

    var payload = {
      username: username, nickname: nickname,
      password: password, password2: password2,
      email: String(v.email || '').trim(),
      grade: String(v.grade || '').trim(),
      sex: String(v.sex || ''),
      invite: String(v.invite || '').trim()
    };
    var r;
    try { r = ST().register ? ST().register(payload) : { ok: false, error: '数据层还没准备好，刷新一下页面' }; }
    catch (e) { r = { ok: false, error: '注册出错了，刷新一下再试' }; }
    if (!r || !r.ok) {
      fail(form, (r && r.error) || '注册失败');
      return;
    }
    lastUsername = username;
    toast('注册好了，' + nickname + '。先认证学生身份，就能看帖发帖了', 'success');
    refreshUser();
    /* 新账号 = 校外访客，引导去认证；认证页也可以先去娱乐中心 */
    go('/verify');
  }

  /* 第一步：拿用户名去问服务端「这个账号的安全问题是什么」（服务端只回问题） */
  function onForgotLookup(ctx) {
    if (!isSubmit(ctx)) return;
    var form = ctx.form;
    var root = form.closest ? form.closest('[data-page]') : null;
    var username = String(ctx.values().username || '').trim();
    if (!username) { fail(form, '用户名填一下'); return; }
    var store = ST();
    var r = { ok: false, error: '数据层还没准备好，刷新一下页面' };
    try { r = store.getSecurityQuestion ? store.getSecurityQuestion(username) : r; }
    catch (e) { r = { ok: false, error: '查询出错了，刷新一下再试' }; }
    if (!r || !r.ok) { fail(form, (r && r.error) || '没找到这个账号'); return; }
    formError(form, '');
    forgotUser = { username: username, nickname: r.nickname || username };
    forgotAnswer = '';
    var box = root ? root.querySelector('[data-account-box]') : null;
    if (box) box.innerHTML = forgotAccountHTML(forgotUser);
    var qbox = root ? root.querySelector('[data-question-box]') : null;
    if (qbox) {
      qbox.innerHTML = '<div class="field__label">安全问题</div>' +
        '<p class="text-lg"><b>' + esc(r.question || '这个账号没设安全问题') + '</b></p>';
    }
    var ans = root ? root.querySelector('form[data-step="2"] input[name="answer"]') : null;
    if (ans) { ans.value = ''; if (ans.focus) { try { ans.focus(); } catch (e) {} } }
    if (root) showForgotStep(root, 2);
    toast('找到账号了，回答问题', 'info');
  }

  /* 第二步：只收集答案，真正的校验在第三步由服务端完成 */
  function onForgotVerify(ctx) {
    if (!isSubmit(ctx)) return;
    var form = ctx.form;
    var root = form.closest ? form.closest('[data-page]') : null;
    if (!forgotUser) { fail(form, '回去第一步重填用户名'); return; }
    var answer = String(ctx.values().answer || '').trim();
    if (!answer) { fail(form, '答案填一下'); return; }
    formError(form, '');
    forgotAnswer = answer;
    if (root) showForgotStep(root, 3);
    toast('最后一步，设个新密码', 'info');
  }

  /* 第三步：把用户名 + 答案 + 新密码一起交给服务端；答案不对会被打回来 */
  function onForgotReset(ctx) {
    if (!isSubmit(ctx)) return;
    var form = ctx.form;
    var root = form.closest ? form.closest('[data-page]') : null;
    if (!forgotUser || !forgotAnswer) {
      fail(form, '回去重新答一次安全问题');
      if (root) showForgotStep(root, 1);
      return;
    }
    var v = ctx.values();
    var pwd = String(v.password || '');
    var pwd2 = String(v.password2 || '');
    if (pwd.length < 6) { fail(form, '新密码至少 6 位'); return; }
    if (pwd !== pwd2) { fail(form, '两次密码不一样'); return; }
    var store = ST();
    var r = { ok: false, error: '数据层还没准备好，刷新一下页面' };
    try {
      r = store.resetPasswordByAnswer
        ? store.resetPasswordByAnswer({ username: forgotUser.username, answer: forgotAnswer, newPwd: pwd, newPwd2: pwd2 })
        : r;
    } catch (e) { r = { ok: false, error: '重置出错了，刷新一下再试' }; }
    if (!r || !r.ok) {
      var msg = (r && r.error) || '重置没成功';
      if (/答案/.test(msg) && root) {
        showForgotStep(root, 2);
        var f2 = root.querySelector('form[data-step="2"]');
        if (f2) fail(f2, msg); else toast(msg, 'error');
        return;
      }
      fail(form, msg);
      return;
    }
    formError(form, '');
    lastUsername = forgotUser.username;
    forgotUser = null;
    forgotAnswer = '';
    toast('密码改好了，用新密码登录', 'success');
    go('/login');
  }

  function onForgotRestart(ctx) {
    var root = (ctx.el && ctx.el.closest ? ctx.el.closest('[data-page]') : null) || document;
    forgotUser = null;
    var box = root.querySelector ? root.querySelector('[data-account-box]') : null;
    if (box) box.innerHTML = '';
    var f1 = root.querySelector ? root.querySelector('form[data-step="1"]') : null;
    if (f1) formError(f1, '');
    showForgotStep(root, 1);
    var input = root.querySelector ? root.querySelector('form[data-step="1"] input[name="username"]') : null;
    if (input && input.focus) { try { input.focus(); } catch (e) {} }
  }

  /* ======================================================================
     10 · 注册路由 / 动作（app.js 先于本文件装载，顶层注册即可）
     ====================================================================== */
  TF.app.register('/home', renderHome);
  TF.app.register('/login', renderLogin);
  TF.app.register('/register', renderRegister);
  TF.app.register('/forgot', renderForgot);
  TF.app.register('/notices', renderNotices);
  TF.app.register('/notice/:id', renderNotice);
  /* 学生认证（校卡审核）：校外访客从这里解锁论坛 */
  TF.app.register('/verify', renderVerify);
  /* 兜底 404：app.js 在路由表未命中时显式 resolve('/404') */
  TF.app.register('/404', notFoundPage);

  TF.app.on('home.search', onHomeSearch);
  TF.app.on('auth.login', onLogin);
  TF.app.on('auth.register', onRegister);
  TF.app.on('student.submit', onStudentSubmit);
  TF.app.on('auth.forgotLookup', onForgotLookup);
  TF.app.on('auth.forgotVerify', onForgotVerify);
  TF.app.on('auth.forgotReset', onForgotReset);
  TF.app.on('auth.forgotRestart', onForgotRestart);
})();
