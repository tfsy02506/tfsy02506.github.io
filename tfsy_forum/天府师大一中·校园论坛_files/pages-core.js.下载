/* ==========================================================================
   pages-core.js · 公共页面（首页 / 登录 / 注册 / 找回密码 / 公告 / 404）
   契约：CONTRACT.md 第 6/7/8/9/10 节 + §11.0 文案标准
   负责：#/home #/login #/register #/forgot #/notices #/notice/:id #/404

   设计方向：干净信息流（BBS 风格）—— 站点说明条 + 统计条 + 两栏信息流。
   没有渐变 Hero、没有大标语、没有轮播动画。

   实现要点
     1) 每个页面返回 { html, onMount(root, ctx) }；根节点 <div class="page" data-page="…">。
     2) 交互一律 data-action + 本模块顶层的 TF.app.on 处理器；表单值走 ctx.values()。
     3) 类名只用 assets/css 里真实存在的（.bbs-head / .bbs-stats / .block / .postrow /
        .rankrow / .listmeta / .crumb / .noticerow / .tagchip / .empty--plain …）。
     4) 文案按 §11.0：短、具体、口语，用「你」；空状态一句话不加感叹号；
        按钮写动词（登录 / 注册 / 重置密码），不套放到任何网站都合适的模板句。
     5) 登录/注册/找回密码由 app.js 包在 .authcard 外壳里（#page-host = .authcard__form），
        本文件只输出卡片内部的表单内容，不重复渲染 .authpage / .authcard。
     6) 载入顺序（§1 R3）：app.js 先于本文件执行，故模块顶层可直接注册路由与处理器。
   ========================================================================== */
(function () {
  'use strict';

  var TF = (window.TF = window.TF || {});
  TF.extend = TF.extend || function (n, o) { TF[n] = Object.assign(TF[n] || {}, o); return TF[n]; };

  /* 班级只能选 1~10 班（和后端 server/api.mjs 的 RE_KLASS 保持一致） */
  var KLASS_OPTIONS = ['1班', '2班', '3班', '4班', '5班', '6班', '7班', '8班', '9班', '10班'];
  var KLASS_OPTIONS_RE = /^([1-9]|10)班$/;

  /* ======================================================================
     1 · 对外部模块的安全代理
     ====================================================================== */
  function U() { return TF.util || {}; }
  function esc(v) { return U().esc ? U().esc(v) : (v == null ? '' : String(v)); }
  function attr(v) { return U().attr ? U().attr(v) : esc(v); }
  function num(v, d) { return U().num ? U().num(v, d) : String(v == null ? 0 : v); }
  function relTime(v) { return U().relTime ? U().relTime(v) : ''; }
  function fmtDate(v) { return U().fmtDate ? U().fmtDate(v) : ''; }
  function excerpt(v, n) { return U().excerpt ? U().excerpt(v, n || 64) : String(v == null ? '' : v); }
  function stripHtml(v) { return U().stripHtml ? U().stripHtml(v) : String(v == null ? '' : v); }
  function md(v) { return U().md ? U().md(v) : esc(v); }
  function debounce(fn, w) { return U().debounce ? U().debounce(fn, w) : fn; }

  function icon(n, s, c) { return TF.ui && TF.ui.icon ? TF.ui.icon(n, s, c) : ''; }
  function button(o) { return TF.ui && TF.ui.button ? TF.ui.button(o) : ''; }
  function field(o) { return TF.ui && TF.ui.field ? TF.ui.field(o) : ''; }
  function selectField(o) { return TF.ui && TF.ui.selectField ? TF.ui.selectField(o) : ''; }
  function checkField(o) { return TF.ui && TF.ui.checkField ? TF.ui.checkField(o) : ''; }
  function radioCards(o) { return TF.ui && TF.ui.radioCards ? TF.ui.radioCards(o) : ''; }
  function emptyBox(o) { return TF.ui && TF.ui.empty ? TF.ui.empty(o) : ''; }
  function avatar(u, s, c) { return TF.ui && TF.ui.avatar ? TF.ui.avatar(u, s, c) : ''; }
  function badge(t, tone) { return TF.ui && TF.ui.badge ? TF.ui.badge(t, tone) : '<span class="badge">' + esc(t) + '</span>'; }
  function toast(msg, type, ms) { if (TF.ui && TF.ui.toast) TF.ui.toast(msg, type, ms); }

  function go(p, q) { if (TF.app && TF.app.go) TF.app.go(p, q); }
  function refreshUser() { if (TF.app && TF.app.refreshUser) TF.app.refreshUser(); }
  function query() { return (TF.route && TF.route.query) || {}; }
  function routeParam() { return (TF.route && TF.route.param) || {}; }

  function ST() { return TF.store || {}; }
  function currentUser() { try { return ST().currentUser ? ST().currentUser() : null; } catch (e) { return null; } }
  function isAdmin() { try { return ST().isAdmin ? !!ST().isAdmin() : false; } catch (e) { return false; } }
  function siteSettings() { try { return (ST().getSettings && ST().getSettings()) || {}; } catch (e) { return {}; } }
  function siteCounts() {
    try { var c = ST().counts && ST().counts(); return c || { total: 0, today: 0, tags: [] }; }
    catch (e) { return { total: 0, today: 0, tags: [] }; }
  }
  function boardList() { try { return (ST().listBoards && ST().listBoards()) || []; } catch (e) { return []; } }
  function noticeList(n) { try { return (ST().listNotices && ST().listNotices(n)) || []; } catch (e) { return []; } }
  function noticeOf(id) { try { return (ST().getNotice && ST().getNotice(id)) || null; } catch (e) { return null; } }
  function hotList(n) { try { return (ST().hotPosts && ST().hotPosts(n)) || []; } catch (e) { return []; } }
  function postList(o) {
    try { return (ST().listPosts && ST().listPosts(o)) || { list: [], total: 0 }; }
    catch (e) { return { list: [], total: 0 }; }
  }
  function userList(o) {
    try { return (ST().listUsers && ST().listUsers(o)) || { list: [], total: 0 }; }
    catch (e) { return { list: [], total: 0 }; }
  }
  function userOf(id) { try { return (ST().getUser && ST().getUser(id)) || null; } catch (e) { return null; } }
  function boardOf(id) { try { return (ST().getBoard && ST().getBoard(id)) || null; } catch (e) { return null; } }
  function findByUsername(name) {
    try { return (ST().findUserByUsername && ST().findUserByUsername(name)) || null; } catch (e) { return null; }
  }

  /* 手机断点，与 mobile.css 的 ≤620px 保持一致。
     只用在「手机上要换一种更省屏的排布」的两处：
       · 首页不再放大搜索框（顶栏已经有搜索图标了）
       · 统计条在手机上收成 3 格，保证一行放得下
     桌面/平板走原来的四格 + 内联搜索。 */
  var MOBILE_MAX = 620;
  function isPhone() {
    try {
      return typeof window !== 'undefined' && typeof window.innerWidth === 'number' &&
        window.innerWidth > 0 && window.innerWidth <= MOBILE_MAX;
    } catch (e) { return false; }
  }

  /* ======================================================================
     2 · 通用片段
     ====================================================================== */
  var LEVEL_TONE = { info: 'info', warn: 'warn', important: 'danger' };
  var LEVEL_TEXT = { warn: '提醒', important: '重要' };

  function nickOf(u) { return (u && (u.nickname || u.username)) || '已注销'; }
  function authorOf(id) { return userOf(id) || { id: '', nickname: '已注销', username: '' }; }
  function boardNameOf(id) {
    var b = boardOf(id);
    return b ? b.name : '综合';
  }

  function crumbHTML(items) {
    var html = items.map(function (it, i) {
      if (it.href && i !== items.length - 1) return '<a href="' + attr(it.href) + '">' + esc(it.text) + '</a>';
      return '<span>' + esc(it.text) + '</span>';
    }).join('');
    return '<nav class="crumb mb-3" aria-label="位置">' + html + '</nav>';
  }

  /* 信息流条目：标题 + 一行摘要 + 元信息 */
  function postRowHTML(p) {
    var a = authorOf(p.authorId);
    var flags = '';
    if (p.pinned) flags += badge('置顶', 'pinned');
    if (p.featured) flags += badge('精华', 'essence');
    var summary = excerpt(stripHtml(p.content), 70);
    return '<div class="postrow' + (p.pinned ? ' postrow--pinned' : '') + '">' +
      '<div class="postrow__main">' +
        '<div class="postrow__title">' +
          '<a href="#/post/' + attr(p.id) + '">' + esc(p.title) + '</a>' + flags +
        '</div>' +
        (summary ? '<div class="text-sm text-2 truncate mt-1">' + esc(summary) + '</div>' : '') +
        '<div class="postrow__meta">' +
          '<a href="#/board/' + attr(p.boardId) + '">' + esc(boardNameOf(p.boardId)) + '</a>' +
          '<a href="#/u/' + attr(a.id || '') + '">' + esc(nickOf(a)) + '</a>' +
          '<span>' + esc(relTime(p.createdAt)) + '</span>' +
          '<span>' + num(p.commentCount || 0) + ' 回复</span>' +
          (Number(p.views) > 0 ? '<span>' + num(p.views) + ' 次浏览</span>' : '') +
        '</div>' +
      '</div>' +
      '</div>';
  }

  /* 版块行：小图标 + 名字 + 今日新增 / 总帖数 */
  function boardRowHTML(b) {
    var st = b.stats || {};
    return '<a class="rankrow" href="#/board/' + attr(b.id) + '">' +
      '<span class="text-primary">' + icon(b.icon || 'grid', 14) + '</span>' +
      '<span class="rankrow__title">' + esc(b.name) + '</span>' +
      (Number(st.today) > 0 ? '<span class="badge badge--success">+' + num(st.today) + '</span>' : '') +
      '<span class="rankrow__value">' + num(st.posts || 0) + '</span>' +
      '</a>';
  }

  function hotRowHTML(p, i) {
    return '<a class="rankrow" href="#/post/' + attr(p.id) + '">' +
      '<span class="rankrow__no' + (i < 3 ? ' rankrow__no--top' : '') + '">' + (i + 1) + '</span>' +
      '<span class="rankrow__title" title="' + attr(p.title) + '">' + esc(p.title) + '</span>' +
      '<span class="rankrow__value">' + num(p.likes || 0) + '</span>' +
      '</a>';
  }

  function noticeRowHTML(n) {
    var tone = LEVEL_TONE[n.level] || 'info';
    var flag = LEVEL_TEXT[n.level];
    return '<a class="noticerow" data-level="' + attr(n.level || 'info') + '" href="#/notice/' + attr(n.id) + '">' +
      (flag ? badge(flag, tone) : '') +
      (n.top ? badge('置顶', 'pinned') : '') +
      '<span class="noticerow__title">' + esc(n.title) + '</span>' +
      '<span class="noticerow__time">' + esc(relTime(n.createdAt)) + '</span>' +
      '</a>';
  }

  function tagCloudHTML(tags) {
    if (!tags || !tags.length) return '<div class="empty--plain">还没有人打标签</div>';
    return '<div class="tagcloud">' + tags.map(function (t) {
      return '<a class="tagchip" href="#/search?q=' + encodeURIComponent(t.tag) + '">' + esc(t.tag) +
        '<span class="tagchip__count">' + num(t.count) + '</span></a>';
    }).join('') + '</div>';
  }

  function blockHTML(o) {
    return '<section class="block' + (o.cls ? ' ' + o.cls : '') + '">' +
      '<div class="block__head">' +
        '<h2 class="block__title">' + (o.icon ? icon(o.icon, 15) : '') + esc(o.title) + '</h2>' +
        (o.more ? '<a class="block__more" href="' + attr(o.more.href) + '">' + esc(o.more.text) + '</a>' : '') +
      '</div>' +
      '<div class="block__body">' + o.body + '</div>' +
      '</section>';
  }

  function formError(form, msg) {
    if (!form || !form.querySelector) return;
    var box = form.querySelector('[data-form-error]');
    if (!box) return;
    box.classList.toggle('is-hidden', !msg);
    box.innerHTML = msg ? icon('alert', 13) + '<span>' + esc(msg) + '</span>' : '';
  }
  /* 校验失败：内联提示 + toast 双通道（§11.1.4） */
  function fail(form, msg) { formError(form, msg); toast(msg, 'error'); }

  function safeRedirect(raw) {
    var r = String(raw == null ? '' : raw).trim();
    if (!r || r.charAt(0) !== '/') return '';
    if (r.indexOf('//') === 0) return '';
    if (r === '/login' || r === '/register' || r === '/forgot') return '';
    return r;
  }

  /* ======================================================================
     3 · 首页：站点说明条 + 统计条 + 两栏信息流
     ====================================================================== */
  /* 站点说明条。手机上不渲染内联搜索：顶栏已有搜索图标（.iconbtn--search → #/search），
     再来一个满宽输入框 + 按钮会把首屏帖子挤出屏幕。 */
  function bbsHeadHTML(st, q, phone) {
    var search = phone ? '' :
      '<form class="bbs-head__search" data-action="home.search" role="search" novalidate>' +
        '<input class="input" name="q" type="search" value="' + attr(q) + '" ' +
          'placeholder="搜帖子、版块、同学" aria-label="站内搜索">' +
        '<button class="btn" type="submit">搜索</button>' +
      '</form>';
    return '<div class="bbs-head">' +
      '<div>' +
        '<div class="bbs-head__title">' + esc(st.siteName || '天府师大一中·校园论坛') + '</div>' +
        '<div class="bbs-head__desc">初中部同学自己的论坛。发帖问事、回帖搭话、找失物、找资料都行。</div>' +
      '</div>' +
      search +
      '</div>';
  }

  /* 统计条。窄屏下 components.css 把每格固定成 flex: 1 1 50%（原本是 2x2 大卡的写法），
     所以：手机上留 2 格 = 正好一行；3 格会断成「2 + 1」（第三格独占一整行）。
     桌面/平板仍是 4 格。 */
  function bbsStatsHTML(counts, userTotal, boardTotal, phone) {
    function item(v, label) {
      return '<div class="bbs-stats__item">' +
        '<div class="bbs-stats__value">' + v + '</div>' +
        '<div class="bbs-stats__label">' + label + '</div>' +
        '</div>';
    }
    var cells = phone
      ? [item(num(counts.total || 0), '帖子'), item(num(counts.today || 0), '今天新帖')]
      : [
        item(num(counts.total || 0), '帖子'),
        item(num(userTotal || 0), '成员'),
        item(num(counts.today || 0), '今天新帖'),
        item(num(boardTotal || 0), '版块')
      ];
    return '<div class="bbs-stats">' + cells.join('') + '</div>';
  }

  /* 校外访客首页：看不到任何帖子，只有「去娱乐中心」和「去认证」两条路 */
  function visitorHomeHTML(user) {
    var status = ST().studentStatus ? ST().studentStatus() : 'external';
    var pending = status === 'pending';
    return '<div class="page" data-page="home">' +
      '<div class="card card--pad mt-4" data-visitor-home>' +
        '<div class="cluster gap-2">' +
          '<span class="badge badge--warn">校外访客</span>' +
          '<span class="text-sm text-2">你好，' + esc(user.nickname || user.username) + '</span>' +
        '</div>' +
        '<h1 class="mt-2">论坛内容需要学生身份认证</h1>' +
        '<p class="text-2" style="max-width:640px;line-height:1.8">' +
          '为了防止校外人员乱发帖、保护同学隐私，现在<b>看帖、发帖、评论</b>都要先证明你是本校学生。' +
          '正在审核的用户也一样，审核通过后自动解锁。' +
        '</p>' +
        '<div class="noticebar mt-3">' + icon('cards', 15) +
          '<span><b>娱乐中心现在就能玩</b>：五子棋、国际象棋、中国象棋、斗地主、UNO、麻将，不用认证。</span></div>' +
        '<div class="gacts mt-4" style="display:flex;gap:10px;flex-wrap:wrap">' +
          '<a class="btn btn--primary" href="#/games">' + icon('sparkle', 16) + ' 去娱乐中心</a>' +
          (pending
            ? '<a class="btn btn--ghost" href="#/verify">' + icon('shield', 16) + ' 查看认证进度（审核中）</a>'
            : '<a class="btn btn--ghost" href="#/verify">' + icon('shield', 16) + ' 认证学生身份</a>') +
        '</div>' +
        '<div class="divider"></div>' +
        '<h3>怎么认证？</h3>' +
        '<ol class="text-2" style="line-height:2;padding-left:22px">' +
          '<li>拍一张<b>校卡照片</b>（只拍校卡就行，<b>不用露脸</b>，把姓名/班级那面拍清楚即可）</li>' +
          '<li>在认证页上传，可以顺手填真实姓名和班级（只有管理员看得到）</li>' +
          '<li>管理员在后台审核，通过后就能看帖、发帖、评论了</li>' +
        '</ol>' +
        '<p class="text-xs text-muted mt-2">校卡照片只保存在学校服务器上，只有管理员审核时能看到，不会公开。</p>' +
      '</div>' +
    '</div>';
  }

  function renderHome() {
    var st = siteSettings();
    var user = currentUser();
    /* 校外访客：看不到论坛内容，走专门的访客首页 */
    var verified = !user || (ST().isVerified ? ST().isVerified() : true);
    if (user && !verified) return { html: visitorHomeHTML(user), title: '首页' };
    var counts = siteCounts();
    var boards = boardList();
    var users = userList({ sort: 'new', size: 60 });
    var notices = noticeList(3);
    var feed = postList({ sort: 'latest', size: 12 });
    var hot = hotList(10);

    /* 主栏：最新帖子信息流 */
    var feedBody;
    if (!(feed.list || []).length) {
      /* 空站：只留一句话；登录后给一个发帖入口，未登录不写第二句（站名条已经说明过了） */
      feedBody = '<div class="empty--plain">还没有帖子' +
        (user ? '<div class="mt-2"><a class="btn btn--sm btn--primary" href="#/new">发第一帖</a></div>' : '') +
        '</div>';
    } else {
      feedBody = (feed.list || []).map(postRowHTML).join('');
    }
    var main = blockHTML({
      cls: 'block--box block--flush',
      title: '最新帖子',
      more: { href: '#/forum', text: '全部版块' },
      body: feedBody
    });

    /* 侧栏 1：公告（静态 2~3 条，不做轮播） */
    var noticeBody = notices.length
      ? '<div class="noticelist">' + notices.map(noticeRowHTML).join('') + '</div>'
      : '<div class="empty--plain">暂时没有公告</div>';
    var sideNotices = blockHTML({
      cls: 'block--box',
      title: '校园公告',
      icon: 'megaphone',
      more: { href: '#/notices', text: '全部' },
      body: noticeBody
    });

    /* 侧栏 2：版块 */
    var boardBody = boards.length
      ? boards.map(boardRowHTML).join('')
      : '<div class="empty--plain">还没有版块</div>';
    var sideBoards = blockHTML({
      cls: 'block--box',
      title: '版块',
      icon: 'grid',
      more: { href: '#/forum', text: '总览' },
      body: boardBody
    });

    /* 侧栏 3：今日热帖 */
    var hotBody = hot.length
      ? '<div class="ranklist">' + hot.map(hotRowHTML).join('') + '</div>'
      : '<div class="empty--plain">今天还没有热帖</div>';
    var sideHot = blockHTML({
      cls: 'block--box',
      title: '今日热帖',
      icon: 'fire',
      body: hotBody
    });

    /* 侧栏 4：热门标签（没有标签时整块不渲染，避免只剩标题的空框） */
    var sideTags = (counts.tags && counts.tags.length)
      ? blockHTML({
        cls: 'block--box',
        title: '热门标签',
        icon: 'tag',
        body: tagCloudHTML(counts.tags)
      })
      : '';

    var announce = st.announcement
      ? '<div class="noticebar mb-3">' + icon('megaphone', 15) +
        '<b>站内通知</b><span class="truncate">' + esc(st.announcement) + '</span></div>'
      : '';

    var phone = isPhone();
    var html = '<div class="page" data-page="home">' +
      announce +
      bbsHeadHTML(st, String(query().q || ''), phone) +
      '<div class="mt-3">' + bbsStatsHTML(counts, users.total, boards.length, phone) + '</div>' +
      '<div class="cols mt-4">' +
        '<div class="col-main">' + main + '</div>' +
        '<aside class="col-side">' +
          '<div class="stack gap-4">' + sideNotices + sideBoards + sideHot + sideTags + '</div>' +
        '</aside>' +
      '</div>' +
      '</div>';

    return { html: html, onMount: mountHomeResponsive, title: '首页' };
  }

  /* 手机↔桌面/平板切换（旋转、拖窗口）后重渲染一次，让顶部件与统计条跟着断点变。
     只在真正跨过断点时刷新，平时不打扰；app.js 会在下次渲染前调用返回的清理函数。 */
  function mountHomeResponsive() {
    if (typeof window === 'undefined' || !window.addEventListener) return;
    var wasPhone = isPhone();
    var timer = null;
    function onResize() {
      if (timer) clearTimeout(timer);
      timer = setTimeout(function () {
        timer = null;
        var now = isPhone();
        if (now !== wasPhone) {
          wasPhone = now;
          if (TF.app && TF.app.refresh) TF.app.refresh();
        }
      }, 180);
    }
    window.addEventListener('resize', onResize, false);
    window.addEventListener('orientationchange', onResize, false);
    return function () {
      if (timer) { clearTimeout(timer); timer = null; }
      window.removeEventListener('resize', onResize, false);
      window.removeEventListener('orientationchange', onResize, false);
    };
  }

  /* ======================================================================
     4 · 登录
     ====================================================================== */
  var lastUsername = '';

  /* 说明：站点改成服务器 + SQLite 真源，没有演示账号，登录页不再提供「一键填充」。
     账号只能自己注册；第一个注册的人会成为超级管理员（服务端判定）。 */

  /* 已登录时访问这三个游客页：保留该页自己的 data-page，只换内容（§7 页面名映射） */
