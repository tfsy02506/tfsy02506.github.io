      '<span class="pwstrength__bar"></span><span class="pwstrength__bar"></span>' +
      '</div>' +
      '<div class="field__hint" data-pw-hint>' + PW_TEXT[0] + '</div>';
  }
  function paintStrength(form) {
    if (!form || !form.querySelector) return 0;
    var box = form.querySelector('[data-pwstrength]');
    var pw = form.querySelector('input[name="password"]');
    var hint = form.querySelector('[data-pw-hint]');
    if (!box || !pw) return 0;
    var s = pwScore(pw.value);
    var cls = ['', 'is-weak', 'is-fair', 'is-good', 'is-strong'][s] || '';
    var bars = box.querySelectorAll('.pwstrength__bar');
    for (var i = 0; i < bars.length; i++) {
      bars[i].className = 'pwstrength__bar' + (i < s && cls ? ' ' + cls : '');
    }
    setHint(hint, PW_TEXT[s] || PW_TEXT[0], s === 0 ? '' : s <= 2 ? 'danger' : s === 3 ? 'warn' : 'success');
    return s;
  }

