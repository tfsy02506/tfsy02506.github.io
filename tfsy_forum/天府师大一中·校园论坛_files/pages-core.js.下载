    1: '太短了',
    2: '偏弱，再长一点',
    3: '还行',
    4: '挺结实'
  };
  function pwScore(v) {
    v = String(v == null ? '' : v);
    if (!v) return 0;
    if (v.length < 6) return 1;
    var s = 1;
    if (v.length >= 10) s += 1;
    if (/[A-Za-z]/.test(v) && /[0-9]/.test(v)) s += 1;
    if (/[^A-Za-z0-9]/.test(v)) s += 1;
    return Math.min(4, s);
  }
  function setHint(el, text, tone) {
    if (!el) return;
    el.textContent = text || '';
