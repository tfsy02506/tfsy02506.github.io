  function onStudentSubmit(ctx) {
    if (!isSubmit(ctx)) return;
    var form = ctx.form;
    var input = form.querySelector ? form.querySelector('input[name="card"]') : null;
    var file = input && input.files && input.files[0];
    if (!file) { fail(form, '先选一张校卡照片'); return; }
    if (!/^image\//i.test(file.type || '')) { fail(form, '只能传图片（jpg/png/webp/gif），也可以截图再传'); return; }
    if (file.size > 15 * 1024 * 1024) { fail(form, '图片超过 15MB，压缩一下或截图再传'); return; }
    var v = ctx.values();
    var btn = form.querySelector ? form.querySelector('button[type="submit"]') : null;
    if (btn) { btn.disabled = true; btn.textContent = '提交中…'; }
    formError(form, '');
    var api = TF.api;
    if (!api || !api.student || !api.student.submit) { fail(form, '页面还没准备好，刷新一下再试'); if (btn) { btn.disabled = false; } return; }
    api.student.submit(file, { realName: String(v.realName || '').trim(), klass: String(v.klass || '').trim() })
      .then(function () {
        toast('已提交，等管理员审核', 'success');
        refreshUser();
        go('/verify');
      }, function (e) {
        if (btn) { btn.disabled = false; btn.textContent = '提交认证材料'; }
        fail(form, (e && e.message) || '提交失败，稍后再试');
      });
  }

