  function mountRegister(root) {
    if (!root || !root.querySelector) return;
    var form = root.querySelector('form[data-action="auth.register"]');
    if (!form) return;

    var unameInput = form.querySelector('input[name="username"]');
    var unameWrap = form.querySelector('[data-uname-field]');
    var unameHint = unameWrap ? unameWrap.querySelector('.field__hint') : null;
    var checkName = debounce(function () {
      var v = String(unameInput.value || '').trim();
      if (!v) { setHint(unameHint, '3-16 位，只能用字母、数字和下划线', ''); return; }
      if (!/^[a-zA-Z0-9_]{3,16}$/.test(v)) {
        setHint(unameHint, '用户名 3-16 位，只能用字母、数字和下划线', 'danger');
        return;
      }
      if (findByUsername(v)) setHint(unameHint, '「' + v + '」有人用了', 'danger');
      else setHint(unameHint, '「' + v + '」可以用', 'success');
    }, 320);
    if (unameInput && unameInput.addEventListener) unameInput.addEventListener('input', checkName, false);

    var pwInput = form.querySelector('input[name="password"]');
    if (pwInput && pwInput.addEventListener) {
      pwInput.addEventListener('input', function () { paintStrength(form); }, false);
    }

    var agree = form.querySelector('input[name="agree"]');
    if (agree && agree.addEventListener) {
      agree.addEventListener('change', function () {
        if (!agree.checked) return;
        var box = form.querySelector('[data-agree-error]');
        if (box) { box.classList.add('is-hidden'); box.innerHTML = ''; }
      }, false);
    }
  }

