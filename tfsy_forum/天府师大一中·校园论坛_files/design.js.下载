    var input = box ? box.querySelector('input') : null;
    if (!input) return;
    var show = input.type === 'password';
    input.type = show ? 'text' : 'password';
    btn.innerHTML = icon(show ? 'eyeOff' : 'eye', 16);
    btn.setAttribute('aria-label', show ? '隐藏密码' : '显示密码');
  }
  function doCopy(text) {
    var p = (TF.util && TF.util.copy) ? TF.util.copy(text) : Promise.reject(new Error('no copy'));
    Promise.resolve(p).then(function (ok) {
      toast(ok ? '复制好了' : '复制不了，手动选一下', ok ? 'success' : 'error');
    }).catch(function () { toast('复制不了，手动选一下', 'error'); });
  }
  function gotoPage(el) {
    var p = toNum(el.getAttribute('data-goto'));
    var nav = el.closest('.pagination');
    var detail = { page: p, el: el };
    if (nav) {
      var active = nav.querySelector('.pagination__item.is-active');
      if (active) active.classList.remove('is-active');
      if (el.classList.contains('pagination__item')) el.classList.add('is-active');
      try { nav.dispatchEvent(new CustomEvent('tf:page', { bubbles: true, detail: detail })); } catch (e) {}
    }
  }
  function handleUpload(input) {
    var scope = input.closest('[data-upload-scope]') || input.closest('.upload') || input.parentNode || document;
    var preview = scope.querySelector ? scope.querySelector('.upload__preview') : null;
    var files = input.files;
    if (!files || !files.length) return;
    var jobs = [], urls = [];
    Array.prototype.forEach.call(files, function (f) {
      var p = (TF.util && TF.util.fileToDataUrl) ? TF.util.fileToDataUrl(f) : Promise.resolve('');
      jobs.push(Promise.resolve(p).then(function (url) {
        if (!url) return;
        urls.push(url);
        if (preview) {
          var item = document.createElement('span');
          item.className = 'upload__item';
          var img = document.createElement('img');
          img.src = url;
          img.alt = '已选图片预览';
          item.appendChild(img);
          preview.appendChild(item);
        }
      }).catch(function () {}));
    });
    Promise.all(jobs).then(function () {
      try { input.dispatchEvent(new CustomEvent('tf:files', { bubbles: true, detail: { files: urls, input: input } })); } catch (e) {}
    });
  }
  /* —— tooltip —— */
  var tipEl = null, tipTarget = null;
  function showTip(el) {
    var text = el.getAttribute('data-tip');
    if (!text) return;
    if (!tipEl) {
      tipEl = document.createElement('span');
      tipEl.className = 'tip';
      tipEl.setAttribute('role', 'tooltip');
      document.body.appendChild(tipEl);
    }
    tipTarget = el;
    tipEl.textContent = text;
    tipEl.classList.add('is-open');
    var r = el.getBoundingClientRect(), tr = tipEl.getBoundingClientRect();
    var top = r.top - tr.height - 9;
    if (top < 6) top = r.bottom + 9;
    var left = Math.max(8, Math.min(r.left + r.width / 2 - tr.width / 2, window.innerWidth - tr.width - 8));
    tipEl.style.top = Math.round(top) + 'px';
    tipEl.style.left = Math.round(left) + 'px';
  }
  function hideTip() {
    tipTarget = null;
    if (tipEl) tipEl.classList.remove('is-open');
  }
  function bindOnce() {
    if (docBound || !document.addEventListener) return;
    docBound = true;
    document.addEventListener('click', onDocClick, false);
    document.addEventListener('change', onDocChange, false);
    document.addEventListener('mouseover', onDocOver, true);
    document.addEventListener('mouseout', onDocOut, true);
    document.addEventListener('focusin', onDocOver, true);
    document.addEventListener('focusout', onDocOut, true);
    document.addEventListener('keydown', function (ev) {
      if (ev.key === 'Escape' && openStack.length) closeOverlay(openStack[openStack.length - 1]);
    }, false);
    window.addEventListener('scroll', hideTip, true);
    window.addEventListener('resize', hideTip, false);
  }
  function onDocClick(ev) {
    var t = ev.target;
    if (!t || !t.closest) return;
    var el;
    el = t.closest('[data-modal-open]');
    if (el) { modal.open(el.getAttribute('data-modal-open') || el.getAttribute('data-modal-open-id') || ''); return; }
    el = t.closest('[data-modal-close],[data-overlay-close],[data-drawer-close]');
    if (el) { closeOverlay(el.closest('.overlay')); return; }
    el = t.closest('[data-pw-toggle]');
    if (el) { togglePw(el); return; }
    el = t.closest('[data-copy]');
    if (el) { doCopy(el.getAttribute('data-copy') || ''); return; }
    el = t.closest('[data-tab]');
    if (el && el.closest('[data-tabs]')) { activateTab(el); return; }
    el = t.closest('[data-sidebar-toggle]');
    if (el) { toggleSidebar(); return; }
    el = t.closest('[data-goto]');
    if (el) { gotoPage(el); return; }
    el = t.closest('[data-upload]');
    if (el) {
      var inp = el.tagName === 'INPUT' ? el : el.querySelector('input[type=file]');
      if (inp && t !== inp) { inp.click(); return; }
    }
    if (t.classList && t.classList.contains('overlay') && t.classList.contains('is-open') && !t.hasAttribute('data-static')) {
      closeOverlay(t);
    }
  }
  function onDocChange(ev) {
    var t = ev.target;
    if (!t || !t.getAttribute) return;
    if (t.type === 'radio') {
      var box = t.closest('.radiocards');
      if (box) syncRadioGroup(box);
    }
    if (t.type === 'checkbox') {
      var sw = t.closest('.switch');
      if (sw) syncSwitch(sw);
      if (t.hasAttribute('data-check-all')) {
        var scope = t.closest('[data-check-scope]') || document;
        var items = qsa(scope, '[data-check-item]');
        for (var i = 0; i < items.length; i++) items[i].checked = t.checked;
      }
      if (t.hasAttribute('data-check-all') || t.hasAttribute('data-check-item')) syncBulk();
    }
    if (t.hasAttribute && t.hasAttribute('data-upload')) handleUpload(t);
  }
  function onDocOver(ev) {
    var t = ev.target;
    var el = (t && t.closest) ? t.closest('[data-tip]') : null;
    if (!el) { if (tipTarget) hideTip(); return; }
    if (tipTarget !== el) showTip(el);
  }
  function onDocOut(ev) {
    var t = ev.target;
    var el = (t && t.closest) ? t.closest('[data-tip]') : null;
    if (!el) return;
    var to = ev.relatedTarget;
    if (to && el.contains(to)) return;
    hideTip();
  }

  /* ======================================================================
     9 · 挂载
     ====================================================================== */
  TF.extend('ui', {
    icon: icon,
    avatar: avatar,
    badge: badge,
    button: button,
    field: field,
    textarea: textarea,
    selectField: selectField,
    checkField: checkField,
    radioCards: radioCards,
    tabs: tabs,
    empty: empty,
    skeleton: skeleton,
    pagination: pagination,
    statCard: statCard,
    chart: chart,
    progress: progress,
    tag: tag,
    userChip: userChip,
    breadcrumb: breadcrumb,
    modal: modal,
    drawer: drawer,
    init: init,
    toast: toast,
    theme: theme,
    scrollTop: scrollTop,
    loading: loading
  });
  /* 便捷别名（非契约必需，供页面少写一层） */
  TF.ui.confirm = modal.confirm;
  TF.ui.iconNames = Object.keys(ICONS);
})();
