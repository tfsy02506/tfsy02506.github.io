      if (!r.ok) return { ok: false, error: r.error };
      var u = (r.data && r.data.user) || null;
      finishAuth(u);
      return { ok: true, user: currentUser() || u };
    }
    if (!online()) return offlineResult();
    api().register(payload).then(function () { adopt(); notifySync('auth'); }, function (e) {
      toast((e && e.error) || '注册没成功', 'error');
    });
    return { ok: true, pending: true };
  }

  function logout() {
    var a = api();
    var r = syncCall('POST', '/auth/logout', {}, '正在退出…');
    if (a) a.user = null;
    if (r && r.ok) { syncAdopt(); adopt(); }
