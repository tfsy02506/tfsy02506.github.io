  function estimateRecipients(payload) {
    var list = snap().users.filter(function (u) { return !u.banned; });
    if (payload.target === 'role') list = list.filter(function (u) { return normRole(u.role) === payload.role; });
    else if (payload.target === 'user') {
      var u = getUser(payload.userId) || findUserByUsername(payload.userId);
      list = u ? [u] : [];
