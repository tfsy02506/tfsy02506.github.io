  function localPwd() {
    var L = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz', D = '23456789';
    function ch(s) { return s.charAt(Math.floor(Math.random() * s.length)); }
    return ch(L) + ch(L) + ch(L) + ch(D) + ch(D) + ch(D) + ch(L) + ch(D);
  }

  function adminBatch(type, ids, action) {
    type = trim(type);
    action = trim(action);
    ids = arr(ids).map(str).filter(Boolean);
    if (!ids.length) return { ok: false, count: 0, error: '先勾上要处理的行' };
    if (!canManage()) return { ok: false, count: 0, error: '没有权限' };
    if (type === 'user' && !isAdmin()) return { ok: false, count: 0, error: '只有超级管理员能管用户' };
    if (action === 'teacher') return { ok: false, count: 0, error: '「老师」这个角色已经不用了，请选版主或学生' };
    var valid = {
      post: ['hide', 'publish', 'pin', 'unpin', 'lock', 'unlock', 'feature', 'unfeature', 'delete'],
      user: ['ban', 'unban', 'mod', 'student', 'admin', 'resetPwd', 'delete'],
      comment: ['hide', 'publish', 'delete'],
      report: ['resolve', 'reject']
    };
    if (!valid[type] || valid[type].indexOf(action) < 0) return { ok: false, count: 0, error: '不支持的操作：' + action };
    var payload = { type: type, ids: ids, action: action };

    /* resetPwd 必须同步拿到新密码（后台要一次性显示 + 复制） */
    if (action === 'resetPwd') {
      var rp = syncCall('POST', '/admin/batch', payload, '正在重置…');
      if (rp) {
        if (!rp.ok) return { ok: false, count: 0, error: rp.error };
        syncAdopt();
        return {
          ok: true, count: round(rp.data && rp.data.count, ids.length) || ids.length,
          pwd: rp.data && rp.data.pwd, pwds: rp.data && rp.data.pwds
        };
      }
    }
    var r = syncCall('POST', '/admin/batch', payload, '正在处理…');
    if (r) {
      if (!r.ok) return { ok: false, count: 0, error: r.error };
      syncAdopt();
      return { ok: true, count: round(r.data && r.data.count, ids.length) || ids.length };
    }
    if (!online()) return { ok: false, count: 0, error: OFFLINE_MSG };

    return optimistic(function () {
      var count = 0;
      ids.forEach(function (id) {
        if (type === 'post') {
          var p = byId(snap().posts, id);
          if (!p) return;
          if (action === 'hide') p.status = 'hidden';
          else if (action === 'publish') p.status = 'published';
          else if (action === 'pin') p.pinned = true;
          else if (action === 'unpin') p.pinned = false;
          else if (action === 'lock') p.locked = true;
          else if (action === 'unlock') p.locked = false;
          else if (action === 'feature') p.featured = true;
          else if (action === 'unfeature') p.featured = false;
          else if (action === 'delete') {
            p.status = 'deleted';
            snap().comments.forEach(function (c) { if (c.postId === id && c.status === 'published') c.status = 'hidden'; });
          }
          count++;
        } else if (type === 'user') {
          var u = byId(snap().users, id);
          if (!u) return;
          if (action === 'ban') { u.banned = true; u.banReason = u.banReason || '违反版规'; }
          else if (action === 'unban') { u.banned = false; u.banReason = ''; }
          else if (action === 'mod' || action === 'student' || action === 'admin') u.role = action;
          else if (action === 'delete') S.users = snap().users.filter(function (x) { return x.id !== id; });
          count++;
        } else if (type === 'comment') {
          var c2 = byId(snap().comments, id);
          if (!c2) return;
          if (action === 'hide') c2.status = 'hidden';
          else if (action === 'publish') c2.status = 'published';
          else if (action === 'delete') c2.status = 'deleted';
          count++;
        } else if (type === 'report') {
          var rep = byId(snap().reports, id);
          if (!rep) return;
          rep.status = action === 'resolve' ? 'resolved' : 'rejected';
          rep.handledBy = meId();
          rep.handledAt = now();
          count++;
        }
      });
      var out = { ok: true, count: count };
      if (action === 'resetPwd') out.pwd = localPwd();
      return out;
    }, function () { return api().post('/admin/batch', payload); }, 'major');
  }

  function adminSetPostStatus(id, status, reason) {
