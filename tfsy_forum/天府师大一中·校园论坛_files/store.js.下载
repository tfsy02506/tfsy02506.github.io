    patch = patch || {};
    var nick = patch.nickname === undefined ? me.nickname : trim(patch.nickname);
    if (nick.length < 2 || nick.length > 16) return { ok: false, error: '昵称 2-16 个字' };
    var payload = {
      nickname: nick,
      bio: patch.bio === undefined ? me.bio : trim(patch.bio).slice(0, 120),
      grade: patch.grade === undefined ? me.grade : trim(patch.grade),
      sex: patch.sex === undefined ? me.sex : trim(patch.sex)
    };
    /* 班级：只允许 1~10 班；改了就传新的，没改但账号里已经有了就带上（服务端对老账号要求必填） */
    if (patch.klass !== undefined) {
      var kl = trim(patch.klass);
      if (!/^([1-9]|10)班$/.test(kl)) return { ok: false, error: '班级请选 1~10 班' };
      payload.klass = kl;
    } else if (trim(me.klass)) {
      payload.klass = trim(me.klass);
    }
    /* 学号：4~12 位数字（只有超管和本人能看到） */
    if (patch.studentNo !== undefined) {
      var sn = trim(patch.studentNo);
      if (!/^\d{4,12}$/.test(sn)) return { ok: false, error: '学号填 4~12 位数字' };
      payload.studentNo = sn;
    } else if (trim(me.studentNo)) {
      payload.studentNo = trim(me.studentNo);
    }
    /* 真实姓名：同上（只有超管和本人能看到） */
    if (patch.realName !== undefined) {
      var rn = trim(patch.realName);
      if (rn.length < 2 || rn.length > 20) return { ok: false, error: '真实姓名要填 2~20 个字' };
      payload.realName = rn;
    } else if (trim(me.realName)) {
      payload.realName = trim(me.realName);
    }
    /* 头像支持三种写法：
     *   avatarUrl: '/uploads/x.png'  上传的图片（页面先 uploadAvatar 拿 url）
     *   avatar:    '/uploads/x.png'  同上（老写法，别再被 Number() 强转成 0）
     *   avatar:    0~7               预设头像
     * 不传就完全不动头像字段（服务端是增量更新）。 */
    if (patch.avatarUrl !== undefined) {
      var au = normAvatarUrl(patch.avatarUrl);
      if (au === null) return { ok: false, error: '头像地址不对' };
      payload.avatarUrl = au;
    } else if (patch.avatar !== undefined) {
      if (typeof patch.avatar === 'string') {
        var s = trim(patch.avatar);
        if (/^\d+$/.test(s)) payload.avatar = Math.max(0, Math.min(7, round(s, 0)));
        else {
          var au2 = normAvatarUrl(s);
          if (au2 === null) return { ok: false, error: '头像地址不对' };
          payload.avatarUrl = au2;
        }
      } else {
        payload.avatar = Math.max(0, Math.min(7, round(patch.avatar, 0)));
      }
    }
    return optimistic(function () {
      var u = getUser(me.id);
      if (u) {
        Object.keys(payload).forEach(function (k) {
          if (k === 'avatarUrl') { u.avatarUrl = payload[k]; return; }
          u[k] = payload[k];
        });
        if (payload.realName) u.hasRealName = true;
      }
      return { ok: true, user: u || me };
    }, function () { return api().put('/me', payload); }, 'major');
  }

  /* 换头像：走服务器上传（POST /api/upload），拿到 /uploads/xxx.png 再 updateProfile({avatarUrl:url})。
   * 返回的是 thenable 结果对象：`await TF.store.uploadAvatar(file)` 或 `.then(function (r) {...})`
   * 都会拿到最终 {ok, url, error}（r.url 与 r.avatarUrl 等价）。 */
  function uploadAvatar(file) {
    var me = currentUser();
    var p = null;
    if (!me) p = Promise.resolve({ ok: false, error: '先登录再换头像' });
    else if (!file) p = Promise.resolve({ ok: false, error: '先选一张图片' });
    else if (!online()) p = Promise.resolve({ ok: false, error: OFFLINE_MSG });
    else {
      var a = api();
      p = (a && a.upload) ? a.upload(file) : Promise.reject(new Error('这个环境不支持上传'));
      p = p.then(function (url) {
        var clean = normAvatarUrl(url);
        if (!clean) throw Object.assign(new Error('上传返回的地址不对，刷新后再试'), { status: 0 });
        return { ok: true, url: clean, avatarUrl: clean, error: '' };
      }, function (e) {
        var msg = (e && (e.error || e.message)) || '上传没成功，换张图再试';
        toast(msg, 'error');
        return { ok: false, error: msg, url: '', avatarUrl: '' };
      });
    }
    var out = { ok: true, pending: true, url: '', avatarUrl: '', error: '' };
    out.then = function (onOk, onErr) {
      return p.then(function (r) {
        out.ok = r.ok; out.url = r.url || ''; out.avatarUrl = r.avatarUrl || ''; out.error = r.error || '';
        out.pending = false;
        /* 注意：必须 resolve 一个普通对象，不能把 out（thenable）自己交出去，
           否则 await 会反复同化它 → 死循环 */
        var plain = { ok: out.ok, url: out.url, avatarUrl: out.avatarUrl, error: out.error };
        return onOk ? onOk(plain) : plain;
      }, onErr);
    };
    out.catch = function (fn) { return p.then(null, fn); };
    return out;
  }

  function listUsers(o) {
    o = o || {};
    var kw = trim(o.keyword), role = trim(o.role), status = trim(o.status);
    var list = snap().users.filter(function (u) {
      if (role && normRole(u.role) !== role) return false;
      if (status === 'banned' && !u.banned) return false;
      if ((status === 'active' || status === 'normal') && u.banned) return false;
      if (kw && !(kwMatch(u.username, kw) || kwMatch(u.nickname, kw) || kwMatch(u.grade, kw) || kwMatch(u.klass, kw) || kwMatch(u.bio, kw))) return false;
      return true;
    });
    var sort = trim(o.sort) || 'points';
    list.sort(function (a, b) {
      if (sort === 'new') return round(b.createdAt, 0) - round(a.createdAt, 0);
      if (sort === 'posts') return round(b.stats.posts, 0) - round(a.stats.posts, 0);
      if (sort === 'name') return str(a.username) < str(b.username) ? -1 : 1;
      if (sort === 'active') return round(b.lastLoginAt, 0) - round(a.lastLoginAt, 0);
      return round(b.points, 0) - round(a.points, 0);
    });
    return paginate(list, o.page, o.size === undefined ? 20 : o.size);
  }

  /* ------------------------------------------------------------------ 版块 */
  function listBoards() {
    return snap().boards.slice().sort(function (a, b) {
      var d = round(a.order, 99) - round(b.order, 99);
      if (d) return d;
      return str(a.group) < str(b.group) ? -1 : (str(a.group) > str(b.group) ? 1 : 0);
    });
  }
  function getBoard(id) { return byId(snap().boards, id); }

  function boardFeed(boardId) {
    var b = getBoard(boardId);
    if (!b) return { board: null, posts: [], hotTags: [] };
    var list = snap().posts.filter(function (p) { return p.boardId === b.id && p.status === 'published'; });
    list.sort(function (a, c) {
      if (!!c.pinned !== !!a.pinned) return c.pinned ? 1 : -1;
      return round(c.lastReplyAt, round(c.createdAt, 0)) - round(a.lastReplyAt, round(a.createdAt, 0));
    });
    var tags = {};
    list.forEach(function (p) { arr(p.tags).forEach(function (t) { tags[t] = (tags[t] || 0) + 1; }); });
    var hotTags = Object.keys(tags).map(function (t) { return { tag: t, count: tags[t] }; })
      .sort(function (x, y) { return y.count - x.count; }).slice(0, 10);
    return { board: b, posts: list.slice(0, 60), hotTags: hotTags };
  }

  function saveBoard(data) {
    data = data || {};
    var name = trim(data.name);
    if (!name) return { ok: false, error: '版块名不能空着' };
    if (name.length > 12) return { ok: false, error: '版块名最多 12 个字' };
    if (!canManage()) return { ok: false, error: '只有版主和管理员能改版块' };
    var r = syncCall('POST', '/admin/save', { type: 'board', data: data }, '正在保存…');
    if (r) {
      if (!r.ok) return { ok: false, error: r.error };
      syncAdopt();
      var item = (r.data && (r.data.item || r.data.board)) || null;
      return { ok: true, board: item ? api().norm.board(item) : getBoard(data.id) };
    }
    if (!online()) return offlineResult();
    return optimistic(function () {
      var b = data.id ? getBoard(data.id) : null;
      if (b) {
        ['name', 'desc', 'icon', 'group', 'minRole'].forEach(function (k) { if (data[k] !== undefined) b[k] = trim(data[k]) || b[k]; });
        if (data.order !== undefined) b.order = round(data.order, b.order);
        if (data.locked !== undefined) b.locked = !!data.locked;
      } else {
        b = {
          id: 'tmp-b' + now().toString(36), slug: '', name: name, desc: trim(data.desc),
          icon: trim(data.icon) || 'comment', color: round(data.color, 0), group: trim(data.group) || '校园',
          order: round(data.order, snap().boards.length + 1), minRole: trim(data.minRole) || 'student',
          locked: !!data.locked, stats: { posts: 0, today: 0, followers: 0 }, createdAt: now()
        };
        snap().boards.push(b);
      }
      return { ok: true, board: b };
    }, function () { return api().post('/admin/save', { type: 'board', data: data }); }, 'major');
  }

  function deleteBoard(id) {
    var b = getBoard(id);
    if (!b) return { ok: false, error: '版块不存在' };
    var n = snap().posts.filter(function (p) { return p.boardId === str(id) && p.status !== 'deleted'; }).length;
    if (n) return { ok: false, error: '「' + b.name + '」里还有 ' + n + ' 篇帖子，先搬走或删掉再删版块' };
    if (!isAdmin()) return { ok: false, error: '只有超级管理员能删版块' };
    var r = syncCall('POST', '/admin/delete', { type: 'board', id: str(id) }, '正在删除…');
    if (r) {
      if (!r.ok) return { ok: false, error: r.error };
      syncAdopt();
      return { ok: true };
    }
    if (!online()) return offlineResult();
    return optimistic(function () {
      S.boards = snap().boards.filter(function (x) { return x.id !== str(id); });
      return { ok: true };
    }, function () { return api().post('/admin/delete', { type: 'board', id: str(id) }); }, 'major');
  }

  function ensureBoard(name) {
    var n = trim(name);
    if (!n) return '';
    var hit = snap().boards.filter(function (b) { return b.name === n; })[0];
    if (hit) return hit.id;
    var r = saveBoard({ name: n, desc: '新开的版块，还没写简介', icon: 'comment', group: '校园' });
    return r.ok && r.board ? r.board.id : '';
  }

  /* ------------------------------------------------------------------ 帖子 */
  function score(p) {
    return round(p.likes, 0) * 4 + round(p.commentCount, 0) * 6 + Math.round(round(p.views, 0) / 8) + (p.featured ? 20 : 0);
  }

  function listPosts(o) {
    o = o || {};
    var status = o.status === undefined ? 'published' : trim(o.status);
    var includeAll = status === '' || status === 'all';
    var includeDeleted = !!o.includeDeleted;
    var list = snap().posts.filter(function (p) {
      if (p.status === 'deleted') { if (!includeDeleted) return false; }
      else if (!includeAll && p.status !== status) return false;
      if (o.boardId && p.boardId !== str(o.boardId)) return false;
      if (o.authorId && p.authorId !== str(o.authorId)) return false;
      if (o.tag && arr(p.tags).indexOf(o.tag) < 0) return false;
      if (o.keyword) {
        var kw = o.keyword;
        if (!(kwMatch(p.title, kw) || kwMatch(p.content, kw) || arr(p.tags).join(' ').toLowerCase().indexOf(str(kw).toLowerCase()) >= 0)) return false;
      }
      return true;
    });
    var sort = trim(o.sort) || 'latest';
    if (sort === 'essence') list = list.filter(function (p) { return p.featured; });
    if (sort === 'unanswered') list = list.filter(function (p) { return round(p.commentCount, 0) === 0; });
    list.sort(function (a, b) {
      if (sort === 'hot') return score(b) - score(a);
      if (sort === 'essence' || sort === 'unanswered') return round(b.createdAt, 0) - round(a.createdAt, 0);
      if (!!b.pinned !== !!a.pinned) return b.pinned ? 1 : -1;
      return round(b.lastReplyAt, round(b.createdAt, 0)) - round(a.lastReplyAt, round(a.createdAt, 0));
    });
    return paginate(list, o.page, o.size === undefined ? 12 : o.size);
  }

  /* 阅读计数由服务端负责：首次访问某帖时同步取一次详情（也顺带刷新技术字段） */
  function getPost(id, opts) {
    opts = opts || {};
    var key = str(id);
    if (!key) return null;
    var wantView = opts.view !== false && !viewSeen[key];
    if (wantView) {
      viewSeen[key] = 1;
      var r = syncCall('GET', '/posts/' + encodeURIComponent(key), null, '');
      if (r && r.ok) {
        var raw = (r.data && (r.data.post || r.data)) || null;
        var remote = raw && raw.id !== undefined && api().norm ? api().norm.post(raw) : null;
        if (remote) {
          var i = -1;
          for (var k = 0; k < snap().posts.length; k++) if (snap().posts[k].id === remote.id) i = k;
          if (i >= 0) snap().posts[i] = remote; else snap().posts.push(remote);
        }
      } else if (!r || r.offline) {
        var a = api();
        if (a && a.get && online()) {
          a.get('/posts/' + encodeURIComponent(key)).then(function (data) {
            var raw2 = data && (data.post || data);
            if (!raw2 || raw2.id === undefined || !api().norm) return;
            var remote2 = api().norm.post(raw2);
            var idx = -1;
            for (var m = 0; m < snap().posts.length; m++) if (snap().posts[m].id === remote2.id) idx = m;
            if (idx >= 0) snap().posts[idx] = remote2; else snap().posts.push(remote2);
          }, function () { /* 计数失败不影响阅读 */ });
        }
      }
    }
    return byId(snap().posts, key);
  }

  function counts() {
    var d = new Date(); d.setHours(0, 0, 0, 0);
    var dayStart = d.getTime();
    var total = 0, today = 0, tags = {};
    snap().posts.forEach(function (p) {
      if (p.status !== 'published') return;
      total++;
      if (round(p.createdAt, 0) >= dayStart) today++;
      arr(p.tags).forEach(function (t) { tags[t] = (tags[t] || 0) + 1; });
    });
    var tagList = Object.keys(tags).map(function (t) { return { tag: t, count: tags[t] }; })
      .sort(function (a, b) { return b.count - a.count; }).slice(0, 12);
    return { total: Math.max(total, round(snap().meta && snap().meta.totalPosts, 0)), today: today, tags: tagList };
  }

  function hotPosts(n) {
    n = n === undefined ? 6 : n;
    return snap().posts.filter(function (p) { return p.status === 'published'; })
      .sort(function (a, b) { return score(b) - score(a); }).slice(0, n);
  }
  function featuredPosts(n) {
    n = n === undefined ? 3 : n;
    return snap().posts.filter(function (p) { return p.status === 'published' && p.featured; })
      .sort(function (a, b) { return round(b.createdAt, 0) - round(a.createdAt, 0); }).slice(0, n);
  }

  function normTags(tags) {
    var out = [];
    arr(tags).forEach(function (t) {
      var x = trim(t).replace(/^#/, '').slice(0, 8);
      if (x && out.indexOf(x) < 0 && out.length < 5) out.push(x);
    });
    return out;
  }
  function sensitiveHit(text) {
    var words = getSettings().sensitiveWords || [];
    var s = str(text);
    for (var i = 0; i < words.length; i++) {
      if (words[i] && s.toLowerCase().indexOf(str(words[i]).toLowerCase()) >= 0) return words[i];
    }
    return '';
  }

  /* 给"会造成重复内容"的写操作加防重：**发帖 / 发评论**。
     只在这两处加锁的原因：
       · 用户实测报过"点一次发布 → 帖子发了两篇"，这是必须修的。
       · 其它写操作（保存资料 / 点歌 / 收藏 / 私信）要么是幂等的，要么
         "重复调用"本身就是正常业务（例如同一首歌再点一次应当由服务端
         返回 409 中文提示），加锁反而会把正确的错误提示吞掉。
     重复调用返回一个明确的失败结果：既不会重复写服务器，也不骗调用方。 */
  var inFlight = {};
  function dupGuard(key) {
    if (Object.prototype.hasOwnProperty.call(inFlight, key)) return true;
    inFlight[key] = true;
    setTimeout(function () { delete inFlight[key]; }, 0);
    return false;
  }
  var DUP_KEYS = {
    createPost: function (d) { d = d || {}; return 'post:' + String(d.boardId || '') + ':' + String(d.title || '') + ':' + String(d.content || '').slice(0, 60); },
    addComment: function (d) { d = d || {}; return 'comment:' + String(d.postId || d.post || '') + ':' + String(d.content || '').slice(0, 80); }
  };
  function guardWrites(obj) {
    Object.keys(DUP_KEYS).forEach(function (name) {
      var orig = obj[name];
      if (typeof orig !== 'function') return;
      obj[name] = function (d) {
        if (dupGuard(DUP_KEYS[name](d))) {
          return { ok: false, duplicate: true, error: '刚提交过一次，别重复点' };
        }
        return orig.apply(this, arguments);
      };
    });
  }

  function createPost(d) {
    d = d || {};
    var me = currentUser();
    if (!me) return { ok: false, error: '先登录再发帖' };
    if (me.banned) return { ok: false, error: '账号被封了，先找管理员' };
    var title = trim(d.title), content = trim(d.content);
    if (title.length < 4) return { ok: false, error: '标题至少 4 个字' };
    if (title.length > 60) return { ok: false, error: '标题最多 60 个字' };
    if (content.length < 10) return { ok: false, error: '正文至少 10 个字' };
    var hit = sensitiveHit(title + ' ' + content);
    if (hit) return { ok: false, error: '有敏感词「' + hit + '」，改一下再发' };
    var ck = canPost();
    if (!ck.ok) return { ok: false, error: ck.msg };
    var boardId = trim(d.boardId);
    if (!boardId && trim(d.boardName)) boardId = ensureBoard(d.boardName);
    if (!boardId) return { ok: false, error: '选一个版块' };
    var board = getBoard(boardId);
    if (!board) return { ok: false, error: '这个版块没了，刷新一下' };
    if (board.locked && !canManage()) return { ok: false, error: '「' + board.name + '」是只读版块，只有版主能发' };
    var payload = { boardId: boardId, title: title, content: content, tags: normTags(d.tags), images: arr(d.images).slice(0, 9) };

    /* 防重：同一个人、同一个标题+正文，1.2 秒内只发一次 */
    if (dupGuard('post:' + me.id + ':' + title + '\u0000' + content)) {
      var dup = snap().posts.filter(function (p) { return p.authorId === str(me.id) && p.title === title; })[0];
      return dup ? { ok: true, post: dup, pending: dup.status === 'pending' } : { ok: false, error: '刚发过一次了，别重复点' };
    }

    var r = syncCall('POST', '/posts', payload, '正在发布…');
    if (r) {
      if (!r.ok) return { ok: false, error: r.error };
      var res = syncDone(r, 'major');
      var item = (r.data && (r.data.post || r.data)) || null;
      var post = item && item.id !== undefined && api().norm ? api().norm.post(item) : null;
      if (post) {
        var exist = byId(snap().posts, post.id);
        if (exist) post = exist; else snap().posts.unshift(post);
      } else {
        post = snap().posts.filter(function (p) { return p.authorId === str(me.id); })
          .sort(function (a, b) { return round(b.createdAt, 0) - round(a.createdAt, 0); })[0] || null;
      }
      if (!post) return { ok: false, error: '发出去了，但没读到这篇帖子，刷新一下看看' };
      return { ok: true, post: post, pending: post.status === 'pending' };
    }
    if (!online()) return offlineResult();

    /* 乐观通道：先插到内存，再异步发，失败回滚 */
    var status = getSettings().needAudit && !canManage() ? 'pending' : 'published';
    var ghost = {
      id: 'tmp-p' + now().toString(36), boardId: boardId, authorId: str(me.id), title: title, content: content,
      tags: payload.tags, images: payload.images, createdAt: now(), updatedAt: now(),
      pinned: false, featured: false, locked: false, status: status, rejectReason: '',
      views: 0, likes: 0, favorites: 0, commentCount: 0, lastReplyAt: now(), likedBy: [], favBy: []
    };
    return optimistic(function () {
      snap().posts.unshift(ghost);
      var b = getBoard(boardId);
      if (b && status === 'published') { b.stats.posts = round(b.stats.posts, 0) + 1; b.stats.today = round(b.stats.today, 0) + 1; }
      return { ok: true, post: ghost, pending: status === 'pending' };
    }, function () { return api().post('/posts', payload); }, 'major');
  }

  function updatePost(id, patch) {
    var me = currentUser();
    if (!me) return { ok: false, error: '先登录' };
    var p = byId(snap().posts, id);
    if (!p) return { ok: false, error: '帖子不存在' };
    if (p.authorId !== str(me.id) && !canManage()) return { ok: false, error: '只有作者本人或版主能改' };
    patch = patch || {};
    var title = patch.title === undefined ? p.title : trim(patch.title);
    var content = patch.content === undefined ? p.content : trim(patch.content);
    if (title.length < 4) return { ok: false, error: '标题至少 4 个字' };
    if (content.length < 10) return { ok: false, error: '正文至少 10 个字' };
    var hit = sensitiveHit(title + ' ' + content);
    if (hit) return { ok: false, error: '有敏感词「' + hit + '」，改一下再提交' };
    var payload = {
      title: title, content: content,
      tags: patch.tags === undefined ? p.tags : normTags(patch.tags),
      images: patch.images === undefined ? p.images : arr(patch.images).slice(0, 9),
      boardId: patch.boardId === undefined ? p.boardId : trim(patch.boardId)
    };
    if (!online()) return offlineResult();
    return optimistic(function () {
      var t = byId(snap().posts, id);
      if (t) { Object.keys(payload).forEach(function (k) { t[k] = payload[k]; }); t.updatedAt = now(); }
      return { ok: true, post: t };
    }, function () { return api().put('/posts/' + encodeURIComponent(str(id)), payload); }, 'major');
  }

  function deletePost(id) {
    var me = currentUser();
    if (!me) return { ok: false, error: '先登录' };
    var p = byId(snap().posts, id);
