  /* ------------------------------------------------------------ 每周点歌投票
   * 规则（服务端已生效，前端照抄提示语）：中午 3 首 / 晚上 3 首；每人每天每时段最多 3 票；
   * 同一周同一时段同名同歌手只能点一次；点歌会自动在「听歌点歌」版块生成一篇帖子。
   * 缓存按 slot 各存一份（一周内够用），songsWeek 同步返回缓存 + 后台刷新。 */
  var songCache = {};        // slot -> 归一化后的后端 data（多了 at 字段：最后一次刷新时间）
  var songSubs = [];         // onSongsChange 订阅者
  var songInflight = {};     // 去重：同一 slot 同时只拉一次
  var songSeq = {};          // slot -> 已发出的请求序号
  var songApplied = {};      // slot -> 已落地的最新序号（防止旧响应盖掉新数据）
  var SONG_FRESH_MS = 3000;

  /* 请求序号：后发的赢。写操作（点歌/投票/定歌单）用 claimSongsLocal 直接占住最新，
     这样「投票前发出的那次 GET」回来时不会把票数又抹回去。 */
  function claimSongs(key) {
    songSeq[key] = (songSeq[key] || 0) + 1;
    return songSeq[key];
  }
  function claimSongsLocal(key) {
    songSeq[key] = (songSeq[key] || 0) + 1;
    songApplied[key] = songSeq[key];
    return songSeq[key];
  }
  function acceptSongs(key, my) {
    if (my < (songApplied[key] || 0)) return false;
    songApplied[key] = my;
    return true;
  }

  function normSlot(s) { return trim(s) === 'evening' ? 'evening' : 'noon'; }
  function slotLabel(s) { return normSlot(s) === 'evening' ? '晚上' : '中午'; }

  function emptySongs(slot, week) {
    return {
      weekKey: trim(week), slot: normSlot(slot), list: [], top: [],
      myVotesUsed: 0, votesLeft: 0, limitPerDay: 3, pickCount: 3,
      /* 投稿窗口默认值：开着，但没有截止时间（页面会显示"稍后刷新"而不是空括号） */
      submitOpen: true, submitCloseAt: 0, submitLeftMs: 0, submitEndedEarly: false, closedAt: 0,
      weekStart: 0, weekEnd: 0,
      canManage: canManage(), at: 0, error: ''
    };
  }

  function normSong(s) {
    if (!s || typeof s !== 'object') return null;
    return {
      id: str(s.id), weekKey: str(s.weekKey), slot: normSlot(s.slot),
      title: str(s.title), artist: str(s.artist), link: str(s.link), note: str(s.note),
      userId: str(s.userId), nickname: str(s.nickname),
      votes: round(s.votes, 0), picked: !!s.picked, createdAt: round(s.createdAt, 0),
      dayOfWeek: round(s.dayOfWeek, 0),          /* 0=都行，1~5=周一~周五 */
      postId: str(s.postId), votedByMe: !!s.votedByMe
    };
  }
  function sortSongs(list) {
    return list.slice().sort(function (a, b) {
      if (round(b.votes, 0) !== round(a.votes, 0)) return round(b.votes, 0) - round(a.votes, 0);
      return round(a.createdAt, 0) - round(b.createdAt, 0);
    });
  }
  function normSongsData(d, slot, week) {
    d = d && typeof d === 'object' ? d : {};
    var out = emptySongs(d.slot || slot, d.weekKey || week);
    var list = sortSongs(arr(d.list).map(normSong).filter(Boolean));
    out.weekKey = str(d.weekKey || week);
    out.list = list;
    out.top = arr(d.top).map(normSong).filter(Boolean);
    if (!out.top.length) out.top = list.slice(0, out.pickCount);
    out.myVotesUsed = round(d.myVotesUsed, 0);
    out.votesLeft = round(d.votesLeft, 0);
    out.limitPerDay = round(d.limitPerDay, 3) || 3;
    out.pickCount = round(d.pickCount, 3) || 3;
    out.canManage = d.canManage !== undefined ? !!d.canManage : canManage();
    /* 投稿窗口：周日中午 12:00 截止；管理员可以提前结束。
       这几个字段必须原样带出去，否则页面上的"还剩多久 / 已截止"就是空的。 */
    out.submitOpen = d.submitOpen !== undefined ? !!d.submitOpen : true;
    out.submitCloseAt = round(d.submitCloseAt, 0);
    out.submitLeftMs = round(d.submitLeftMs, 0);
    out.submitEndedEarly = !!d.submitEndedEarly;
    out.closedAt = round(d.closedAt, 0);
    /* 这一轮对应哪个周的周一到周五（页面显示"本周 10月5日–10月9日"） */
    out.weekStart = round(d.weekStart, 0);
    out.weekEnd = round(d.weekEnd, 0);
    out.at = now();
    out.error = '';
    return out;
  }
  function putSongs(slot, data) {
    var key = normSlot(slot);
    songCache[key] = data;
    return songCache[key];
  }
  function putSongsLocal(slot, data) {
    claimSongsLocal(normSlot(slot));
    return putSongs(slot, data);
  }

  function notifySongs(slot, data) {
    var list = songSubs.slice();
    for (var i = 0; i < list.length; i++) {
      try { list[i](slot, data); } catch (e) { /* 订阅者异常不影响主流程 */ }
    }
    if (!list.length) {
      try { if (TF.app && TF.app.refresh) TF.app.refresh(); } catch (e) { /* 忽略 */ }
    }
  }

  /* 后台拉一次（异步，不阻塞渲染）；失败保留旧缓存并打标，避免「失败→重渲染→再拉」死循环 */
  function fetchSongs(slot, week, force, cb) {
    var key = normSlot(slot);
    var hit = songCache[key];
    if (!force && hit && now() - round(hit.at, 0) < SONG_FRESH_MS) return;
    if (songInflight[key]) return;
    var a = api();
    if (!a || !a.songs || !a.songs.get) return;
    songInflight[key] = 1;
    var my = claimSongs(key);
    var p = null;
    try { p = a.songs.get({ slot: key, week: trim(week) }); } catch (e) { p = null; }
    if (!p || !p.then) { songInflight[key] = 0; return; }
    p.then(function (data) {
      songInflight[key] = 0;
      if (!acceptSongs(key, my)) return;        // 期间有更新的数据落地了，丢弃这次旧响应
      var out = putSongs(key, normSongsData(data, key, week));
      notifySongs(key, out);
      if (cb) cb(out);
    }, function (e) {
      songInflight[key] = 0;
      if (my < (songApplied[key] || 0)) return;
      var fallback = songCache[key] || emptySongs(key, week);
      fallback.error = (e && (e.error || e.message)) || '点歌数据没拉到';
      fallback.at = now();                      // 记时间，避免反复重试打转
      putSongs(key, fallback);
      notifySongs(key, fallback);
      if (cb) cb(fallback);
    });
  }

  /* 同步刷一次（点歌成功后立刻要新歌单；浏览器同步通道可用时） */
  function refreshSongsSync(slot, week) {
    var a = api();
    if (!a || !a.songs || !canSync()) return null;
    var key = normSlot(slot);
    var my = claimSongs(key);
    var r = syncCall('GET', '/songs' + a.buildQuery({ slot: key, week: trim(week) }), null, '');
    if (!r || !r.ok) return null;
    if (!acceptSongs(key, my)) return songCache[key] || null;
    return putSongs(key, normSongsData(r.data, key, week));
  }

  /* 读：同步返回缓存（无缓存则空结构），同时在后台刷新一次 */
  function songsWeek(o) {
    o = o || {};
    var key = normSlot(o.slot);
    var week = trim(o.week);
    fetchSongs(key, week, false);
    var hit = songCache[key];
    if (hit && (!week || !hit.weekKey || hit.weekKey === week)) return hit;
    return hit || emptySongs(key, week);
  }

  /* 点歌：同步通道（页面要立刻拿到 song/postId 和中文错误） */
  /* 删一首点歌（管理员及以上；负责该版块的版主也可以）。服务端校验权限。 */
  function deleteSong(id) {
    var a = api();
    if (!a || !a.deleteSong) return { ok: false, error: '这个功能还没上线' };
    var me = currentUser();
    if (!me) return { ok: false, error: '登录之后才能操作' };
    var r = syncCall('DELETE', '/songs/' + encodeURIComponent(str(id)), null, '正在删除…');
    if (r) {
      if (!r.ok) return { ok: false, error: r.error };
      refreshSongsSync('noon', '');
      refreshSongsSync('evening', '');
      syncDone(r, 'major');
      return { ok: true };
    }
    if (!online()) return offlineResult();
    return { ok: false, error: '没删掉，再试一次' };
  }

  /* 管理员 / 版主：提前结束（或重新开放）本周投稿 */
  function closeSongWeek(reopen) {
    var me = currentUser();
    if (!me) return { ok: false, error: '登录之后才能操作' };
    if (!(me.role === 'admin' || me.role === 'mod')) return { ok: false, error: '只有管理员和版主能结束本周投稿' };
    var r = syncCall('POST', '/admin/songs/close', { reopen: !!reopen }, reopen ? '正在重新开放…' : '正在结束投稿…');
    if (r) {
      if (!r.ok) return { ok: false, error: r.error };
      /* 榜单上两个时段都要重拉，因为"是否已结束"是整周共享的 */
      refreshSongsSync('noon', '');
      refreshSongsSync('evening', '');
      syncDone(r, 'minor');
      return { ok: true, closed: !!(r.data && r.data.closed) };
    }
    if (!online()) return offlineResult();
    return { ok: false, error: '没成功，再试一次' };
  }

  /* ============================================================ 当周歌单
   * 排歌单要走外部大模型，可能十几秒，所以**不**放在同步通道里：
   * 页面用 store.generatePlaylist(cb) 拿异步结果。 */
  var playlistCache = { at: 0, week: '', data: null };
  function playlistData() { return playlistCache.data; }
  function refreshPlaylist(cb) {
    var a = api();
    if (!a || !a.playlist || !canSync()) { if (cb) cb(null); return null; }
    a.playlist.get({}).then(function (d) {
      if (d && d.playlist !== undefined) {
        playlistCache = { at: now(), data: d };
        notifySync('songs');
        if (cb) cb(d);
      } else if (cb) cb(null);
    }, function () { if (cb) cb(null); });
    return playlistCache.data;
  }
  function generatePlaylist(opts, cb) {
    var a = api();
    opts = opts || {};
    if (typeof opts === 'function') { cb = opts; opts = {}; }
    if (!a || !a.playlist) { if (cb) cb({ ok: false, error: '这个功能还没上线' }); return; }
    var me = currentUser();
    if (!me) { if (cb) cb({ ok: false, error: '登录之后才能操作' }); return; }
    if (!(me.role === 'admin' || me.role === 'mod')) { if (cb) cb({ ok: false, error: '只有管理员和版主能排歌单' }); return; }
    /* 注意：api-client 会把响应里的 data 解包出来，所以这里拿到的**就是数据本身**
       （{weekKey, playlist, source, model, warn, planned}），不是 {ok,data} 包裹层。 */
    a.playlist.generate('', opts.publish !== false).then(function (d) {
      if (d && d.playlist) {
        playlistCache = { at: now(), data: d };
        notifySync('songs');
      }
      if (cb) cb(d && d.playlist ? d : { ok: false, error: '没排成功' });
    }, function (e) {
      if (cb) cb({ ok: false, error: (e && (e.error || e.message)) || '排歌单失败了（网络或服务器问题）' });
    });
  }
  function publishPlaylist(published, cb) {
    var a = api();
    if (!a || !a.playlist) { if (cb) cb({ ok: false, error: '这个功能还没上线' }); return; }
    a.playlist.publish('', published !== false).then(function (d) {
      if (d && d.playlist) { playlistCache = { at: now(), data: d }; notifySync('songs'); }
      if (cb) cb(d && d.playlist ? d : { ok: false, error: '没成功' });
    }, function (e) { if (cb) cb({ ok: false, error: (e && (e.error || e.message)) || '没成功' }); });
  }

  function addSong(d) {
    d = d || {};
    var me = currentUser();
    if (!me) return { ok: false, error: '登录之后才能点歌' };
    if (me.banned) return { ok: false, error: '账号已被封禁：' + (me.banReason || '违反版规') };
    var key = normSlot(d.slot);
    var title = trim(d.title), artist = trim(d.artist), link = trim(d.link), note = trim(d.note);
    if (!title) return { ok: false, error: '歌名不能为空' };
    if (title.length > 60) return { ok: false, error: '歌名太长了' };
    if (link && !/^https?:\/\//i.test(link)) return { ok: false, error: '链接要以 http 或 https 开头' };
    var day = round(d.day, 0);
    if (day && (day < 1 || day > 5)) return { ok: false, error: '想在哪天放请选周一到周五（或者不选，表示都行）' };
    var payload = { slot: key, title: title, artist: artist, link: link, note: note, day: day };

    var r = syncCall('POST', '/songs', payload, '正在点歌…');
    if (r) {
      if (!r.ok) return { ok: false, error: r.error };
      var song = normSong((r.data || {}).song);
      var postId = str((r.data || {}).postId);
      refreshSongsSync(key, '');
      syncDone(r, 'major');                     // 版块里多了一篇帖子：同步刷新快照，页面立刻能看到
      return { ok: true, song: song, postId: postId };
    }
    if (!online()) return offlineResult();

    /* 乐观通道：先插一首进缓存，异步发，失败回滚 */
    var backup = songCache[key];
    var cur = songsWeekCached(key, '');
    var ghost = {
      id: 'tmp-s' + now().toString(36), weekKey: cur.weekKey, slot: key, title: title, artist: artist,
      link: link, note: note, userId: meId(), nickname: me.nickname || '',
      votes: 0, picked: false, createdAt: now(), postId: '', votedByMe: false
    };
    var list = sortSongs(cur.list.concat([ghost]));
    putSongsLocal(key, Object.assign({}, cur, {
      list: list, top: list.slice(0, round(cur.pickCount, 3) || 3), at: round(cur.at, 0)
    }));
    var a = api();
    if (!a || !a.songs || !a.songs.add) return { ok: true, song: ghost, postId: '' };
    a.songs.add(payload).then(function (data) {
      var real = normSong((data || {}).song);
      var bucket = songCache[key] || emptySongs(key, '');
      var next = bucket.list.filter(function (s) { return s.id !== ghost.id; });
      if (real) next.push(real);
      var sorted = sortSongs(next);
      putSongsLocal(key, Object.assign({}, bucket, {
        list: sorted, top: sorted.slice(0, round(bucket.pickCount, 3) || 3), at: now()
      }));
      notifySongs(key, songCache[key]);
      fetchSongs(key, '', true, null);          // 再补一次服务器数据（票数/剩余票数/真实 postId）
      afterWrite('major');
    }, function (e) {
      songCache[key] = backup || emptySongs(key, '');
      toast((e && e.error) || '点歌没成功，再试一次', 'error');
      notifySongs(key, songCache[key]);
      fetchSongs(key, '', true, null);          // 失败后也跟服务器对齐一次
    });
    return { ok: true, song: ghost, postId: '', pending: true };
  }

  function songsWeekCached(slot, week) {
    var key = normSlot(slot);
    var hit = songCache[key];
    if (hit && (!week || !hit.weekKey || hit.weekKey === week)) return hit;
    return hit || emptySongs(key, week);
  }

  /* 投票：乐观 + 回滚（失败 toast 服务端中文错误，例如「今天这个时段已经投满 3 票了」） */
  function toggleSongVote(id) {
    var me = currentUser();
    if (!me) return { ok: false, error: '登录之后才能投票' };
    var sid = str(id);
    var found = null, key = '';
    Object.keys(songCache).forEach(function (k) {
      if (found) return;
      var b = songCache[k];
      for (var i = 0; i < b.list.length; i++) if (b.list[i].id === sid) { found = b.list[i]; key = k; }
    });
    if (!found) return { ok: false, error: '这首歌不在了' };
    var bucket = songCache[key];
    var backup = bucket;
    var voted = !found.votedByMe;
    var votes = Math.max(0, round(found.votes, 0) + (voted ? 1 : -1));
    var limit = round(bucket.limitPerDay, 3) || 3;
    var left = Math.max(0, Math.min(limit, round(bucket.votesLeft, 0) + (voted ? -1 : 1)));

    function write(v, c, mine) {
      var b = songCache[key] || bucket;
      var list = b.list.map(function (s) { return s.id === sid ? Object.assign({}, s, { votes: v, votedByMe: mine }) : s; });
      var sorted = sortSongs(list);
      putSongsLocal(key, Object.assign({}, b, {
        list: sorted, top: sorted.slice(0, round(b.pickCount, 3) || 3),
        myVotesUsed: Math.max(0, round(b.myVotesUsed, 0) + (mine ? 1 : -1)),
        votesLeft: c, at: b.at
      }));
    }
    write(votes, left, voted);
    var out = { ok: true, voted: voted, votes: votes, votesLeft: left };

    var a = api();
    if (!a || !a.songs || !a.songs.vote) return out;
    a.songs.vote(sid).then(function (data) {
      var song = normSong((data || {}).song);
      var b = songCache[key] || bucket;
      var list = b.list.map(function (s) { return s.id === sid ? (song || Object.assign({}, s, { votes: votes, votedByMe: voted })) : s; });
      var sorted = sortSongs(list);
      putSongsLocal(key, Object.assign({}, b, {
        list: sorted, top: sorted.slice(0, round(b.pickCount, 3) || 3),
        votesLeft: data && data.votesLeft !== undefined ? round(data.votesLeft, left) : left,
        myVotesUsed: b.myVotesUsed,
        at: now()
      }));
      notifySongs(key, songCache[key]);
    }, function (e) {
      putSongsLocal(key, backup);               // 回滚（并占住最新，免得旧响应盖回来）
      toast((e && e.error) || '投票没成功，再试一次', 'error');
      notifySongs(key, songCache[key]);
    });
    return out;
  }

  /* 定歌单：仅版主/超管，同步通道（失败立刻给中文错误） */
  function pickSong(id, picked) {
    if (!canManage()) return { ok: false, error: '只有版主和超管能定歌单' };
    var sid = str(id);
    var body = (picked === true || picked === false) ? { picked: picked } : {};
    var r = syncCall('POST', '/admin/songs/' + encodeURIComponent(sid) + '/pick', body, '正在处理…');
    if (r) {
      if (!r.ok) return { ok: false, error: r.error };
      var song = normSong((r.data || {}).song);
      flipPicked(sid, song);
      return { ok: true, song: song };
    }
    if (!online()) return offlineResult();

    var backupAll = {};
    Object.keys(songCache).forEach(function (k) { backupAll[k] = songCache[k]; });
    flipPicked(sid, null, picked);
    var a = api();
    if (!a || !a.songs || !a.songs.pick) return { ok: true };
    a.songs.pick(sid, picked).then(function (data) {
      flipPicked(sid, normSong((data || {}).song));
    }, function (e) {
      Object.keys(backupAll).forEach(function (k) { songCache[k] = backupAll[k]; });
      toast((e && e.error) || '没定成，再试一次', 'error');
      Object.keys(backupAll).forEach(function (k) { notifySongs(k, songCache[k]); });
    });
    return { ok: true };
  }

  function flipPicked(sid, song, force) {
    Object.keys(songCache).forEach(function (k) {
      var b = songCache[k];
      if (!b.list.some(function (s) { return s.id === sid; })) return;
      var list = b.list.map(function (s) {
        if (s.id !== sid) return s;
        if (song) return song;
        return Object.assign({}, s, { picked: force === undefined ? !s.picked : !!force });
      });
      var sorted = sortSongs(list);
      putSongsLocal(k, Object.assign({}, b, { list: sorted, top: sorted.slice(0, round(b.pickCount, 3) || 3), at: b.at }));
      notifySongs(k, songCache[k]);
    });
  }

  function onSongsChange(cb) { if (typeof cb === 'function') songSubs.push(cb); return songSubs.length; }
  function songsRefresh(o) {
    o = o || {};
    var key = normSlot(o.slot);
    fetchSongs(key, trim(o.week), true, null);
    return songsWeekCached(key, trim(o.week));
  }

  /* ------------------------------------------------------------------ 后台 */
  function cacheGet(key) {
    var hit = adminCache[key];
    if (hit && now() - hit.t < ADMIN_TTL) return hit.v;
    return null;
  }
  function cacheSet(key, v) { adminCache[key] = { t: now(), v: v }; return v; }

  function normItem(type, raw) {
    if (!raw) return null;
    var n = api() && api().norm;
    if (!n) return raw;
    if (type === 'post') return n.post(raw);
    if (type === 'user') return n.user(raw);
    if (type === 'comment') return n.comment(raw);
    if (type === 'board') return n.board(raw);
    if (type === 'notice') return n.notice(raw);
    if (type === 'report') return n.report(raw);
    if (type === 'log') return n.log(raw);
    if (type === 'message') return n.message(raw);
    return raw;
  }
  function normPage(type, data) {
    data = data && typeof data === 'object' ? data : {};
    var list = arr(data.list || data.items || data.rows).map(function (x) { return normItem(type, x); });
    var size = round(data.size, list.length || 15) || 15;
    var total = round(data.total, list.length);
    var page = round(data.page, 1) || 1;
    return { list: list, total: total, page: page, size: size, pages: round(data.pages, Math.max(1, Math.ceil(total / size))) || 1 };
  }

  function serverAdminList(o) {
    var type = trim(o.type) || 'post';
    var q = {
      type: type, keyword: trim(o.keyword), status: trim(o.status), role: trim(o.role),
      boardId: trim(o.boardId), page: round(o.page, 1) || 1,
      size: o.size === undefined ? 15 : round(o.size, 15), sort: trim(o.sort) || 'new'
    };
    var path = type === 'log' ? '/admin/logs' : '/admin/list';
    if (type === 'log') q = { action: trim(o.keyword), actorId: trim(o.actorId), page: q.page, size: q.size };
    var r = syncCall('GET', path + api().buildQuery(q), null, '');
    if (!r || !r.ok) return null;
    return normPage(type, r.data);
  }

  function localAdminList(o) {
    o = o || {};
    var type = trim(o.type) || 'post';
    var kw = trim(o.keyword), status = trim(o.status), role = trim(o.role), boardId = trim(o.boardId);
    var sort = trim(o.sort) || 'new';
    var list = [];
    if (type === 'post') {
      list = snap().posts.filter(function (p) {
        if (status && p.status !== status) return false;
        if (boardId && p.boardId !== boardId) return false;
        if (kw && !(kwMatch(p.title, kw) || kwMatch(p.content, kw))) return false;
        return true;
      });
      list.sort(function (a, b) {
        if (sort === 'hot') return score(b) - score(a);
        if (sort === 'views') return round(b.views, 0) - round(a.views, 0);
        if (sort === 'comments') return round(b.commentCount, 0) - round(a.commentCount, 0);
        return round(b.createdAt, 0) - round(a.createdAt, 0);
      });
    } else if (type === 'user') {
      list = snap().users.filter(function (u) {
        if (role && normRole(u.role) !== role) return false;
        if (status === 'banned' && !u.banned) return false;
        if (status === 'active' && u.banned) return false;
        if (kw && !(kwMatch(u.username, kw) || kwMatch(u.nickname, kw) || kwMatch(u.grade, kw) || kwMatch(u.klass, kw))) return false;
        return true;
      });
      list.sort(function (a, b) {
        if (sort === 'points') return round(b.points, 0) - round(a.points, 0);
        if (sort === 'posts') return round(b.stats.posts, 0) - round(a.stats.posts, 0);
        if (sort === 'active') return round(b.lastLoginAt, 0) - round(a.lastLoginAt, 0);
        if (sort === 'name') return str(a.username) < str(b.username) ? -1 : 1;
        return round(b.createdAt, 0) - round(a.createdAt, 0);
      });
    } else if (type === 'comment') {
      list = snap().comments.filter(function (c) {
        if (status && c.status !== status) return false;
        if (kw && !kwMatch(c.content, kw)) return false;
        return true;
      }).sort(function (a, b) {
        if (sort === 'likes') return round(b.likes, 0) - round(a.likes, 0);
        return round(b.createdAt, 0) - round(a.createdAt, 0);
      });
    } else if (type === 'report') {
      list = snap().reports.filter(function (r) {
        if (status && r.status !== status) return false;
        if (kw && !(kwMatch(r.reason, kw) || kwMatch(r.detail, kw))) return false;
        return true;
      }).sort(function (a, b) { return round(b.createdAt, 0) - round(a.createdAt, 0); });
    } else if (type === 'log') {
      list = snap().logs.filter(function (g) {
        if (kw && !(kwMatch(g.action, kw) || kwMatch(g.detail, kw) || kwMatch(g.target, kw))) return false;
        return true;
      }).sort(function (a, b) { return round(b.createdAt, 0) - round(a.createdAt, 0); });
    } else if (type === 'notice') {
      list = snap().notices.filter(function (n) { return !kw || kwMatch(n.title, kw) || kwMatch(n.content, kw); })
        .sort(function (a, b) { return round(b.createdAt, 0) - round(a.createdAt, 0); });
    } else if (type === 'board') {
      list = snap().boards.filter(function (b) { return !kw || kwMatch(b.name, kw) || kwMatch(b.desc, kw); })
        .sort(function (a, b) { return round(a.order, 99) - round(b.order, 99); });
    } else if (type === 'message') {
      list = snap().notifications.filter(function (m) {
        if (kw && !(kwMatch(m.title, kw) || kwMatch(m.body, kw))) return false;
        if (status && m.type !== status) return false;
        return true;
      }).sort(function (a, b) { return round(b.createdAt, 0) - round(a.createdAt, 0); });
    }
    return paginate(list, o.page, o.size === undefined ? 15 : o.size);
  }

  function adminList(o) {
    o = o || {};
    var type = trim(o.type) || 'post';
    var key = 'list:' + [type, trim(o.keyword), trim(o.status), trim(o.role), trim(o.boardId),
      round(o.page, 1) || 1, o.size === undefined ? 15 : round(o.size, 15), trim(o.sort), trim(o.actorId)].join('|');
    var hit = cacheGet(key);
    if (hit) return hit;
    if (canManage() && canSync()) {
