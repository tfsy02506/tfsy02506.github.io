    var r = syncCall('POST', '/auth/password', { oldPwd: str(oldPwd), newPwd: str(newPwd), newPwd2: str(newPwd2) }, '正在改密码…');
    if (r) return r.ok ? { ok: true } : { ok: false, error: r.error };
