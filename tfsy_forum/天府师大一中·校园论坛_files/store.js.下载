  function adminSave(type, data) {
    type = trim(type);
    data = data || {};
    if (!canManage()) return { ok: false, error: '没有权限' };
    if (type === 'board') {
      var rb = saveBoard(data);
      return rb.ok ? { ok: true, item: rb.board } : rb;
    }
    if (type === 'notice') {
      var rn = saveNotice(data);
      return rn.ok ? { ok: true, item: rn.notice } : rn;
    }
    if (type === 'settings') return saveSettings(data);
    var r = syncCall('POST', '/admin/save', { type: type, data: data }, '正在保存…');
    if (r) {
      if (!r.ok) return { ok: false, error: r.error };
      syncAdopt();
      var item = normItem(type, (r.data && r.data.item) || null);
      if (!item && data.id) item = adminGet(type, data.id);
      return { ok: true, item: item };
    }
    if (!online()) return offlineResult();
    return optimistic(function () {
      var p = data.id ? byId(snap().posts, data.id) : null;
      if (p) {
        ['title', 'content', 'boardId'].forEach(function (k) { if (data[k] !== undefined) p[k] = trim(data[k]); });
        if (data.tags !== undefined) p.tags = normTags(data.tags);
        ['pinned', 'featured', 'locked'].forEach(function (k) { if (data[k] !== undefined) p[k] = !!data[k]; });
        p.updatedAt = now();
        return { ok: true, item: p };
      }
      return { ok: true, item: null };
