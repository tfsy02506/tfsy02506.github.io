  function adminGet(type, id) {
    type = trim(type);
    if (type === 'settings') return getSettings();
    var local = null;
    if (type === 'post') local = byId(snap().posts, id);
    else if (type === 'user') local = byId(snap().users, id);
    else if (type === 'comment') local = byId(snap().comments, id);
    else if (type === 'report') local = byId(snap().reports, id);
    else if (type === 'log') local = byId(snap().logs, id);
    else if (type === 'notice') local = byId(snap().notices, id);
    else if (type === 'board') local = byId(snap().boards, id);
    else if (type === 'message') local = byId(snap().notifications, id);
    if (local) return local;
    if (canManage() && canSync()) {
      var r = syncCall('GET', '/admin/item?type=' + encodeURIComponent(type) + '&id=' + encodeURIComponent(str(id)), null, '');
      if (r && r.ok) {
        var item = normItem(type, (r.data && (r.data.item || r.data)) || null);
        if (item) return item;
      }
    }
    return null;
