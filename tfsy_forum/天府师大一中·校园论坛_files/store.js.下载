/* 天府师大一中·校园论坛 — 数据层 TF.store（服务器真源 + 内存快照）
 *
 * 架构（SERVER-CONTRACT §5）：
 *   - 数据真源是服务器（Node + SQLite）。内存里保存一份快照（TF.api.snapshot），
 *     所有读方法在这份快照上做筛选/排序/分页，同步返回，页面零改动。
 *   - 写方法两条通道：
 *       ① 同步通道（浏览器 + XMLHttpRequest 可用）：callSync 立刻拿到服务端真实结果，
 *          权限错误、重名、间隔限制等中文提示原样返回；成功后顺手拉一次快照。
 *       ② 乐观通道（Node 桩/harness、无 XHR、或刚发生网络失败）：先改内存 → 异步 call →
 *          成功后用服务端快照替换内存，失败回滚 + toast 服务端错误。
 *   - 服务器连不上：online=false，退化成空站但不白屏；写操作直接返回中文错误。
 *   - localStorage 只清理老业务键 tf.forum.v2；业务数据一律以服务器为准。
 *
 * 角色（CONTRACT R5）：student < mod（版主）< admin（超级管理员），teacher 已废除。
 */
(function () {
  'use strict';
  var TF = (window.TF = window.TF || {});
  TF.extend = TF.extend || function (n, o) { TF[n] = Object.assign(TF[n] || {}, o); return TF[n]; };

  var LEGACY_KEY = 'tf.forum.v2';                 // 老的 localStorage 业务键：启动时清掉
  var LEVELS = [0, 50, 150, 350, 700, 1400, 2800];
  var ROLE_RANK = { student: 1, mod: 2, admin: 3 };
  var ROLE_LABEL = { student: '学生', mod: '版主', admin: '超级管理员' };
  var OFFLINE_MSG = '连不上服务器：先运行 node server/index.mjs，再刷新页面';
