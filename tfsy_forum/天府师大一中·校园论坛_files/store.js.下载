  function localStats() {
    var t = now();
    var d = new Date(); d.setHours(0, 0, 0, 0);
    var start = d.getTime();
    var week = t - 7 * 864e5;
    var users = snap().users, posts = snap().posts, comments = snap().comments;
    var livePosts = posts.filter(function (p) { return p.status !== 'deleted'; });
    var liveComments = comments.filter(function (c) { return c.status !== 'deleted'; });
    var visits = {};
    snap().visits.forEach(function (v) { visits[v.date] = v; });
    function keyOf(ts) { return TF.util.dateKey(ts); }
    function inDay(ts, ds) { return round(ts, 0) >= ds && round(ts, 0) < ds + 864e5; }

    var trend = [];
    for (var i = 13; i >= 0; i--) {
      var ds = start - i * 864e5, key = keyOf(ds);
      var v = visits[key] || { pv: 0, uv: 0 };
      trend.push({
        date: key, pv: round(v.pv, 0), uv: round(v.uv, 0),
        posts: livePosts.filter(function (p) { return inDay(p.createdAt, ds); }).length,
        comments: liveComments.filter(function (c) { return inDay(c.createdAt, ds); }).length
      });
    }
    var today = visits[keyOf(t)] || { pv: 0, uv: 0 };
    var tagCount = {};
    livePosts.forEach(function (p) { arr(p.tags).forEach(function (x) { tagCount[x] = (tagCount[x] || 0) + 1; }); });

    return {
      users: {
        total: users.length,
        today: users.filter(function (u) { return round(u.createdAt, 0) >= start; }).length,
        active: users.filter(function (u) { return u.lastLoginAt && t - round(u.lastLoginAt, 0) < 7 * 864e5; }).length,
        newWeek: users.filter(function (u) { return round(u.createdAt, 0) >= week; }).length,
        banned: users.filter(function (u) { return !!u.banned; }).length
      },
      posts: {
        total: Math.max(livePosts.length, round(snap().meta && snap().meta.totalPosts, 0)),
        today: livePosts.filter(function (p) { return round(p.createdAt, 0) >= start && p.status === 'published'; }).length,
        pending: posts.filter(function (p) { return p.status === 'pending'; }).length,
        hidden: posts.filter(function (p) { return p.status === 'hidden'; }).length
      },
      comments: {
        total: liveComments.length,
        today: liveComments.filter(function (c) { return round(c.createdAt, 0) >= start && c.status === 'published'; }).length
      },
      reports: {
        pending: snap().reports.filter(function (r) { return r.status === 'pending'; }).length,
        total: snap().reports.length
      },
      boards: snap().boards.length,
      online: Math.max(1, users.filter(function (u) { return u.lastLoginAt && t - round(u.lastLoginAt, 0) < 2 * 3600e3; }).length),
      pvToday: round(today.pv, 0),
      uvToday: round(today.uv, 0),
      trend: trend,
      roleDist: ['student', 'mod', 'admin'].map(function (r) {
        return { name: ROLE_LABEL[r], value: users.filter(function (u) { return normRole(u.role) === r; }).length };
      }),
      boardDist: snap().boards.map(function (b) {
        return { name: b.name, value: livePosts.filter(function (p) { return p.boardId === b.id && p.status === 'published'; }).length };
      }).sort(function (a, b) { return b.value - a.value; }).slice(0, 12),
      hotTags: Object.keys(tagCount).map(function (k) { return { name: k, value: tagCount[k] }; })
        .sort(function (a, b) { return b.value - a.value; }).slice(0, 10),
      latestPosts: livePosts.slice().sort(function (a, b) { return round(b.createdAt, 0) - round(a.createdAt, 0); }).slice(0, 5),
      latestUsers: users.slice().sort(function (a, b) { return round(b.createdAt, 0) - round(a.createdAt, 0); }).slice(0, 5),
      latestLogs: snap().logs.slice().sort(function (a, b) { return round(b.createdAt, 0) - round(a.createdAt, 0); }).slice(0, 8)
    };
  }

  /* 服务端统计优先，缺的字段用快照算出来的兜底（页面字段名不变） */
  function mergeStats(base, remote) {
    function numOr(local, v) { var n = Number(v); return isFinite(n) ? n : local; }
    function shape(local, v) {
      if (!v || typeof v !== 'object') return local;
      var out = {};
      Object.keys(local).forEach(function (k) { out[k] = numOr(local[k], v[k]); });
      Object.keys(v).forEach(function (k) { if (out[k] === undefined) out[k] = v[k]; });
      return out;
    }
    var out = Object.assign({}, base);
    out.users = shape(base.users, remote.users);
    out.posts = shape(base.posts, remote.posts);
    out.comments = shape(base.comments, remote.comments);
    out.reports = shape(base.reports, remote.reports);
    /* 学生认证：后台总览的「待认证学生」数字（新增） */
    out.studentVerify = shape({ pending: 0, external: 0 }, remote.studentVerify);
    ['boards', 'online', 'pvToday', 'uvToday'].forEach(function (k) {
      if (remote[k] !== undefined) out[k] = numOr(base[k], remote[k]);
    });
    ['trend', 'roleDist', 'boardDist', 'hotTags', 'latestPosts', 'latestUsers', 'latestLogs'].forEach(function (k) {
      if (Array.isArray(remote[k]) && remote[k].length) out[k] = remote[k];
    });
    if (Array.isArray(out.latestUsers)) out.latestUsers = out.latestUsers.map(function (u) { return normItem('user', u) || u; });
    if (Array.isArray(out.latestPosts)) out.latestPosts = out.latestPosts.map(function (p) { return normItem('post', p) || p; });
    if (Array.isArray(out.latestLogs)) out.latestLogs = out.latestLogs.map(function (g) { return normItem('log', g) || g; });
    return out;
  }

  function adminStats() {
    var key = 'stats';
    var hit = cacheGet(key);
    if (hit) return hit;
    var base = localStats();
    if (canManage() && canSync()) {
      var r = syncCall('GET', '/admin/stats', null, '');
      if (r && r.ok && r.data) base = mergeStats(base, r.data);
    }
    return cacheSet(key, base);
  }

