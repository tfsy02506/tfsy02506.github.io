  var S = null;                 // 内存快照
  var subs = [];                // onSync 订阅者
  var viewSeen = {};            // 同一次会话内已计过阅读的帖子
  var adminCache = {};          // 后台只读缓存
  var lastNetFail = 0;          // 最近一次网络失败时间（短期内不再尝试同步请求）
  var settingsCache = null;

  function now() { return Date.now(); }
  function str(v) { return v === null || v === undefined ? '' : String(v); }
  function trim(v) { return str(v).trim(); }
  function arr(v) { return Array.isArray(v) ? v : []; }
  function bool(v) { return v === true || v === 1 || v === '1' || v === 'true' || v === 'on'; }
  function round(n, d) { var v = Number(n); return isFinite(v) ? Math.round(v) : (d || 0); }
  function api() { return TF.api || null; }

  function toast(msg, type) {
    try { if (TF.ui && TF.ui.toast) TF.ui.toast(msg, type || 'info'); } catch (e) { /* 无 UI 时忽略 */ }
  }
  function uiLoading(on, text) {
    try { if (TF.ui && TF.ui.loading) TF.ui.loading(on, text); } catch (e) { /* 忽略 */ }
  }

  function emptySnapshot() {
    var a = api();
    return a && a.emptySnapshot ? a.emptySnapshot() : {
      boards: [], posts: [], comments: [], users: [], notifications: [], reports: [],
      logs: [], visits: [], notices: [], settings: {},
      meta: { userId: null, role: '', serverTime: now(), totalPosts: 0, version: 0 }
    };
  }

  function levelOf(points) {
    var p = Math.max(0, round(points, 0));
    var lv = 1;
    for (var i = 0; i < LEVELS.length; i++) if (p >= LEVELS[i]) lv = i + 1;
    return lv;
  }
  function levelInfo(points) {
    var p = Math.max(0, round(points, 0));
    var lv = levelOf(p);
    var low = LEVELS[lv - 1], next = LEVELS[lv] === undefined ? null : LEVELS[lv];
    return {
      level: lv, points: p, next: next,
      need: next === null ? 0 : next - p,
      percent: next === null ? 100 : Math.min(100, Math.round(((p - low) / (next - low)) * 100))
    };
  }

  function adopt(src) {
    var a = api();
    S = a && a.normalizeSnapshot ? a.normalizeSnapshot(src || a.snapshot || {}) : emptySnapshot();
    S.users.forEach(function (u) { if (!u.level || u.level < 1) u.level = levelOf(u.points); });
    settingsCache = null;
    return S;
  }
  function snap() {
    if (!S) adopt();
    return S;
  }
  function cloneSnapshot() { try { return JSON.parse(JSON.stringify(snap())); } catch (e) { return snap(); } }
  function online() { return !!(api() && api().online); }
  function setOffline() { if (api()) api().online = false; }

  function byId(list, id) {
    var key = str(id);
    if (!key) return null;
    for (var i = 0; i < list.length; i++) if (str(list[i].id) === key) return list[i];
    return null;
  }
  function currentUser() {
    const obj = {"id":"0","username":"tfsy2506","nickname":"初2025级6班","role":"admin","avatar":1,"sex":"","grade":"初二","klass":"6班","bio":"初2025级6班公共账号，发布内容与创建者无关","email":"","realName":"","hasRealName":true,"avatarUrl":"","points":10000,"level":1000,"createdAt":0,"lastLoginAt":0,"banned":false,"banReason":"","studentStatus":"student","stats":{"posts":12,"comments":8,"likes":7},"favorites":[]};
    return obj;
  }
  function meId() { var u = currentUser(); return u ? str(u.id) : ''; }
  function asUser(u) {
    if (u === undefined) return currentUser();
    if (typeof u === 'string') return byId(snap().users, u);
    return u || null;
  }
  function isAdmin(u) { var x = asUser(u); return !!x && str(x.role) === 'admin'; }
  function isMod(u) { var x = asUser(u); return !!x && str(x.role) === 'mod'; }
  /* 学生认证：老账号 / 旧版接口没有 studentStatus 字段时按「已认证」处理（服务端默认也是 student），
     只有明确返回 external / pending / rejected 才拦。这样即使浏览器缓存混用了旧文件，
     也不会把老用户误判成校外访客。 */
  function studentStatus(u) {
    var x = asUser(u);
    if (!x) return 'guest';
    if (str(x.role) === 'admin' || str(x.role) === 'mod') return 'student';
    var s = str(x.studentStatus);
    if (s === 'external' || s === 'pending' || s === 'rejected') return s;
    return 'student';
  }
  function isVerified(u) { return studentStatus(u) === 'student'; }
  function canManage(u) { var x = asUser(u); return !!x && ROLE_RANK[normRole(x.role)] >= 2; }
  function normRole(r) {
    var role = str(r);
    if (role === 'teacher') return 'mod';           // 老数据归一化（R5）
    return ROLE_RANK[role] ? role : 'student';
  }

  function paginate(list, page, size) {
    size = Math.min(1000, Math.max(1, round(size, 20) || 20));
    var total = list.length;
    var pages = Math.max(1, Math.ceil(total / size));
    page = Math.min(Math.max(1, round(page, 1) || 1), pages);
    var start = (page - 1) * size;
    return { list: list.slice(start, start + size), total: total, page: page, size: size, pages: pages };
  }
  function kwMatch(hay, kw) { return str(hay).toLowerCase().indexOf(str(kw).toLowerCase()) >= 0; }

  /* ------------------------------------------------------- 同步 / 乐观写通道 */
  function canSync() {
    if (typeof XMLHttpRequest !== 'function') return false;
    if (lastNetFail && now() - lastNetFail < 4000) return false;
    return !!(api() && typeof api().callSync === 'function');
  }

  /* 同步请求：{ok:true,data} / {ok:false,error} / null（环境不支持） */
  function syncCall(method, path, body, busy) {
    if (!canSync()) return null;
    if (busy) uiLoading(true, busy);
    var r = null;
    try { r = api().callSync(method, path, body); }
    catch (e) { r = { __net: true, error: e && e.message }; }
    finally { if (busy) uiLoading(false); }
    if (!r) return null;
    if (r.__net) { lastNetFail = now(); setOffline(); return { ok: false, error: r.error || OFFLINE_MSG, offline: true }; }
    if (!r.ok) return { ok: false, error: r.error || '操作没成功', status: r.status, code: r.code };
    return { ok: true, data: r.data };
  }

  function bumpCache() { adminCache = {}; }

  /* 写操作收尾：拉最新快照 → 替换内存 → 通知 UI */
  function afterWrite(kind) {
    bumpCache();
    var a = api();
    if (!a || !a.refresh) return;
    var p = a.refresh();
    if (!p || !p.then) return;
    p.then(function () { adopt(); notifySync(kind || 'major'); },
      function () { notifySync(kind || 'major'); });
  }

  /* 同步拉快照（写后立刻需要新数据，例如发帖后跳详情页） */
  function syncAdopt() {
    bumpCache();
    var a = api();
    if (a && a.refreshSync && canSync()) { a.refreshSync(); adopt(); return true; }
    return false;
  }

  function notifySync(kind) {
    var list = subs.slice();
    for (var i = 0; i < list.length; i++) {
      try { list[i](kind || 'major', snap()); } catch (e) { /* 订阅者异常不影响主流程 */ }
    }
    if (!list.length && kind === 'major') {
      try { if (TF.app && TF.app.refresh) TF.app.refresh(); } catch (e) { /* 忽略 */ }
    }
  }

  /* 乐观写：apply 先改内存（返回同步结果），request 发异步请求；失败回滚 */
  function optimistic(apply, request, kind) {
    var backup = cloneSnapshot();
    var res;
    try { res = apply(); } catch (e) { return { ok: false, error: '操作出错了，刷新一下再试' }; }
    if (res && res.ok === false) return res;
    var out = res && typeof res === 'object' ? res : { ok: true };
    var a = api();
    if (!a || !a.call) return out;
    var p = null;
    try { p = request(); } catch (e) { p = null; }
    if (!p || !p.then) return out;
    p.then(function () { afterWrite(kind || 'minor'); }, function (e) {
      S = backup;                       // 回滚到操作前
      bumpCache();
      toast((e && (e.error || e.message)) || '操作没成功，再试一次', 'error');
      notifySync('major');
    });
    return out;
  }

  function offlineResult() { return { ok: false, error: OFFLINE_MSG, offline: true }; }
  function syncDone(res, kind) {
    if (res && res.ok) { if (!syncAdopt()) afterWrite(kind || 'major'); }
    return res;
  }

  /* ------------------------------------------------------------- 设置归一化 */
  function settingsDefaults() {
    return {
      siteName: '天府师大一中·校园论坛', subtitle: '', schoolName: '四川天府新区师一学校',
      address: '', motto: '', slogan: '', icp: '', footerText: '', contact: '', announcement: '',
      registerOpen: true, needAudit: false, needEmail: false, allowGuest: true,
      postInterval: 30, sensitiveWords: [], themeDefault: 'light'
    };
  }
  function normSettings(raw) {
    var out = settingsDefaults();
    raw = raw && typeof raw === 'object' ? raw : {};
    Object.keys(out).forEach(function (k) { if (raw[k] !== undefined && raw[k] !== null) out[k] = raw[k]; });
    out.registerOpen = bool(raw.registerOpen);
    out.needAudit = bool(raw.needAudit);
    out.needEmail = bool(raw.needEmail);
    out.allowGuest = bool(raw.allowGuest);
    out.postInterval = Math.max(0, Math.min(600, round(raw.postInterval, 30)));
    out.sensitiveWords = Array.isArray(raw.sensitiveWords)
      ? raw.sensitiveWords.map(str).filter(Boolean)
      : str(raw.sensitiveWords).split(/[,，、\s]+/).map(function (x) { return x.trim(); }).filter(Boolean);
    if (out.themeDefault !== 'dark') out.themeDefault = 'light';
    if (!out.siteName) out.siteName = settingsDefaults().siteName;
    return out;
  }
  function getSettings() {
    if (!settingsCache) settingsCache = normSettings(snap().settings);
    return settingsCache;
  }

  /* ---------------------------------------------------------------- 初始化 */
  function init() {
    try { window.localStorage.removeItem(LEGACY_KEY); } catch (e) { /* 隐私模式等忽略 */ }
    adopt();
    return snap();
  }
  function save() { /* 数据以服务器为准，本方法保留仅为兼容旧调用 */ }
  /* 清空论坛内容（**服务器端执行**，账号和版块保留）。只有超管能调。 */
  function reset() {
    var r = syncCall('POST', '/admin/reset', {}, '正在清空…');
    if (r && r.ok) {
      bumpCache();
      adopt();
      afterWrite('major');
      return { ok: true };
    }
    return { ok: false, error: (r && r.error) || '清空失败，稍后再试' };
  }
  function state() {
    var u = currentUser();
    var out = snap();
    out.session = u ? { userId: u.id, role: u.role, at: round(out.meta && out.meta.serverTime, now()), expiresAt: 0 } : null;
    return out;
  }

  /* ------------------------------------------------------------------ 鉴权 */
  function canPost() {
    var me = currentUser();
    if (!me) return { ok: false, msg: '先登录再发帖' };
    if (me.banned) return { ok: false, msg: '账号被封了：' + (me.banReason || '违反版规') };
    var st = getSettings();
    var iv = round(st.postInterval, 30);
    if (normRole(me.role) === 'student' && iv > 0) {
      var last = 0;
      snap().posts.forEach(function (p) { if (p.authorId === str(me.id)) last = Math.max(last, round(p.createdAt, 0)); });
      var left = Math.ceil((last + iv * 1000 - now()) / 1000);
      if (last && left > 0) return { ok: false, msg: '发帖太快了，等 ' + left + ' 秒再发' };
    }
    return { ok: true, msg: '' };
  }

  /* 会话只能由服务器建立：只在「目标就是当前登录用户」时返回 user，杜绝免密登录 */
  function setSession(userId) {
    var me = currentUser();
    if (!me || str(me.id) !== str(userId)) return null;
    return me;
  }

  function finishAuth(user) {
    var a = api();
    if (a && user) a.user = user;
    syncAdopt();
    adopt();
    notifySync('auth');
  }

  function login(username, password) {
    var name = trim(username), pwd = str(password);
    if (!name || !pwd) return { ok: false, error: '用户名和密码都要填' };
    var r = syncCall('POST', '/auth/login', { username: name, password: pwd }, '正在登录…');
    if (r) {
      if (!r.ok) return { ok: false, error: r.error };
      var u = (r.data && r.data.user) || null;
      finishAuth(u);
      return { ok: true, user: currentUser() || u };
    }
    if (!online()) return offlineResult();
    api().login(name, pwd).then(function () { adopt(); notifySync('auth'); }, function (e) {
      toast((e && e.error) || '登录没成功', 'error');
    });
    return { ok: true, pending: true };
  }

  function register(d) {
    d = d || {};
    var username = trim(d.username), nickname = trim(d.nickname);
    var pwd = str(d.password), pwd2 = str(d.password2);
    var realName = trim(d.realName), klass = trim(d.klass), studentNo = trim(d.studentNo);
    if (!/^[a-zA-Z0-9_]{3,16}$/.test(username)) return { ok: false, error: '用户名 3-16 位，只能用字母、数字和下划线' };
    if (nickname.length < 2 || nickname.length > 16) return { ok: false, error: '昵称 2-16 个字' };
    if (pwd.length < 6) return { ok: false, error: '密码至少 6 位' };
    if (pwd !== pwd2) return { ok: false, error: '两次密码不一样' };
    /* 真实姓名 / 班级 / 学号：不再是注册必填项（新账号默认是校外访客，
       这些资料在「学生认证」时随校卡照片一起填，也可以留空）。 */
    if (realName && (realName.length < 2 || realName.length > 20)) return { ok: false, error: '真实姓名填 2~20 个字' };
    if (klass && !/^([1-9]|10)班$/.test(klass)) return { ok: false, error: '班级只能选 1~10 班' };
    if (studentNo && !/^\d{4,12}$/.test(studentNo)) return { ok: false, error: '学号填 4~12 位数字' };
    var payload = {
      username: username, nickname: nickname, password: pwd, password2: pwd2,
      email: trim(d.email), grade: trim(d.grade), klass: klass, sex: trim(d.sex),
      realName: realName, studentNo: studentNo
