  var PAGE_BUILD = {
    forum: buildForum, board: buildBoard, post: buildPost, new: buildEditor, edit: buildEditor,
    profile: buildProfile, me: buildProfile, messages: buildMessages, settings: buildSettings, search: buildSearch
  };
  function makePage(name) {
    return function (ctx) {
      ctx = ctx || {};
      var p = {
        page: name,
        path: str(ctx.path || (TF.route && TF.route.path) || '/' + name),
        param: ctx.params || (TF.route && TF.route.param) || {},
        query: ctx.query || (TF.route && TF.route.query) || {}
      };
      if (!TF.util || !TF.store || !TF.ui) {
        return { html: '<div class="page" ' + PAGES[name] + '>' + plain('页面加载失败，刷新一下') + '</div>' };
      }
      var out = PAGE_BUILD[name](p) || {};
      /* 歌单是异步来的（首次打开要等一次接口），首屏先渲染"还没有歌单"，
         拿到数据后自己刷一次页面。只刷一次，避免死循环。 */
      var mount = out.onMount;
      var needPlaylist = (name === 'board');
      return {
        title: out.title,
        html: '<div class="page" ' + PAGES[name] + '>' + (out.html || '') + '</div>',
        onMount: function (root, ctx2) {
          if (needPlaylist && ST.refreshPlaylist && !window.__plPulled) {
            window.__plPulled = true;
            var before = ST.playlistData ? ST.playlistData() : null;
            ST.refreshPlaylist(function (d) {
              var after = d || null;
              if (JSON.stringify(before && before.playlist) !== JSON.stringify(after && after.playlist)) {
                if (TF.app && TF.app.refresh) TF.app.refresh();
              }
            });
          }
          if (typeof mount === 'function') return mount(root, ctx2);
          return undefined;
        }
      };
    };
  }

