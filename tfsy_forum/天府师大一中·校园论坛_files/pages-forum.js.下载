     ================================================================== */

  function pmThread(peerId) {
    var user = me();
    if (!user || !peerId) return [];
    var out = [];
    var full = null;
    try { full = ST.state(); } catch (e) { full = null; }
    if (full && arr(full.messages).length) {
      arr(full.messages).forEach(function (m) {
        if (m.type !== 'pm') return;
        if (m.userId === user.id && m.fromId === peerId) out.push({ m: m, mine: false });
        else if (m.fromId === user.id && m.userId === peerId) out.push({ m: m, mine: true });
      });
    } else {
      ST.listMessages({ box: 'inbox', size: 200 }).list.forEach(function (m) {
        if (m.fromId === peerId) out.push({ m: m, mine: false });
      });
    }
    return out.sort(function (a, b) { return (Number(a.m.createdAt) || 0) - (Number(b.m.createdAt) || 0); });
  }

  /* 私信：收件人不用手打用户名 —— 给一个「最近活跃同学」的下拉，也可以手填昵称。
     服务端四种写法都认：用户 id（纯数字也行）/ 用户名 / 昵称。 */
  function composeModalHtml() {
    var people = [];
    try { people = (ST.listUsers ? ST.listUsers({ sort: 'points', size: 30 }).list : []) || []; } catch (e) { people = []; }
    var meId = (me() || {}).id;
    people = people.filter(function (u) { return u && str(u.id) !== str(meId); });
    var optionHtml = people.map(function (u) {
      var name = (u.nickname || u.username) + (u.username ? '（@' + u.username + '）' : '') + (u.grade ? ' · ' + u.grade : '');
      return '<option value="' + attr(u.username || '') + '" data-uid="' + attr(str(u.id)) + '" data-nick="' + attr(u.nickname || u.username || '') + '">' + esc(name) + '</option>';
    }).join('');
    var picker = people.length
      ? '<div class="field"><label class="field__label" for="pf-pm-to">发给谁</label>' +
        '<select class="select" id="pf-pm-to" name="toPick"><option value="">— 选一位同学 —</option>' + optionHtml + '</select>' +
        '<div class="field__hint">从列表里选一位（更不容易出错）</div></div>' +
        '<div class="mt-3">' + UI.field({ label: '或者手填', name: 'to', placeholder: '用户名或昵称都行，比如：小眠', hint: '上面选了就这里可以留空' }) + '</div>'
      : UI.field({ label: '收件人', name: 'to', required: true, placeholder: '用户名或昵称都行', hint: '填对方的用户名或昵称都可以' });
    return UI.modal({
      id: 'pf-pm', title: '发私信',
      body: '<form data-action="message.send">' + picker +
        '<input type="hidden" name="toId" value="">' +
        '<div class="mt-3">' + UI.field({ label: '主题', name: 'title', maxlength: 40, placeholder: '关于什么' }) + '</div>' +
        '<div class="mt-3">' + UI.textarea({ label: '内容', name: 'body', rows: 5, maxlength: 500 }) + '</div>' +
        '<div class="cluster gap-2 mt-4"><button class="btn btn--primary" type="submit">发送</button>' +
        '<button class="btn" type="button" data-modal-close>取消</button></div></form>'
    });
  }

  function notifRow(m) {
    var kind = { system: '通知', audit: '审核', reply: '回复', like: '赞', at: '提到你', pm: '私信' }[m.type] || '通知';
    var link = str(m.link);
    var inner = '<span class="noticerow__title">' + (m.read ? '' : '<i class="unread-dot"></i> ') +
      '<b>' + esc(m.title || kind) + '</b> <span class="text-muted">' + esc(U.excerpt(m.body || '', 70)) + '</span></span>' +
      '<span class="noticerow__time">' + esc(rel(m.createdAt)) + '</span>';
    if (link) return '<a class="noticerow" href="' + attr(link) + '" data-action="message.read"' + dp({ id: m.id }) + '>' + inner + '</a>';
    return '<button type="button" class="noticerow w-full" data-action="message.read"' + dp({ id: m.id }) + '>' + inner + '</button>';
  }

  function buildMessages(p) {
    var user = me();
    if (!user) return { title: '消息', html: '' };
    var tab = p.query.tab === 'notice' ? 'notice' : 'pm';
    var convs = ST.conversations();
    var curId = str(p.query.c);
    var unread = ST.unreadCount ? (ST.unreadCount() || 0) : 0;
    var systemList = ST.listMessages({ box: 'system', size: 30 }).list;
    var interact = ST.listMessages({ box: 'inbox', size: 50 }).list.filter(function (m) {
      return m.type === 'reply' || m.type === 'like' || m.type === 'at' || m.type === 'audit';
    });
    var unreadPm = convs.reduce(function (n, c) { return n + (c.unread || 0); }, 0);
    var unreadNotice = systemList.filter(function (m) { return !m.read; }).length + interact.filter(function (m) { return !m.read; }).length;

    var head = '<div class="bbs-head"><div>' +
      '<div class="bbs-head__title">' + icon('bell', 18) + '<span>消息</span></div>' +
      '<div class="bbs-head__desc">' + (unread ? unread + ' 条没读' : '都读完了') + ' · ' + convs.length + ' 个会话</div>' +
      '</div><div class="cluster gap-2">' +
      '<button type="button" class="btn btn--ghost" data-action="message.compose">' + icon('send', 14) + '<span>发私信</span></button>' +
      '<button type="button" class="btn btn--ghost" data-action="message.readAll">' + icon('check', 14) + '<span>全部已读</span></button>' +
      '</div></div>';

    var nav = '<nav class="bbs-nav mt-4">' +
      '<a class="bbs-nav__item' + (tab === 'pm' ? ' is-active' : '') + '" href="' + attr(href('/messages', { tab: 'pm' })) + '">私信' +
        (unreadPm ? '<span class="bbs-nav__count">' + unreadPm + '</span>' : '') + '</a>' +
      '<a class="bbs-nav__item' + (tab === 'notice' ? ' is-active' : '') + '" href="' + attr(href('/messages', { tab: 'notice' })) + '">通知' +
        (unreadNotice ? '<span class="bbs-nav__count">' + unreadNotice + '</span>' : '') + '</a></nav>';

    var body = '';
    if (tab === 'pm') {
      var listHtml = convs.length
        ? convs.map(function (c) {
            var u = c.user || ST.getUser(c.userId) || {};
            var last = c.last || {};
            return '<a class="noticerow' + (c.userId === curId ? ' is-active' : '') + '" href="' +
              attr(href('/messages', { tab: 'pm', c: c.userId })) + '">' + av(u, 28, 'avatar--round') +
              '<span class="noticerow__title"><b>' + esc(nick(u)) + '</b> <span class="text-muted">' +
                esc(U.excerpt(last.body || last.title || '', 24)) + '</span>' + (c.unread ? ' <i class="unread-dot"></i>' : '') + '</span>' +
              '<span class="noticerow__time">' + esc(rel(last.createdAt)) + '</span></a>';
          }).join('')
        : plain('还没有私信', '给同学发一条');

      var thread;
      if (!curId) {
        thread = '<div class="block block--box"><div class="block__body">' + plain('选左边一个同学，看聊天记录') + '</div></div>';
      } else {
        var peer = ST.getUser(curId);
        var msgs = pmThread(curId);
        thread = '<div class="block block--box"><div class="block__head"><h2 class="block__title">' + esc(nick(peer)) + '</h2>' +
          '<a class="block__more" href="' + attr(href('/u/' + curId)) + '">TA 的主页</a></div>' +
          '<div class="block__body">' +
          (msgs.length ? msgs.map(function (it) {
            var m = it.m;
            return '<div class="commentitem"><a href="' + attr(href('/u/' + (it.mine ? user.id : curId))) + '">' +
              av(it.mine ? user : peer, 28, 'avatar--round') + '</a>' +
              '<div class="commentitem__body">' +
                '<div class="commentitem__head"><b>' + esc(it.mine ? '我' : nick(peer)) + '</b>' +
                  (m.title ? '<span>' + esc(m.title) + '</span>' : '') +
                  '<span>' + esc(U.fmtTime(m.createdAt)) + '</span></div>' +
                '<div class="commentitem__content">' + U.md(m.body || '') + '</div>' +
              '</div></div>';
          }).join('') : plain('还没聊过')) +
          '<form class="mt-3" data-action="message.send">' +
            '<input type="hidden" name="toId" value="' + attr(curId) + '">' +
            '<input type="hidden" name="to" value="">' +
            '<textarea class="textarea" name="body" rows="3" maxlength="500" placeholder="发给 ' + attr(nick(peer)) + '"></textarea>' +
            '<div class="cluster gap-2 mt-2"><button class="btn btn--primary" type="submit">发送</button></div>' +
          '</form></div></div>';
      }
      body = '<div class="row"><div class="col-side">' + rowBlock('会话', listHtml) + '</div>' +
        '<div class="col">' + thread + '</div></div>';
    } else {
      body = rowBlock('通知', systemList.length ? systemList.map(notifRow).join('') : plain('没有新通知', '公告和审核结果会出现在这儿')) +
        '<div class="mt-5">' + rowBlock('谁理过你', interact.length ? interact.map(notifRow).join('') : plain('还没人回复或提到你')) + '</div>';
    }

    return {
      title: '消息',
      html: head + nav + body + composeModalHtml(),
      onMount: function () {
        if (tab === 'pm' && curId) {
          pmThread(curId).forEach(function (it) { if (!it.mine) ST.markRead(it.m.id); });
          if (TF.app && TF.app.data) TF.app.data.unread = ST.unreadCount ? (ST.unreadCount() || 0) : 0;
        }
      }
    };
  }

