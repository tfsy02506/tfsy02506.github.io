  TF.app.on('settings.logout', function () {
    UI.modal.confirm({ title: '退出登录？', body: '下次进来要重新输密码', okText: '退出', danger: true }).then(function (ok) {
      if (!ok) return;
      ST.logout();
      toast('退了', 'success');
      go('/home');
    });
  });

  /* 消息 */
  TF.app.on('message.compose', function () {
    if (!me()) { toast('先登录', 'warn'); return; }
    UI.modal.open('pf-pm');
  });
  TF.app.on('message.send', function (ctx) {
    if (!me()) { toast('先登录再发私信', 'warn'); return; }
    var v = ctx.values() || {};
    /* 下拉里选了人 → 直接读选项上的 data-uid（用户 id，最可靠）；
       没选就用文本框里的用户名/昵称。
       ⚠️ 别再用用户列表反查：快照里常常没有这个人，反查失败就会把 id 当用户名发出去，
       服务端回"没找到 [2] 这个同学"。 */
    var picked = str(v.toPick);
    var pickedId = '';
    var pickedName = '';
    if (picked) {
      var sel = ctx.form ? ctx.form.querySelector('select[name="toPick"]') : null;
      var opt = (sel && sel.selectedIndex >= 0) ? sel.options[sel.selectedIndex] : null;
      if (opt) {
        pickedId = str(opt.getAttribute('data-uid')) || '';
        pickedName = str(opt.getAttribute('data-nick')) || str(opt.textContent).trim();
      }
      if (!pickedId && /^\d+$/.test(picked)) pickedId = picked;
    }
    /* 会话页那个"发给 XX"的输入框直接给的是用户 id（hidden toId），这里照收 */
    var hiddenId = str(v.toId);
    if (!pickedId && hiddenId) pickedId = hiddenId;
    var to = str(v.to).trim() || pickedName || picked;
    if (!to && !pickedId) { toast('选一位同学，或者填上用户名/昵称', 'error'); return; }
    var res = ST.sendMessage({ to: to, toId: pickedId, title: v.title, body: v.body });
    if (!res.ok) { toast(res.error, 'error'); return; }
    UI.modal.close('pf-pm');
    var who = (res.data && res.data.toName) || res.toName || to || '对方';
    toast('已发给 ' + who, 'success');
    refresh();
  });
  TF.app.on('message.read', function (ctx) {
    if (!ctx.param.id) return;
    ST.markRead(ctx.param.id);
    refreshHeaderUnread();
    var a = ctx.el && ctx.el.closest ? ctx.el.closest('a') : null;
    var target = a ? str(a.getAttribute('href')) : '';
    var cur = '#' + str(location.hash).replace(/^#/, '');
    if (!target || target === cur) refresh();
  });
  TF.app.on('message.readAll', function () {
    ST.markRead();
    refreshHeaderUnread();
    toast('都标成已读了', 'success');
    refresh();
  });

