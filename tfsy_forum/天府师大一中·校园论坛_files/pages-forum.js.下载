  TF.app.on('settings.theme', function (ctx) {
    var m = str(ctx.param.mode);
    if (['light', 'dark', 'auto'].indexOf(m) < 0) m = 'light';
    if (UI.theme && UI.theme.set) UI.theme.set(m);   /* design.js 负责存 tf.theme */
    toast(m === 'dark' ? '深色' : m === 'auto' ? '跟系统走' : '浅色', 'success', 1500);
    refresh();
  });
  TF.app.on('settings.pref', function (ctx) {
    var key = str(ctx.param.key);
    if (!key) return;
    var n = readPrefs().notify || {};
    n[key] = !!(ctx.el && ctx.el.checked);
    savePrefs({ notify: n });
