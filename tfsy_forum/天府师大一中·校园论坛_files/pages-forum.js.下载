  TF.app.on('editor.addTag', function () { addTag(); });
  TF.app.on('editor.delTag', function (ctx) {
    var i = ED.tags.indexOf(str(ctx.param.tag));
    if (i < 0) return;
    ED.tags.splice(i, 1);
    renderTags(); saveDraft();
  });
  TF.app.on('editor.pickImages', function (ctx) {
    var el = ctx.el;
    if (!el || el.tagName !== 'INPUT') {
      var opener = document.getElementById('pf-images');
      if (opener) { try { opener.click(); } catch (e) { /* 忽略 */ } }
      return;
    }
    var files = el.files ? Array.prototype.slice.call(el.files) : [];
    if (!files.length) return;
    var room = MAX_IMAGES - ED.images.length;
    if (room <= 0) { toast('最多 ' + MAX_IMAGES + ' 张图', 'warn'); el.value = ''; return; }
    var take = files.slice(0, room);
    if (files.length > room) toast('只收前 ' + room + ' 张', 'warn');
    UI.loading(true, '压图片…');
    Promise.all(take.map(function (f) {
      return U.fileToDataUrl(f).then(function (u) { return u || ''; }, function () { return ''; });
    })).then(function (urls) {
      UI.loading(false);
      urls.forEach(function (u) { if (u && ED.images.length < MAX_IMAGES) ED.images.push(u); });
      renderImages(); saveDraft();
      if (ED.images.length) toast('图加好了', 'success');
      else toast('图片读不出来，换一张', 'error');
    });
    el.value = '';
  });
  TF.app.on('editor.delImage', function (ctx) {
    var i = Number(ctx.param.i);
    if (!isFinite(i) || i < 0 || i >= ED.images.length) return;
    ED.images.splice(i, 1);
    renderImages(); saveDraft();
  });
  TF.app.on('editor.dropDraft', function () {
    if (!ED.key) return;
    clearDraft(ED.key);
    toast('草稿扔了', 'success');
    refresh();
  });
  TF.app.on('editor.loadDraft', function () {
    var d = readDraft(ED.key);
    if (!d) { toast('没有草稿', 'warn'); return; }
    var ti = document.getElementById('pf-title');
    var ta = document.getElementById('pf-content');
    var bd = document.querySelector('form[data-action="post.save"] select[name=boardId]');
    if (ti) ti.value = str(d.title);
    if (ta) ta.value = str(d.content);
    if (bd && d.boardId) bd.value = str(d.boardId);
    ED.tags = arr(d.tags).slice(0, MAX_TAGS);
    ED.images = arr(d.images).slice(0, MAX_IMAGES);
    renderTags(); renderImages(); syncEditor();
    toast('草稿接上了', 'success');
  });
  TF.app.on('post.save', function (ctx) {
    if (!me()) { toast('先登录再发帖', 'warn'); return; }
    clearFormError();
    var v = ctx.values() || {};
    var title = str(v.title).trim();
    var content = str(v.content).trim();
    var boardId = str(v.boardId);
    var err = '';
    if (!boardId) err = '选个版块';
    else if (title.length < 4) err = '标题至少 4 个字';
    else if (title.length > 60) err = '标题别超过 60 个字';
    else if (content.length < 10) err = '正文至少 10 个字';
    if (err) { formError(err); toast(err, 'error'); return; }
    var hit = sensitiveHit(title + ' ' + content + ' ' + ED.tags.join(' '), arr(settings().sensitiveWords));
    if (hit) { var m = '有敏感词「' + hit + '」，改一下'; formError(m); toast(m, 'error'); return; }
    var ck = ST.canPost();
    if (ck && ck.ok === false) { formError(ck.msg); toast(ck.msg, 'error'); return; }
    var payload = { boardId: boardId, title: title, content: content, tags: ED.tags.slice(0, MAX_TAGS), images: ED.images.slice(0, MAX_IMAGES) };
    var res = ED.postId ? ST.updatePost(ED.postId, payload) : ST.createPost(payload);
    if (!res.ok) { formError(res.error); toast(res.error, 'error'); return; }
    clearDraft(ED.key);
    if (res.pending) toast('提交了，审核过了就公开', 'success', 3000);
    else toast(ED.postId ? '改好了' : '发出去了', 'success');
    go('/post/' + res.post.id);
  });

  /* 资料 */
  TF.app.on('profile.editOpen', function () {
    if (!me()) { toast('先登录', 'warn'); return; }
    UI.modal.open('pf-profile-edit');
  });
  TF.app.on('profile.editSubmit', function (ctx) {
    var v = ctx.values() || {};
    if (!str(v.realName).trim()) { toast('请填写真实姓名（2~20 个字）', 'error'); return; }
    if (!/^([1-9]|10)班$/.test(str(v.klass).trim())) { toast('班级请选 1~10 班', 'error'); return; }
    if (!/^\d{4,12}$/.test(str(v.studentNo).trim())) { toast('学号填 4~12 位数字', 'error'); return; }
    var res = saveProfile({ nickname: v.nickname, realName: v.realName, bio: v.bio, grade: v.grade, klass: v.klass, studentNo: v.studentNo, sex: v.sex });
    if (!res || !res.ok) { toast((res && res.error) || '没存上，再试一次', 'error'); return; }
    UI.modal.close('pf-profile-edit');
    toast('改好了', 'success');
    refresh();
  });

  /* 设置 */
  TF.app.on('settings.profile', function (ctx) {
    var v = ctx.values() || {};
    if (!str(v.realName).trim()) { toast('请填写真实姓名（2~20 个字，只有管理员能看到）', 'error'); return; }
    if (!/^([1-9]|10)班$/.test(str(v.klass).trim())) { toast('班级请选 1~10 班', 'error'); return; }
    if (!/^\d{4,12}$/.test(str(v.studentNo).trim())) { toast('请填写学号（4~12 位数字，只有管理员能看到）', 'error'); return; }
    var patch = {
      nickname: v.nickname, realName: v.realName, bio: v.bio,
      grade: v.grade, klass: v.klass, studentNo: v.studentNo, sex: v.sex, email: v.email
    };
    if (v.avatar !== undefined && v.avatar !== '') patch.avatar = Number(v.avatar);
    var res = saveProfile(patch);
    if (!res || !res.ok) { toast((res && res.error) || '没存上，再试一次', 'error'); return; }
    toast('存好了', 'success');
    refresh();
  });
  /* 头像上传按钮不需要单独 handler：文件输入框透明覆盖在按钮上，点它就是原生点击，
     change 事件由 document 上的 data-action-change 委托交给 settings.avatarFile。 */
  /* 头像：真的传到服务器（store.uploadAvatar 优先，退回 api.upload），拿到 url 再写进资料 */
  TF.app.on('settings.avatarFile', function (ctx) {
    var input = ctx.el;
    var f = input && input.files && input.files[0];
    if (!f) return;
    if (!/^image\//.test(f.type || '')) { toast('要图片文件', 'error'); input.value = ''; return; }
    if (f.size > 5 * 1024 * 1024) { toast('图片太大，换一张 5MB 以内的', 'error'); input.value = ''; return; }
    UI.loading(true, '正在上传头像…');
    U.fileToDataUrl(f, 256).then(function (dataUrl) {
      if (!dataUrl) throw new Error('图片读不出来，换一张');
      return uploadAvatarFile(f);
    }).then(function (res) {
      if (res && typeof res === 'object' && res.ok === false) throw new Error(res.error || '头像上传失败');
      var url = uploadedUrl(res);
      if (!url) throw new Error((res && res.error) || '服务器没返回图片地址');
      var r = saveProfile({ avatarUrl: url });
      if (!r || !r.ok) throw new Error((r && r.error) || '头像地址没存上');
      UI.loading(false);
      toast('头像换好了', 'success');
      refresh();
    }).catch(function (e) {
      UI.loading(false);
      toast((e && (e.error || e.message)) || '头像没换成，再试一次', 'error', 3200);
    });
    input.value = '';
  });
  TF.app.on('settings.avatarReset', function () {
    var u = me();
    if (!u) return;
    if (!avatarUrlOf(u)) { toast('现在就是预设头像', 'warn'); return; }
    var res = saveProfile({ avatarUrl: '' });
    if (!res || !res.ok) { toast((res && res.error) || '没换成，再试一次', 'error'); return; }
    toast('换回预设头像', 'success');
    refresh();
  });
  TF.app.on('settings.pwd', function (ctx) {
    var v = ctx.values() || {};
    var res = ST.changePassword(v.oldPwd, v.newPwd, v.newPwd2);
    if (!res.ok) { toast(res.error, 'error'); return; }
    toast('密码改好了', 'success');
    refresh();
  });
  /* 安全问题：设了它，忘了密码才能在登录页自助重置 */
  TF.app.on('settings.security', function (ctx) {
    var v = ctx.values() || {};
    var res = ST.setSecurityQuestion ? ST.setSecurityQuestion(v.question, v.answer) : { ok: false, error: '这个功能还没上线' };
    if (!res || !res.ok) { toast((res && res.error) || '没存上', 'error'); return; }
