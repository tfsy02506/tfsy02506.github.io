  function strength(pwd) {
    var s = str(pwd);
    if (!s) return 0;
    var n = 0;
    if (s.length >= 6) n++;
    if (s.length >= 10) n++;
    if (/[A-Za-z]/.test(s) && /\d/.test(s)) n++;
    if (/[^A-Za-z0-9]/.test(s)) n++;
    return Math.min(4, n);
  }

