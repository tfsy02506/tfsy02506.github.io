  function buildForum(p) {
    var q = p.query || {};
    var sort = SORTS.some(function (s) { return s.key === q.sort; }) ? q.sort : 'latest';
    var page = toInt(q.page, 1);
    var boards = ST.listBoards();
    var counts = ST.counts();
    var last = lastPostMap();
    var members = ST.listUsers({ size: 1 }).total;

    var groups = [], gmap = {};
    boards.forEach(function (b) {
      var g = b.group || '其他';
      if (!gmap[g]) { gmap[g] = []; groups.push(g); }
      gmap[g].push(b);
    });
    /* 版块列表：整行可点的卡片行（名称 / 简介 / N 帖 · 今天 M）+ 右侧 chevron，
       手机上和桌面共用同一套结构，不再用会折行的表格列。 */
    var table = groups.map(function (g) {
      return '<div class="forumtable__group">' + esc(g) + '</div>' +
        gmap[g].map(function (b) {
          var s = b.stats || {};
          var lp = last[b.id];
          return '<a class="noticerow" href="' + attr(href('/board/' + b.id)) + '">' +
            '<span class="forumtable__icon">' + icon(b.icon || 'forum', 16) + '</span>' +
            '<span class="forumtable__name"><span class="stack gap-0">' +
              '<span class="boardcard__title">' + esc(b.name) + (b.locked ? ' ' + UI.badge('只读', 'default') : '') + '</span>' +
              (b.desc ? '<span class="text-xs text-muted clamp-2">' + esc(b.desc) + '</span>' : '') +
              '<span class="text-xs text-muted">' + num(s.posts) + ' 帖 · 今天 ' + num(s.today) +
                (lp ? ' · 最新 ' + esc(rel(lp.t)) : '') + '</span>' +
            '</span></span>' +
            '<span class="noticerow__time">' + icon('chevronRight', 16) + '</span>' +
            '</a>';
        }).join('');
    }).join('');

    var feed = ST.listPosts({ sort: sort, page: page, size: 10 });
    var feedTitle = { latest: '最新帖子', hot: '热门帖子', essence: '精华帖', unanswered: '没人回的帖子' }[sort] || '帖子';
    var feedHtml = feed.list.length
      ? feed.list.map(function (x) { return postCardHtml(x, { showBoard: true }); }).join('') + pager('/forum', withQ(q, { sort: sort }), feed)
      : plain('这里还没有帖子', sort === 'unanswered' ? '每个帖子都有人回过了' : '换个筛选看看');

    var hot = ST.hotPosts(8);
    var sideHot = boxBlock('热帖', hot.length
      ? '<div class="ranklist">' + hot.map(function (x, i) { return rankRowHtml(i, x.title, snum(x.views) + ' 阅', href('/post/' + x.id)); }).join('') + '</div>'
      : plain('还没有热帖'));

    var active = ST.listUsers({ sort: 'points', size: 6 }).list;
    var sideUsers = boxBlock('活跃同学', active.length
      ? '<div class="noticelist">' + active.map(function (u) { return userLine(u, num(u.stats ? u.stats.posts : 0) + ' 帖'); }).join('') + '</div>'
      : plain('还没有数据'));

    var sideTags = boxBlock('标签', counts.tags.length
      ? '<div class="tagcloud">' + counts.tags.map(function (t) {
          return '<a class="tagchip" href="' + attr(href('/search', { q: t.tag })) + '">' + esc(t.tag) +
            '<span class="tagchip__count">' + t.count + '</span></a>';
        }).join('') + '</div>'
      : plain('还没有标签'));

    var head = '<div class="bbs-head"><div>' +
      '<div class="bbs-head__title">' + icon('forum', 18) + '<span>论坛</span></div>' +
      '<div class="bbs-head__desc">' + boards.length + ' 个版块 · ' + num(counts.total) + ' 篇帖子 · 今天 ' + num(counts.today) + ' 篇</div>' +
      '</div><form class="bbs-head__search" data-action="search.go">' +
        '<input class="input" name="q" type="search" placeholder="搜帖子、同学、版块" aria-label="搜索">' +
        '<button class="btn btn--primary" type="submit">搜索</button>' +
      '</form></div>';

    var stats = '<div class="bbs-stats mt-3">' +
      '<div class="bbs-stats__item"><div class="bbs-stats__value">' + num(counts.total) + '</div><div class="bbs-stats__label">帖子</div></div>' +
      '<div class="bbs-stats__item"><div class="bbs-stats__value">' + num(counts.today) + '</div><div class="bbs-stats__label">今天</div></div>' +
      '<div class="bbs-stats__item"><div class="bbs-stats__value">' + num(members) + '</div><div class="bbs-stats__label">同学</div></div>' +
      '<div class="bbs-stats__item"><div class="bbs-stats__value">' + num(boards.length) + '</div><div class="bbs-stats__label">版块</div></div>' +
      '</div>';

    var main =
      rowBlock('版块', '<div class="forumtable">' + table + '</div>', '<a class="block__more" href="' + attr(href('/search', {})) + '">搜内容</a>') +
      '<div class="mt-5">' + sortNav('/forum', q, sort) + '</div>' +
      block(feedTitle, feedHtml, '<a class="block__more" href="' + attr(href('/new', {})) + '">发帖</a>');

    return {
      title: '论坛',
      html: head + stats +
        '<div class="row mt-4"><div class="col">' + main + '</div>' +
        '<aside class="col-side stack gap-5">' + sideHot + sideUsers + sideTags + '</aside></div>'
    };
  }

  /* ==================================================================
     2.5 · 当周歌单（排到 周一到周五 × 中午/晚上）
     广播站的实际需求：把当周投稿排进 5 天 × 2 时段 × 3 首 = 30 个位置，
     然后"复制成文本"发到群里。排歌单优先用 DeepSeek，失败自动退回按票数排。
     ================================================================== */
  var WEEK_DAYS = [1, 2, 3, 4, 5];
  var WEEK_DAY_NAMES = { 1: '周一', 2: '周二', 3: '周三', 4: '周四', 5: '周五' };

  function playlistOf() {
    try { return ST.playlistData ? ST.playlistData() : null; } catch (e) { return null; }
  }
  /* 把 plan 整理成 天 → {noon:[], evening:[]} */
  function playlistGrid(plan) {
    var grid = {};
    WEEK_DAYS.forEach(function (d) { grid[d] = { noon: [], evening: [] }; });
    arr(plan).forEach(function (p) {
      var d = Number(p.day) || 0;
      var s = p.slot === 'evening' ? 'evening' : 'noon';
      if (grid[d]) grid[d][s].push(p);
    });
    return grid;
  }
  function playlistText(pl) {
    var grid = playlistGrid(pl && pl.plan);
    var lines = ['【本周歌单】' + (pl && pl.weekKey ? pl.weekKey : '')];
    WEEK_DAYS.forEach(function (d) {
      lines.push('');
      lines.push(WEEK_DAY_NAMES[d]);
      ['noon', 'evening'].forEach(function (s) {
        var items = grid[d][s];
        lines.push('  ' + (s === 'noon' ? '中午' : '晚上') + '：' +
          (items.length ? items.map(function (x) { return x.title + (x.artist ? ' - ' + x.artist : ''); }).join('、') : '（空）'));
      });
    });
    if (pl && pl.note) { lines.push(''); lines.push('备注：' + pl.note); }
    return lines.join('\n');
  }

  function playlistHtml(board) {
    var pl = playlistOf();
    var user = me();
    var manage = canManage();
    var data = pl && pl.playlist ? pl.playlist : null;
    var head = '<div class="block__head"><h2 class="block__title">本周歌单</h2>' +
      (data ? '<span class="block__more">' + (data.published ? '已公布' : '未公布') +
        (data.source === 'deepseek' ? ' · DeepSeek 排的' : data.source === 'manual' ? ' · 手工调整' : ' · 按票数排的') +
        '</span>' : '') + '</div>';

    if (!data) {
      return '<div class="block block--box mt-4">' + head + '<div class="block__body">' +
        plain('这周还没有歌单',
          manage ? '点下面的按钮排一次（优先用 DeepSeek，没配密钥就按票数排）' : '等广播站的同学排好吧') +
        (manage ? manageBarHtml(true) : '') +
        '</div></div>';
    }

    var grid = playlistGrid(data.plan);
    var rows = WEEK_DAYS.map(function (d) {
      function cell(slot) {
        var items = grid[d][slot];
        if (!items.length) return '<span class="text-muted">（空）</span>';
        return items.map(function (x, i) {
          return '<div class="plist__item"><span class="plist__no">' + (i + 1) + '</span>' +
            '<span class="plist__name">' + esc(x.title) + (x.artist ? ' <span class="text-muted">' + esc(x.artist) + '</span>' : '') + '</span>' +
            (Number(x.votes) ? '<span class="plist__votes">' + num(x.votes) + ' 票</span>' : '') +
            (x.reason ? '<span class="text-xs text-muted">' + esc(x.reason) + '</span>' : '') + '</div>';
        }).join('');
      }
      return '<tr><th class="plist__day">' + WEEK_DAY_NAMES[d] + '</th>' +
        '<td data-slot="中午">' + cell('noon') + '</td><td data-slot="晚上">' + cell('evening') + '</td></tr>';
    }).join('');

    return '<div class="block block--box mt-4">' + head + '<div class="block__body">' +
      '<div class="table-wrap"><table class="table plist">' +
        '<thead><tr><th>星期</th><th>中午（3 首）</th><th>晚上（3 首）</th></tr></thead>' +
        '<tbody>' + rows + '</tbody></table></div>' +
      (data.note ? '<div class="noticebar mt-3">' + icon('info', 15) + '<span>' + esc(data.note) + '</span></div>' : '') +
      '<div class="cluster gap-2 mt-3">' +
        '<button class="btn btn--ghost btn--sm" type="button" data-action="playlist.copy">' + icon('copy', 14) + '<span>复制成文本发群里</span></button>' +
        (user ? '<button class="btn btn--ghost btn--sm" type="button" data-action="playlist.open">' + icon('list', 14) + '<span>看完整歌单</span></button>' : '') +
      '</div>' +
      (manage ? manageBarHtml(false) : '') +
      '</div></div>';
  }

  /* 完整歌单弹窗：跟其它弹窗一样，作为页面 HTML 的一部分渲染出来，之后按 id 打开 */
  function playlistModalHtml() {
    var pl = playlistOf();
    if (!pl || !pl.playlist) return '';
    return UI.modal({
      id: 'pf-playlist', title: '本周歌单（' + (pl.playlist.weekKey || '') + '）',
      body: '<pre class="plist__text">' + esc(playlistText(pl.playlist)) + '</pre>' +
        '<div class="cluster gap-2 mt-3">' +
        '<button class="btn btn--primary btn--sm" type="button" data-action="playlist.copy">' + icon('copy', 14) + '<span>复制</span></button>' +
        '<button class="btn btn--sm" type="button" data-modal-close>关闭</button>' +
        '</div>'
    });
  }

  function manageBarHtml(empty) {
    var pl = playlistOf();
    var data = pl && pl.playlist ? pl.playlist : null;
    var working = typeof window !== 'undefined' && window.__plWorking;
    return '<div class="cluster gap-2 mt-3">' +
      '<button class="btn btn--outline btn--sm" type="button" data-action="playlist.generate"' + (working ? ' disabled' : '') + '>' +
        icon('sparkle', 14) + '<span>' + (working ? '正在排…' : (data ? '重新排一遍' : '让 DeepSeek 排一遍')) + '</span></button>' +
      (data ? '<button class="btn btn--ghost btn--sm" type="button" data-action="playlist.publish" data-param=\'' +
        JSON.stringify({ published: !data.published }) + '\'>' +
        icon(data.published ? 'eyeOff' : 'eye', 14) + '<span>' + (data.published ? '撤回公布' : '公布歌单') + '</span></button>' : '') +
      '<span class="text-xs text-muted">' + (pl && pl.aiConfigured ? '已配置 DeepSeek；排的时候会把票数和同学填的周几一起给它' : '没配 DeepSeek 密钥，会按票数排（在 data/deepseek.json 里配）') + '</span>' +
    '</div>' + (empty ? '' : '');
  }

  /* ==================================================================
     3 · 页面：版块 #/board/:id
     ================================================================== */

  /* 图片真的打不开时（404/地址错），把碎图换成能看懂的提示 + 真实地址 */
  function installImgFailHandler() {
    if (window.tfImgFail) return;
    window.tfImgFail = function (img) {
      try {
        var url = img.getAttribute('data-full') || img.getAttribute('src') || '';
        /* 打印到控制台（F12 能直接看到是哪张、什么地址） */
        if (window.console && console.warn) console.warn('[图片打不开] ' + url);
        var box = img.parentNode;
        if (!box) return;
        var note = document.createElement('span');
        note.className = 'imgfail';
        note.innerHTML = '图片打不开<br><b>' + esc(url) + '</b><br><span class="text-xs">（可能是文件被删了，或者地址不对）</span>';
        box.replaceChild(note, img);
      } catch (e) { /* 兜底失败就算了 */ }
    };
  }

  function buildBoard(p) {
    installImgFailHandler();
    var q = p.query || {};
    var board = ST.getBoard((p.param || {}).id);
    if (!board) return { title: '版块没了', html: crumb([{ text: '论坛', href: '#/forum' }, { text: '版块没了' }]) + plain('这个版块不存在') };

    var tag = str(q.tag);
    var sort = SORTS.some(function (s) { return s.key === q.sort; }) ? q.sort : 'latest';
    var page = toInt(q.page, 1);
    var feed = ST.boardFeed(board.id);
    var list = ST.listPosts({ boardId: board.id, tag: tag, sort: sort, page: page, size: PAGE_SIZE });
    var s = board.stats || {};

    var head = '<div class="boardhead"><div>' +
      '<div class="boardhead__title">' + icon(board.icon || 'forum', 18) + '<span>' + esc(board.name) + '</span>' +
        (board.locked ? UI.badge('只读', 'default') : '') + '</div>' +
      '<div class="boardhead__desc">' + esc(board.desc || '') + '</div>' +
      '</div><div class="cluster gap-2">' +
        '<button type="button" class="btn" data-action="board.follow"' + dp({ id: board.id }) + '>' + icon('star', 14) + '<span>关注</span></button>' +
        '<a class="btn btn--primary" href="' + attr(href('/new', { board: board.id })) + '">' + icon('edit', 14) + '<span>发帖</span></a>' +
      '</div></div>';

    var stats = '<div class="bbs-stats mt-3">' +
      '<div class="bbs-stats__item"><div class="bbs-stats__value">' + num(s.posts) + '</div><div class="bbs-stats__label">主题</div></div>' +
      '<div class="bbs-stats__item"><div class="bbs-stats__value">' + num(s.today) + '</div><div class="bbs-stats__label">今天</div></div>' +
      '<div class="bbs-stats__item"><div class="bbs-stats__value">' + num(s.followers) + '</div><div class="bbs-stats__label">关注</div></div>' +
      '</div>';

    var notice = '';
    if (board.locked) notice += '<div class="noticebar mt-3">' + icon('lock', 15) + '<span>只读版块，只有版主和站长能发帖，其他人可以回复</span></div>';
    if (canManage()) notice += '<div class="noticebar mt-3">' + icon('shield', 15) +
      '<span>你是' + (ST.isAdmin() ? '站长' : '版主') + '，帖子里可以直接置顶、加精、锁定、下架</span></div>';

    var tagBar = '<div class="text-sm text-muted mb-2">标签</div>' +
      tagFilterHtml('/board/' + board.id, q, feed.hotTags, tag);

    var rows = list.list.length
      ? list.list.map(function (x, i) { return postRowHtml(x, { no: (list.page - 1) * list.size + i + 1 }); }).join('')
      : plain(tag ? '这个标签下还没帖子' : '还没有帖子', tag ? '换个标签' : '来发第一帖');

    var sideBoard = boxBlock('关于本版', '<div class="listmeta">' +
      li('comment', '主题 ' + num(s.posts)) + li('clock', '今日 ' + num(s.today)) + li('users', num(s.followers) + ' 关注') +
      '</div>', '<a class="block__more" href="' + attr(href('/notices', {})) + '">版规</a>');

    var sideTags = boxBlock('本版标签', arr(feed.hotTags).length
      ? '<div class="tagcloud">' + feed.hotTags.map(function (t) {
          return '<a class="tagchip" href="' + attr(href('/board/' + board.id, { tag: t.tag })) + '">' + esc(t.tag) +
            '<span class="tagchip__count">' + t.count + '</span></a>';
        }).join('') + '</div>'
      : plain('还没有标签'));

    var recent = ST.listPosts({ boardId: board.id, size: 5 }).list;
    var sideNew = boxBlock('最新回复', recent.length
      ? '<div class="noticelist">' + recent.map(function (x) {
          return noticeRow(href('/post/' + x.id), esc(x.title), rel(x.lastReplyAt || x.createdAt));
        }).join('') + '</div>'
      : plain('还没有回复'));

    return {
      title: board.name,
      html: crumb([{ text: '论坛', href: '#/forum' }, { text: board.name }]) + head + stats + notice +
        (isSongBoard(board) ? songPanelHtml(board, q) + playlistHtml(board) + playlistModalHtml() : '') +
        '<div class="row mt-4"><div class="col">' +
          sortNav('/board/' + board.id, q, sort) +
          '<div class="mt-3">' + tagBar + '</div>' +
          rowBlock('帖子', rows, '<span class="block__more">' + num(list.total) + ' 个主题</span>') +
          pager('/board/' + board.id, withQ(q, { tag: tag, sort: sort }), list) +
        '</div><aside class="col-side stack gap-5">' + sideBoard + sideTags + sideNew + '</aside></div>'
    };
  }

  /* ==================================================================
     4 · 页面：帖子 #/post/:id
     ================================================================== */

  var TH = { postId: '', locked: false, pageSize: 20 };

  function likeBtnHtml(p, liked, likes) {
    return '<button type="button" id="pf-like" class="btn ' + (liked ? 'btn--primary' : 'btn--ghost') + ' btn--sm"' +
      ' data-action="post.like"' + dp({ id: p.id }) + '>' + icon('heart', 14) +
      '<span>' + (liked ? '已赞 ' : '赞 ') + snum(likes) + '</span></button>';
  }
  function favBtnHtml(p, faved, favs) {
    return '<button type="button" id="pf-fav" class="btn ' + (faved ? 'btn--primary' : 'btn--ghost') + ' btn--sm"' +
      ' data-action="post.fav"' + dp({ id: p.id }) + '>' + icon('bookmark', 14) +
      '<span>' + (faved ? '已收藏 ' : '收藏 ') + snum(favs) + '</span></button>';
  }
  function commentTotal(post, fallback) {
    if (ST.countComments) {
      var n = ST.countComments(post.id);
      if (typeof n === 'number' && isFinite(n)) return n;
    }
    return fallback;
  }

  function likeCommentBtn(id, liked, likes) {
    return '<button type="button" id="cl-' + attr(id) + '" class="btn btn--text btn--sm" data-action="comment.like"' +
      dp({ id: id }) + '>' + icon('heart', 13) + '<span>' + (liked ? '已赞' : '赞') + '</span>' +
      (likes ? ' <b>' + snum(likes) + '</b>' : '') + '</button>';
  }
  function floorActionsHtml(c) {
    var u = me();
    var liked = u ? arr(c.likedBy).indexOf(u.id) >= 0 : false;
    return '<div class="commentitem__actions">' +
      likeCommentBtn(c.id, liked, c.likes) +
      '<button type="button" class="btn btn--text btn--sm" data-action="comment.reply"' + dp({ id: c.id }) + '>' + icon('comment', 13) + '<span>回复</span></button>' +
      '<button type="button" class="btn btn--text btn--sm" data-action="report.open"' + dp({ type: 'comment', id: c.id }) + '>' + icon('flag', 13) + '<span>举报</span></button>' +
      (u && (u.id === c.authorId || ST.isAdmin())
        ? '<button type="button" class="btn btn--text btn--sm" data-action="comment.del"' + dp({ id: c.id }) + '>' + icon('trash', 13) + '<span>删除</span></button>' : '') +
      '</div>';
  }
  function replyFormHtml(floor, o) {
    if (!me() || o.locked) return '';
    return '<form class="mt-2 is-hidden" id="reply-' + attr(floor.id) + '" data-action="comment.add">' +
      '<input type="hidden" name="postId" value="' + attr(o.postId) + '">' +
      '<input type="hidden" name="parentId" value="' + attr(floor.id) + '">' +
      '<input type="hidden" name="replyTo" value="' + attr(nick(ST.getUser(floor.authorId))) + '">' +
      '<textarea class="textarea" name="content" rows="2" maxlength="500" placeholder="回复 ' + attr(nick(ST.getUser(floor.authorId))) + '"></textarea>' +
      '<div class="cluster gap-2 mt-2"><button class="btn btn--primary btn--sm" type="submit">发送</button>' +
      '<button class="btn btn--ghost btn--sm" type="button" data-action="comment.cancelReply"' + dp({ id: floor.id }) + '>取消</button></div></form>';
  }
  /* 楼中楼（第二层）：parentId 恒指向顶层楼层，用 .quote 引用被回复的那条 */
  function subReplyHtml(r) {
    var author = ST.getUser(r.authorId);
    var parent = r.parentId ? ST.getComment(r.parentId) : null;
    var parentAuthor = parent ? ST.getUser(parent.authorId) : null;
    var u = me();
    var liked = u ? arr(r.likedBy).indexOf(u.id) >= 0 : false;
    var showQuote = !!(r.replyToName && parent && parent.authorId !== r.authorId);
    return '<div class="replyitem" id="c-' + attr(r.id) + '">' +
      '<a href="' + attr(href('/u/' + r.authorId)) + '">' + av(author, 28, 'avatar--round') + '</a>' +
      '<div class="commentitem__body">' +
        '<div class="commentitem__head"><b>' + esc(nick(author)) + '</b>' + roleBadge(author) +
          '<span>' + esc(rel(r.createdAt)) + '</span></div>' +
        (showQuote ? '<div class="quote"><span class="quote__meta">@' + esc(nick(parentAuthor)) + '：</span>' +
          esc(U.excerpt(parent.content, 60)) + '</div>' : '') +
        '<div class="commentitem__content">' + U.md(r.content) + '</div>' +
        '<div class="commentitem__actions">' + likeCommentBtn(r.id, liked, r.likes) +
          '<button type="button" class="btn btn--text btn--sm" data-action="report.open"' + dp({ type: 'comment', id: r.id }) + '>' + icon('flag', 13) + '<span>举报</span></button>' +
          (u && (u.id === r.authorId || ST.isAdmin())
            ? '<button type="button" class="btn btn--text btn--sm" data-action="comment.del"' + dp({ id: r.id }) + '>' + icon('trash', 13) + '<span>删除</span></button>' : '') +
        '</div>' +
      '</div></div>';
  }
  function floorHtml(c, o) {
    var author = ST.getUser(c.authorId);
    var u = me();
    /* 楼层：桌面用 .commentitem（头像 + 正文），手机由 mobile.css 的 .floor/.floor__side 接管间距 */
    return '<div class="commentitem floor" id="c-' + attr(c.id) + '">' +
      '<a class="floor__side" href="' + attr(href('/u/' + c.authorId)) + '">' + av(author, 36, 'avatar--round') + '</a>' +
      '<div class="commentitem__body">' +
        '<div class="commentitem__head">' +
          '<b>#' + o.no + '</b>' +
          (o.isOwner ? UI.badge('楼主', 'primary') : '') +
          '<a href="' + attr(href('/u/' + c.authorId)) + '">' + esc(nick(author)) + '</a>' +
          roleBadge(author) +
          (c.status === 'hidden' ? UI.badge('已隐藏', 'warn') : '') +
          '<span>' + esc(U.fmtTime(c.createdAt)) + '</span>' +
        '</div>' +
        '<div class="commentitem__content">' + U.md(c.content) + '</div>' +
        floorActionsHtml(c) +
        '<div id="replies-' + attr(c.id) + '">' + arr(o.replies).map(subReplyHtml).join('') + '</div>' +
        replyFormHtml(c, o) +
      '</div></div>';
  }

  function reportModalHtml() {
    return UI.modal({
      id: 'pf-report', title: '举报',
      body: '<form data-action="report.submit">' +
        '<input type="hidden" name="targetType" value="post">' +
        '<input type="hidden" name="targetId" value="">' +
        UI.selectField({ label: '理由', name: 'reason', required: true, options: REPORT_REASONS.map(function (r) { return { value: r, label: r }; }) }) +
        '<div class="mt-3">' + UI.textarea({ label: '补充（选填）', name: 'detail', rows: 3, maxlength: 200, placeholder: '哪一句、哪张图' }) + '</div>' +
        '<div class="cluster gap-2 mt-3"><button class="btn btn--danger" type="submit">提交</button>' +
        '<button class="btn" type="button" data-modal-close>取消</button></div></form>'
    });
  }
  function zoomModalHtml() {
    return UI.modal({ id: 'pf-zoom', title: '看大图', size: 'lg', body: '<div class="center"><img id="pf-zoom-img" src="" alt="配图"></div>' });
  }

  function buildPost(p) {
    installImgFailHandler();
    var id = (p.param || {}).id;
    var post = ST.getPost(id);
    if (!post || post.status === 'deleted') {
      return { title: '帖子没了', html: crumb([{ text: '论坛', href: '#/forum' }, { text: '帖子没了' }]) + plain('这帖子被删了，或者链接不对') };
    }
    var user = me();
    var mine = !!(user && user.id === post.authorId);
    var admin = ST.isAdmin();
    if ((post.status === 'pending' || post.status === 'hidden') && !mine && !admin) {
      return { title: '看不了', html: crumb([{ text: '论坛', href: '#/forum' }, { text: '看不了' }]) +
        plain(post.status === 'pending' ? '还在审核，过了就能看' : '这帖被下架了') };
    }
    TH.postId = post.id;
    TH.locked = !!post.locked;

    var author = ST.getUser(post.authorId);
    var board = ST.getBoard(post.boardId);
    var liked = user ? arr(post.likedBy).indexOf(user.id) >= 0 : false;
    var faved = user ? arr(post.favBy).indexOf(user.id) >= 0 : false;
    var csort = p.query.csort === 'hot' ? 'hot' : 'old';
    var cpage = toInt(p.query.cpage, 1);
    var comments = ST.listComments(post.id, { sort: csort, page: cpage, size: TH.pageSize });
    var total = commentTotal(post, comments.total);

    var notice = '';
    if (post.status === 'pending') notice = '<div class="noticebar mb-3">' + icon('clock', 15) + '<span>还在审核，别人暂时看不到' + (mine ? '，你可以接着改' : '') + '</span></div>';
    else if (post.status === 'hidden') notice = '<div class="noticebar mb-3">' + icon('alert', 15) + '<span>这帖已下架' + (post.rejectReason ? '：' + esc(post.rejectReason) : '') + '</span></div>';
    else if (post.locked) notice = '<div class="noticebar mb-3">' + icon('lock', 15) + '<span>已锁定，不能再回复</span></div>';

    var images = arr(post.images);
    /* 图片加载失败时不要只留一个碎图：显示成"这张图打不开 + 地址"，方便排查
       （服务端 /uploads/ 是公开的，正常情况不可能打不开） */
    var imgHtml = images.length
      ? '<div class="upload__preview">' + images.map(function (src, i) {
          var u = str(src);
          return '<button type="button" class="upload__item" data-action="post.zoom"' + dp({ i: i }) + ' aria-label="看大图"' +
            ' style="padding:0;border:0;background:none;cursor:zoom-in">' +
            '<img src="' + attr(u) + '" alt="' + attr('配图 ' + (i + 1)) + '" loading="lazy"' +
            ' data-full="' + attr(u) + '" onerror="tfImgFail(this)"></button>';
        }).join('') + '</div>'
      : '';

    var ownerLine = '<div class="listmeta">' +
      '<a class="listmeta__item" href="' + attr(href('/u/' + post.authorId)) + '">' + av(author, 28, 'avatar--round') + esc(nick(author)) + '</a>' +
      roleBadge(author) +
      li('clock', U.fmtTime(post.createdAt)) + li('eye', num(post.views) + ' 次浏览') +
      li('comment', num(total) + ' 条回复') +
      (author && author.grade ? li('user', author.grade + (author.klass ? ' · ' + author.klass : '')) : '') +
      '</div>';

    var actions = '<div class="commentitem__actions">' +
      (user ? likeBtnHtml(post, liked, post.likes)
            : '<a class="btn btn--ghost btn--sm" href="' + attr(href('/login', { redirect: '/post/' + post.id })) + '">' + icon('heart', 14) + '<span>登录后点赞</span></a>') +
      (user ? favBtnHtml(post, faved, post.favorites) : '') +
      '<button type="button" class="btn btn--ghost btn--sm" data-copy="' + attr(shareUrl('/post/' + post.id)) + '">' + icon('share', 14) + '<span>复制链接</span></button>' +
      '<button type="button" class="btn btn--ghost btn--sm" data-action="report.open"' + dp({ type: 'post', id: post.id }) + '>' + icon('flag', 14) + '<span>举报</span></button>' +
      (mine || admin ? '<a class="btn btn--ghost btn--sm" href="' + attr(href('/edit/' + post.id)) + '">' + icon('edit', 14) + '<span>编辑</span></a>' : '') +
      (mine ? '<button type="button" class="btn btn--ghost btn--sm" data-action="post.del"' + dp({ id: post.id }) + '>' + icon('trash', 14) + '<span>删除</span></button>' : '') +
      '<span class="spacer"></span>' + modBarHtml(post) +
      '</div>';

    var postBlock = notice + '<article class="block block--box"><div class="block__body">' +
      '<h1 class="postrow__title">' + flagBadges(post) + '<span>' + esc(post.title) + '</span></h1>' +
      '<div class="mt-2">' + ownerLine + '</div>' +
      '<div class="markdown mt-4">' + U.md(post.content) + '</div>' +
      (imgHtml ? '<div class="mt-4">' + imgHtml + '</div>' : '') +
      (arr(post.tags).length ? '<div class="postrow__tags mt-4">' + tagsHtml(arr(post.tags), post.boardId) + '</div>' : '') +
      '<div class="sigline">' + (author && author.bio ? esc(author.bio) : '这位同学没写签名') + '</div>' +
      actions + '</div></article>';

    var floors = comments.list.length
      ? comments.list.map(function (c, i) {
          return floorHtml(c, {
            no: (comments.page - 1) * comments.size + i + 2,
            postId: post.id, locked: post.locked,
            isOwner: c.authorId === post.authorId,
            replies: ST.listReplies(c.id)
          });
        }).join('')
      : plain('还没人回复', '说点什么');

    var composer = post.locked
      ? '<div class="noticebar">' + icon('lock', 15) + '<span>已锁定，不能再回复</span></div>'
      : (user
        ? '<form data-action="comment.add">' +
            '<input type="hidden" name="postId" value="' + attr(post.id) + '">' +
            '<input type="hidden" name="parentId" value="">' +
            '<textarea class="textarea" name="content" rows="3" maxlength="500" placeholder="回复楼主，支持 Markdown"></textarea>' +
            '<div class="cluster gap-2 mt-2"><button class="btn btn--primary" type="submit">回复</button>' +
            '<span class="text-xs text-muted">会通知楼主</span></div></form>'
        : '<div class="listmeta">' + icon('lock', 13) + '<span><a href="' +
            attr(href('/login', { redirect: '/post/' + post.id })) + '">登录</a> 后可以回复</span></div>');

    var commentBlock = '<div class="block block--box">' +
      '<div class="block__head"><h2 class="block__title">回复</h2>' +
        '<span class="cluster gap-2">' +
          '<span class="block__more" id="pf-floor-total">' + num(total) + ' 条</span>' +
          (csort === 'old' ? '<span class="block__more">按时间</span>'
            : '<a class="block__more" href="' + attr(href('/post/' + post.id, withQ(p.query, { csort: 'old', cpage: '' }))) + '">按时间</a>') +
          (csort === 'hot' ? '<span class="block__more">按热度</span>'
            : '<a class="block__more" href="' + attr(href('/post/' + post.id, withQ(p.query, { csort: 'hot', cpage: '' }))) + '">按热度</a>') +
        '</span></div>' +
      '<div class="block__body">' +
        '<div id="pf-floors">' + floors + '</div>' +
        /* 分页只给页码，不给 total：楼层数是顶层评论、回复数是含楼中楼，两个数字并排会打架 */
        UI.pagination({
          page: comments.page, pages: comments.pages,
          makeHref: function (n) { return href('/post/' + post.id, withQ(p.query, { csort: csort, cpage: n })); }
        }) +
      '</div></div>';

    var others = ST.listPosts({ authorId: post.authorId, size: 8 }).list.filter(function (x) { return x.id !== post.id; }).slice(0, 5);
    var sameTags = arr(post.tags);
    var related = ST.listPosts({ boardId: post.boardId, size: 12 }).list
      .filter(function (x) { return x.id !== post.id; })
      .sort(function (a, b) {
        return arr(b.tags).filter(function (t) { return sameTags.indexOf(t) >= 0; }).length -
          arr(a.tags).filter(function (t) { return sameTags.indexOf(t) >= 0; }).length;
      }).slice(0, 5);
    function miniList(items) {
      return items.length
        ? '<div class="noticelist">' + items.map(function (x) {
            return noticeRow(href('/post/' + x.id), esc(x.title), rel(x.lastReplyAt || x.createdAt));
          }).join('') + '</div>'
        : plain('没有别的帖子');
    }

    var sideAuthor = boxBlock('楼主', '<div class="listmeta">' +
      '<a class="userchip" href="' + attr(href('/u/' + post.authorId)) + '">' + av(author, 36, 'avatar--round') +
        '<span class="userchip__text"><b>' + esc(nick(author)) + '</b><i>' +
        esc((((author && author.grade) || '') + ' ' + ((author && author.klass) || '')).trim()) + '</i></span></a>' +
      '</div><div class="listmeta mt-2">' +
        li('edit', '发帖 ' + num(author && author.stats ? author.stats.posts : 0)) +
        li('star', num(author ? author.points : 0) + ' 分') +
      '</div>', '<a class="block__more" href="' + attr(href('/messages', { tab: 'pm', c: post.authorId })) + '">私信</a>');

    var sideInfo = boxBlock('帖子信息', '<div class="listmeta">' +
      li('grid', board ? board.name : '版块') +
      li('clock', '发布 ' + U.fmtTime(post.createdAt)) +
      (post.updatedAt && post.updatedAt !== post.createdAt ? li('refresh', '编辑 ' + U.fmtTime(post.updatedAt)) : '') +
      li('heart', num(post.likes) + ' 个赞') +
      '</div>');

    return {
      title: post.title,
      html: crumb([
        { text: '论坛', href: '#/forum' },
        { text: board ? board.name : '版块', href: board ? href('/board/' + board.id) : '#/forum' },
        { text: U.excerpt(post.title, 18) }
      ]) +
        '<div class="row"><div class="col">' + postBlock +
          '<div class="mt-5 block block--box"><div class="block__head"><h2 class="block__title">写回复</h2></div>' +
          '<div class="block__body">' + composer + '</div></div>' +
          '<div class="mt-5">' + commentBlock + '</div>' +
        '</div><aside class="col-side stack gap-5">' + sideAuthor +
          boxBlock('同版帖子', miniList(related)) + boxBlock('TA 的其他帖子', miniList(others)) + sideInfo +
        '</aside></div>' + reportModalHtml() + zoomModalHtml()
    };
  }

  /* ==================================================================
     5 · 页面：发帖 / 编辑 #/new #/edit/:id
     ================================================================== */

  var ED = { key: '', postId: '', tags: [], images: [] };

  function previewHtml(text) {
    var t = str(text).trim();
    if (!t) return '<div class="text-sm text-muted">左边写完，这里看效果</div>';
    return U.md(t);
  }

  function syncEditor() {
    var ta = document.getElementById('pf-content');
    var ti = document.getElementById('pf-title');
    var prev = document.getElementById('pf-preview');
    var cnt = document.getElementById('pf-title-count');
    if (cnt && ti) cnt.textContent = '标题 ' + str(ti.value).length + '/60';
    if (prev && ta) prev.innerHTML = previewHtml(ta.value);
    saveDraft();
  }
  function saveDraft() {
    if (!ED.key) return;
    var ti = document.getElementById('pf-title');
    var ta = document.getElementById('pf-content');
    if (!ti && !ta) return;
    var bd = document.querySelector('form[data-action="post.save"] select[name=boardId]');
    writeDraft(ED.key, {
      title: ti ? ti.value : '', content: ta ? ta.value : '',
      tags: ED.tags.slice(0, MAX_TAGS), images: ED.images.slice(0, MAX_IMAGES),
      boardId: bd ? bd.value : '', at: Date.now()
    });
  }
  function renderTags() {
    var boxEl = document.getElementById('pf-tags');
    if (!boxEl) return;
    boxEl.innerHTML = ED.tags.length
      ? ED.tags.map(function (t) {
          return '<button type="button" class="chip is-active" data-action="editor.delTag"' + dp({ tag: t }) +
            ' title="点一下删掉">' + esc(t) + icon('close', 11) + '</button>';
        }).join('')
      : '<span class="text-xs text-muted">还没加标签</span>';
  }
  function renderImages() {
    var boxEl = document.getElementById('pf-imgs');
    if (boxEl) {
      boxEl.innerHTML = ED.images.map(function (src, i) {
        return '<span class="upload__item"><img src="' + attr(src) + '" alt="' + attr('配图 ' + (i + 1)) + '">' +
          '<button type="button" class="upload__remove" data-action="editor.delImage"' + dp({ i: i }) +
          ' aria-label="删掉这张">' + icon('close', 12) + '</button></span>';
      }).join('');
    }
    var hint = document.getElementById('pf-img-hint');
    if (hint) hint.textContent = ED.images.length ? ED.images.length + ' / ' + MAX_IMAGES + ' 张' : '';
  }
  function addTag() {
    var input = document.getElementById('pf-tag');
    var t = str(input ? input.value : '').trim().replace(/^#/, '').slice(0, 8);
    if (!t) { toast('先输入标签', 'warn'); return; }
    if (ED.tags.length >= MAX_TAGS) { toast('最多 ' + MAX_TAGS + ' 个标签', 'warn'); return; }
    if (ED.tags.indexOf(t) >= 0) { toast('这个标签加过了', 'warn'); return; }
    ED.tags.push(t);
    if (input) { input.value = ''; input.focus(); }
    renderTags(); saveDraft();
  }
  function formError(msg) {
    var boxEl = document.getElementById('pf-form-err');
    if (!boxEl) { toast(msg, 'error'); return; }
    boxEl.innerHTML = icon('alert', 13) + '<span>' + esc(msg) + '</span>';
    try { boxEl.scrollIntoView({ block: 'center', behavior: 'smooth' }); } catch (e) { /* 忽略 */ }
  }
  function clearFormError() {
    var boxEl = document.getElementById('pf-form-err');
    if (boxEl) boxEl.innerHTML = '';
  }

  function buildEditor(p) {
    var isEdit = p.page === 'edit';
    var post = isEdit ? ST.getPost((p.param || {}).id) : null;
    var user = me();
    if (isEdit) {
      if (!post || post.status === 'deleted') {
        return { title: '帖子没了', html: crumb([{ text: '论坛', href: '#/forum' }, { text: '帖子没了' }]) + plain('要改的帖子已经删了') };
      }
      if (!user || (post.authorId !== user.id && !ST.isAdmin())) {
        return { title: '改不了', html: crumb([{ text: '论坛', href: '#/forum' }, { text: '改不了' }]) + plain('只能改自己发的帖子') };
      }
    }

    var key = draftKey(isEdit ? post.id : 'new');
    var draft = readDraft(key);
    var boardId = str((p.query || {}).board) || (post ? post.boardId : '') || (ST.listBoards()[0] || {}).id || '';
    var title = post ? post.title : '';
    var content = post ? post.content : '';
    var tags = post ? arr(post.tags).slice() : [];
    var images = post ? arr(post.images).slice() : [];
    var restored = false;
    if (draft && (!isEdit || Number(draft.at || 0) > Number(post ? (post.updatedAt || post.createdAt) : 0))) {
      title = str(draft.title); content = str(draft.content);
      tags = arr(draft.tags).slice(0, MAX_TAGS); images = arr(draft.images).slice(0, MAX_IMAGES);
      boardId = str(draft.boardId) || boardId;
      restored = true;
    }
    ED.key = key;
    ED.postId = isEdit ? post.id : '';
    ED.tags = tags.slice(0, MAX_TAGS);
    ED.images = images.slice(0, MAX_IMAGES);

    var boardOptions = [{ value: '', label: '选个版块' }].concat(ST.listBoards().map(function (b) {
      return { value: b.id, label: b.name + (b.locked ? '（只读）' : '') };
    }));

    var tools = [['bold', '加粗'], ['italic', '斜体'], ['h3', '小标题'], ['quote', '引用'], ['list', '列表'],
      ['code', '代码'], ['link', '链接'], ['image', '图片']].map(function (t) {
      return '<button type="button" class="btn btn--ghost btn--sm" data-action="editor.md"' + dp({ type: t[0] }) + '>' + esc(t[1]) + '</button>';
    }).join('');

    var targetBoard = ST.getBoard(boardId);
    var lockedBar = targetBoard && targetBoard.locked && !canManage()
      ? '<div class="noticebar mb-3">' + icon('lock', 15) + '<span>「' + esc(targetBoard.name) + '」是只读版块，只有版主和站长能发帖</span></div>'
      : '';

    var form = '<form data-action="post.save">' + lockedBar +
      '<div class="formgrid">' +
        UI.selectField({ label: '版块', name: 'boardId', value: boardId, options: boardOptions, required: true }) +
        UI.field({ id: 'pf-title', label: '标题', name: 'title', value: title, maxlength: 60, required: true, placeholder: '比如：求高二数学月考前两章的复习提纲' }) +
      '</div>' +
      '<div class="mt-3">' +
        '<label class="field__label" for="pf-content">正文 <span class="req">*</span></label>' +
        /* .editorbar：手机上横向滚动，不折成两排（mobile.css 提供） */
        '<div class="editorbar mt-2 mb-1">' + tools + '</div>' +
        '<div class="text-xs text-muted mb-2" id="pf-title-count">标题 0/60</div>' +
        '<div class="grid grid--2">' +
          '<textarea class="textarea" id="pf-content" name="content" rows="16" maxlength="8000" ' +
            'placeholder="支持 Markdown：**加粗**、`代码`、- 列表、> 引用、[文字](链接)">' + esc(content) + '</textarea>' +
          '<div class="markdown markdown--preview" id="pf-preview">' + previewHtml(content) + '</div>' +
        '</div>' +
      '</div>' +
      '<div class="mt-3">' +
        '<label class="field__label" for="pf-tag">标签</label>' +
        '<div class="cluster gap-2 mt-2">' +
          '<input class="input" id="pf-tag" name="tagInput" maxlength="8" placeholder="回车加标签，比如 月考">' +
          '<button class="btn" type="button" data-action="editor.addTag">添加</button>' +
        '</div>' +
        '<div class="field__hint">最多 ' + MAX_TAGS + ' 个，一个标签 8 个字以内</div>' +
        '<div class="cluster gap-2 mt-2" id="pf-tags"></div>' +
      '</div>' +
      '<div class="mt-3">' +
        '<label class="field__label">配图</label>' +
        /* 文件输入框做成**覆盖在按钮上的透明层**（原生点击，最可靠）。
           不要用"按钮 JS 触发隐藏输入框"或"<label for> + 隐藏输入框"：
           Chrome 会拒绝为隐藏/程序触发的 input[type=file] 打开选择器，
           而且点在表单内的文件输入框还会触发隐式提交（帖子会被直接发出去）。 */
        '<div class="upload-wrap mt-2">' +
          '<button class="upload upload--file" type="button" tabindex="-1" aria-hidden="true">' + icon('image', 20) +
            '<b>选图片</b><div class="text-xs text-muted">最多 ' + MAX_IMAGES + ' 张，自动压到 1280px</div></button>' +
          '<input class="upload__file" id="pf-images" type="file" accept="image/*" multiple ' +
            'aria-label="选择配图" title="选图片" data-action-change="editor.pickImages">' +
        '</div>' +
        '<div class="cluster gap-2 mt-2"><span class="text-xs text-muted" id="pf-img-hint"></span></div>' +
        '<div class="upload__preview" id="pf-imgs"></div>' +
      '</div>' +
      '<div id="pf-form-err" class="field__error mt-3"></div>' +
      '<div class="cluster gap-2 mt-4">' +
        '<button class="btn btn--primary btn--lg btn--block" type="submit">' + (isEdit ? '保存' : '发布') + '</button>' +
        '<button class="btn" type="button" data-action="app.back">取消</button>' +
        '<span class="spacer"></span><span class="text-xs text-muted">草稿存在本机</span>' +
      '</div>' +
      /* 文件输入框放表单外面：点表单内的 file 输入框会触发隐式提交（帖子被直接发出去）。
         app.js 里也有守卫，但结构上更稳妥的做法就是挪出来。 */
      '</form>';

    var side = '';
    if (restored) {
      side += '<div class="noticebar">' + icon('refresh', 15) + '<span>接上了 ' + esc(rel(draft.at)) + '存的草稿' +
        '<div class="mt-2"><button class="btn btn--sm" type="button" data-action="editor.dropDraft">扔掉草稿</button></div></span></div>';
    } else if (isEdit && draft) {
      side += '<div class="noticebar">' + icon('refresh', 15) + '<span>本机还有 ' + esc(rel(draft.at)) + '的草稿，比线上新' +
        '<div class="cluster gap-2 mt-2"><button class="btn btn--sm" type="button" data-action="editor.loadDraft">用草稿</button>' +
        '<button class="btn btn--text btn--sm" type="button" data-action="editor.dropDraft">扔掉</button></div></span></div>';
    }
    var st = settings();
    side += boxBlock('发帖前看一眼', '<ul class="stack gap-2 text-sm">' +
      '<li>标题写清楚：什么事、什么时候、要什么</li>' +
      '<li>正文补细节：班级、时间、地点、试过什么办法</li>' +
      '<li>别写同学的真名、住址、手机号</li>' +
      '<li>广告、代写、刷分会被下架</li></ul>') +
      boxBlock('规则', '<div class="listmeta">' +
        li('shield', '敏感词 ' + num(arr(st.sensitiveWords).length) + ' 个') +
        li('clock', st.needAudit ? '发帖要审核' : '发帖直接公开') +
        '</div>');

    return {
      title: isEdit ? '编辑帖子' : '发帖',
      html: crumb([{ text: '论坛', href: '#/forum' }, { text: isEdit ? '编辑' : '发帖' }]) +
        '<div class="row"><div class="col">' + boxBlock(isEdit ? '编辑帖子' : '发新帖', form) + '</div>' +
        '<aside class="col-side stack gap-5">' + side + '</aside></div>',
      onMount: function () {
        var ta = document.getElementById('pf-content');
        var ti = document.getElementById('pf-title');
        var sync = U.debounce(function () { syncEditor(); }, 180);
        if (ta) ta.addEventListener('input', sync);
        if (ti) ti.addEventListener('input', sync);
        var tag = document.getElementById('pf-tag');
        if (tag) tag.addEventListener('keydown', function (ev) { if (ev.key === 'Enter') { ev.preventDefault(); addTag(); } });
        renderTags(); renderImages(); syncEditor();
      }
    };
  }

  /* ==================================================================
     6 · 页面：个人主页 #/u/:id #/me
     ================================================================== */

  function commentsOf(userId) {
    var out = [];
    try {
      arr(ST.state().comments).forEach(function (c) {
        if (c.authorId !== userId || c.status === 'deleted') return;
        if (c.status === 'hidden' && !(ST.isAdmin() || (me() && me().id === userId))) return;
        out.push(c);
      });
    } catch (e) { out = []; }
    return out.sort(function (a, b) { return (Number(b.createdAt) || 0) - (Number(a.createdAt) || 0); });
  }

  function profileModal(user) {
    return UI.modal({
      id: 'pf-profile-edit', title: '改资料',
      body: '<form data-action="profile.editSubmit">' +
        UI.field({ label: '昵称', name: 'nickname', value: user.nickname, maxlength: 16, required: true, hint: '同学看到的就是这个' }) +
        '<div class="mt-3">' + UI.field({ label: '真实姓名', name: 'realName', value: user.realName || '', maxlength: 20, required: true, hint: (user.hasRealName && !user.realName ? '已实名，要改就填新的；' : '') + '2~20 个字，只有管理员能看到' }) + '</div>' +
        '<div class="mt-3">' + UI.textarea({ label: '签名', name: 'bio', value: user.bio || '', rows: 3, maxlength: 120, placeholder: '一句话，别人点进主页能看到' }) + '</div>' +
        '<div class="formgrid mt-3">' +
          UI.selectField({ label: '年级', name: 'grade', value: user.grade || '', options: GRADES.map(function (g) { return { value: g, label: g }; }), hint: '年级是公开的' }) +
          UI.selectField({ label: '班级', name: 'klass', value: user.klass || '1班', required: true, options: KLASS_OPTIONS.map(function (k) { return { value: k, label: k }; }), hint: '只能选 1~10 班，只有管理员能看到' }) +
        '</div>' +
        '<div class="mt-3">' + UI.field({ label: '学号', name: 'studentNo', value: user.studentNo || '', required: true, inputmode: 'numeric', maxlength: 12, placeholder: '20240101', hint: (user.hasStudentNo && !user.studentNo ? '已填过，要改就填新的；' : '') + '4~12 位数字，只有管理员能看到' }) + '</div>' +
        '<div class="mt-3">' + UI.radioCards({ name: 'sex', value: user.sex || '', options: [{ value: '男', label: '男' }, { value: '女', label: '女' }, { value: '', label: '不说' }] }) + '</div>' +
        '<div class="cluster gap-2 mt-4"><button class="btn btn--primary" type="submit">保存</button>' +
        '<button class="btn" type="button" data-modal-close>取消</button></div></form>'
    });
  }

  function buildProfile(p) {
    var self = p.page === 'me';
    var user = self ? me() : ST.getUser((p.param || {}).id);
    if (!user) return { title: '没这个人', html: crumb([{ text: '论坛', href: '#/forum' }, { text: '没这个人' }]) + plain('找不到这位同学') };

    var isSelf = !!(me() && me().id === user.id);
    var tab = ['posts', 'comments', 'fav', 'about'].indexOf(str(p.query.tab)) >= 0 ? p.query.tab : 'posts';
    var page = toInt(p.query.page, 1);
    var stats = user.stats || {};
    var lv = ST.levelInfo ? ST.levelInfo(user.points || 0) : { level: user.level || 1, percent: 0, need: 0, next: null };
    var favCount = arr(user.favorites).length;

    var head = '<div class="bbs-head"><div class="cluster gap-3">' + av(user, 56, 'avatar--round') +
      '<div>' +
        '<div class="bbs-head__title">' + esc(nick(user)) + roleBadge(user) +
          (user.level ? UI.badge('Lv.' + user.level, 'default') : '') +
          /* 只有「已实名但看不到姓名」的别人主页才给这个标记：不泄露内容，也不留占位 */
          (user.hasRealName && !user.realName ? UI.badge('已实名', 'success') : '') +
          (user.banned ? UI.badge('封禁中', 'danger') : '') + '</div>' +
        '<div class="bbs-head__desc">' + esc(user.bio || '@' + user.username) + '</div>' +
        '<div class="listmeta mt-2">' +
          li('at', '@' + user.username) +
          li('user', (user.grade || '没填年级') + (user.klass ? ' · ' + user.klass : '')) +
          li('calendar', '加入于 ' + U.fmtDate(user.createdAt)) +
          (isSelf ? li('clock', '上次登录 ' + rel(user.lastLoginAt)) : '') +
        '</div>' +
      '</div></div>' +
      '<div class="cluster gap-2">' +
        (isSelf
          ? '<button type="button" class="btn" data-action="profile.editOpen">' + icon('edit', 14) + '<span>改资料</span></button>' +
            '<a class="btn btn--ghost" href="#/settings">' + icon('settings', 14) + '<span>设置</span></a>'
          : '<a class="btn btn--ghost" href="' + attr(href('/messages', { tab: 'pm', c: user.id })) + '">' + icon('mail', 14) + '<span>私信</span></a>') +
      '</div></div>';

    var statBar = '<div class="bbs-stats mt-3">' +
      '<div class="bbs-stats__item"><div class="bbs-stats__value">' + num(stats.posts) + '</div><div class="bbs-stats__label">帖子</div></div>' +
      '<div class="bbs-stats__item"><div class="bbs-stats__value">' + num(stats.comments) + '</div><div class="bbs-stats__label">回复</div></div>' +
      '<div class="bbs-stats__item"><div class="bbs-stats__value">' + num(stats.likes) + '</div><div class="bbs-stats__label">获赞</div></div>' +
      '<div class="bbs-stats__item"><div class="bbs-stats__value">' + num(favCount) + '</div><div class="bbs-stats__label">收藏</div></div>' +
      '<div class="bbs-stats__item"><div class="bbs-stats__value">' + num(user.points) + '</div><div class="bbs-stats__label">积分</div></div>' +
      '</div>';

    var nav = '<nav class="bbs-nav">' + [
      ['posts', '帖子', stats.posts || 0], ['comments', '回复', stats.comments || 0],
      ['fav', '收藏', favCount], ['about', '资料', '']
    ].map(function (t) {
      return '<a class="bbs-nav__item' + (t[0] === tab ? ' is-active' : '') + '" href="' +
        attr(href(p.path, withQ(p.query, { tab: t[0], page: '' }))) + '">' + esc(t[1]) +
        (t[2] !== '' ? '<span class="bbs-nav__count">' + num(t[2]) + '</span>' : '') + '</a>';
    }).join('') + '</nav>';

    var body = '';
    if (tab === 'posts') {
      var res = ST.listPosts({ authorId: user.id, status: isSelf ? 'all' : 'published', page: page, size: PAGE_SIZE });
      body = res.list.length
        ? '<div class="block block--box block--flush"><div class="block__body">' +
            res.list.map(function (x) { return postRowHtml(x, { showBoard: true }); }).join('') + '</div></div>' +
          pager(p.path, withQ(p.query, { tab: 'posts' }), res)
        : plain(isSelf ? '你还没发过帖子' : 'TA 还没发过帖子');
    } else if (tab === 'comments') {
      var all = commentsOf(user.id);
      var pages = Math.max(1, Math.ceil(all.length / 15));
      var cur = Math.min(page, pages);
      var slice = all.slice((cur - 1) * 15, cur * 15);
      body = slice.length
        ? '<div class="block block--box"><div class="block__body">' + slice.map(function (c) {
            var post = ST.getPost(c.postId, { view: false });
            return '<div class="commentitem"><div class="commentitem__body">' +
              '<div class="commentitem__head">' + icon('comment', 13) +
                (post ? '<a href="' + attr(href('/post/' + post.id)) + '">' + esc(post.title) + '</a>' : '<span>帖子已删除</span>') +
                '<span>' + esc(rel(c.createdAt)) + '</span>' +
                (c.status === 'hidden' ? UI.badge('已隐藏', 'warn') : '') + '</div>' +
              '<div class="commentitem__content">' + U.md(c.content) + '</div>' +
              '<div class="commentitem__actions">' + li('heart', num(c.likes) + ' 个赞') + '</div>' +
              '</div></div>';
          }).join('') + '</div></div>' +
          UI.pagination({
            page: cur, pages: pages, total: all.length,
            makeHref: function (n) { return href(p.path, withQ(p.query, { tab: 'comments', page: n })); }
          })
        : plain(isSelf ? '你还没回过帖' : 'TA 还没回过帖');
    } else if (tab === 'fav') {
      var favs = ST.favoritePosts(user.id);
      body = favs.length
        ? '<div class="block block--box block--flush"><div class="block__body">' +
            favs.map(function (x) { return postRowHtml(x, { showBoard: true }); }).join('') + '</div></div>'
        : plain(isSelf ? '你还没收藏帖子' : 'TA 还没收藏帖子');
    } else {
      var recent = ST.listPosts({ authorId: user.id, status: isSelf ? 'all' : 'published', size: 5 }).list;
      body = '<div class="block block--box"><div class="block__body">' +
        '<div class="listmeta">' +
          li('user', '昵称：' + nick(user)) + li('at', '用户名：@' + user.username) +
          li('user', '年级：' + (user.grade || '没填')) +
          /* 班级与真实姓名都是隐私字段：服务端只给本人和超管，空值就整行不渲染 */
          (user.klass ? li('user', '班级：' + user.klass) : '') +
          (user.realName ? li('shield', '真实姓名：' + user.realName) : '') +
          (user.studentNo ? li('user', '学号：' + user.studentNo) : '') +
          (isSelf && (!user.realName || !user.klass || !user.studentNo) ? li('alert', '真实姓名 / 班级 / 学号 还有没填的，点下面「改资料」补上') : '') +
          li('heart', '性别：' + U.sexLabel(user.sex)) +
          li('calendar', '注册：' + U.fmtTime(user.createdAt)) +
          li('clock', '上次登录：' + U.fmtTime(user.lastLoginAt)) +
          li('star', '积分：' + num(user.points) + ' · Lv.' + num(user.level) +
            (lv.next ? '，差 ' + num(lv.need) + ' 分升级' : '')) +
        '</div>' +
        '<div class="mt-3">' + UI.progress(lv.percent, 100) + '</div>' +
        '<div class="sigline">' + esc(user.bio || '这位同学没写签名') + '</div>' +
        (isSelf ? '<div class="mt-3"><button class="btn btn--sm" type="button" data-action="profile.editOpen">改资料</button></div>' : '') +
        '</div></div>' +
        (recent.length ? '<div class="mt-5">' + boxBlock('最近发帖', '<div class="noticelist">' + recent.map(function (x) {
          return noticeRow(href('/post/' + x.id), esc(x.title), rel(x.createdAt));
        }).join('') + '</div>') + '</div>' : '');
    }

    var side = boxBlock('统计', '<div class="listmeta">' +
