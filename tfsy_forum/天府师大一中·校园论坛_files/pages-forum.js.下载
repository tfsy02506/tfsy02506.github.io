  function buildSearch(p) {
    var q = str(p.query.q).trim();
    var type = ['all', 'post', 'user', 'board'].indexOf(str(p.query.type)) >= 0 ? p.query.type : 'all';
    var page = toInt(p.query.page, 1);
    var counts = ST.counts();

    var head = '<div class="bbs-head"><div>' +
      '<div class="bbs-head__title">' + icon('search', 18) + '<span>搜索</span></div>' +
      '<div class="bbs-head__desc">' + (q ? '关键词「' + esc(q) + '」' : '帖子、同学、版块都能搜') + '</div>' +
      '</div><form class="bbs-head__search" data-action="search.go">' +
      '<input class="input" name="q" type="search" value="' + attr(q) + '" placeholder="搜什么" aria-label="搜索">' +
      '<button class="btn btn--primary" type="submit">搜索</button></form></div>';

    if (!q) {
      return {
        title: '搜索',
        html: head +
          '<div class="mt-4">' + boxBlock('试试这些', counts.tags.length
            ? '<div class="tagcloud">' + counts.tags.map(function (t) {
                return '<a class="tagchip" href="' + attr(href('/search', { q: t.tag })) + '">' + esc(t.tag) +
                  '<span class="tagchip__count">' + t.count + '</span></a>';
              }).join('') + '</div>'
            : plain('还没有标签')) + '</div>' +
          '<div class="mt-5">' + rowBlock('版块', boardTableHtml(ST.listBoards(), '')) + '</div>'
      };
    }

    var res = ST.search(q, 'all');
    var posts = arr(res.posts), users = arr(res.users), boards = arr(res.boards);
    var total = posts.length + users.length + boards.length;

    var nav = '<nav class="bbs-nav mt-4">' + [
      ['all', '全部', total], ['post', '帖子', posts.length], ['user', '同学', users.length], ['board', '版块', boards.length]
    ].map(function (t) {
      return '<a class="bbs-nav__item' + (t[0] === type ? ' is-active' : '') + '" href="' +
        attr(href('/search', { q: q, type: t[0] })) + '">' + esc(t[1]) + '<span class="bbs-nav__count">' + t[2] + '</span></a>';
    }).join('') + '</nav>';

    if (!total) {
      return {
        title: '搜索：' + q,
        html: head + nav + '<div class="mt-4">' + boxBlock('没搜到', '<div class="text-sm text-muted">换个词，或者少写几个字</div>' +
          (counts.tags.length ? '<div class="tagcloud mt-3">' + counts.tags.slice(0, 8).map(function (t) {
            return '<a class="tagchip" href="' + attr(href('/search', { q: t.tag })) + '">' + esc(t.tag) + '</a>';
          }).join('') + '</div>' : '')) + '</div>'
      };
    }

    function postCards() {
      var pages = Math.max(1, Math.ceil(posts.length / PAGE_SIZE));
      var cur = Math.min(page, pages);
      var slice = posts.slice((cur - 1) * PAGE_SIZE, cur * PAGE_SIZE);
      return slice.map(function (x) { return postCardHtml(x, { showBoard: true, hl: q }); }).join('') +
        (pages > 1 ? UI.pagination({
          page: cur, pages: pages, total: posts.length,
          makeHref: function (n) { return href('/search', { q: q, type: 'post', page: n }); }
        }) : '');
    }
    function userRows(limit) {
      return '<div class="noticelist">' + users.slice(0, limit).map(function (u) {
        return '<div class="noticerow">' +
          '<a class="userchip" href="' + attr(href('/u/' + u.id)) + '">' + av(u, 28, 'avatar--round') +
            '<span class="userchip__text"><b>' + U.highlight(u.nickname, q) + '</b><i>' + U.highlight('@' + u.username, q) +
            ' · ' + esc(((u.grade || '') + ' ' + (u.klass || '')).trim()) + '</i></span></a>' +
          '<span class="spacer"></span>' + roleBadge(u) +
          '<span class="noticerow__time">' + esc(num(u.points) + ' 分') + '</span></div>';
      }).join('') + '</div>';
    }

    var body;
    if (type === 'post') body = block('帖子 ' + posts.length, posts.length ? postCards() : plain('没有匹配的帖子'));
    else if (type === 'user') body = rowBlock('同学 ' + users.length, users.length ? userRows(users.length) : plain('没有匹配的同学'));
    else if (type === 'board') body = rowBlock('版块 ' + boards.length, boards.length ? boardTableHtml(boards, q) : plain('没有匹配的版块'));
    else {
      body =
        (posts.length ? block('帖子 ' + posts.length, posts.slice(0, 5).map(function (x) { return postCardHtml(x, { showBoard: true, hl: q }); }).join('') +
          (posts.length > 5 ? '<div class="mt-3"><a class="block__more" href="' + attr(href('/search', { q: q, type: 'post' })) + '">全部 ' + posts.length + ' 篇</a></div>' : '')) : '') +
        (users.length ? '<div class="mt-5">' + rowBlock('同学 ' + users.length, userRows(4) +
          (users.length > 4 ? '<div class="mt-3"><a class="block__more" href="' + attr(href('/search', { q: q, type: 'user' })) + '">全部 ' + users.length + ' 位</a></div>' : '')) + '</div>' : '') +
        (boards.length ? '<div class="mt-5">' + rowBlock('版块 ' + boards.length, boardTableHtml(boards.slice(0, 3), q)) + '</div>' : '');
    }

    return { title: '搜索：' + q, html: head + nav + '<div class="mt-4">' + body + '</div>' };
  }

